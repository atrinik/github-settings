{
  "definitions": [
    {
      "property_name": "component_role",
      "value_type": "multi_select",
      "required": true,
      "description": "Logical roles owned or served by the repository",
      "allowed_values": [
        "aggregate",
        "assets",
        "client",
        "content",
        "coordination",
        "editor",
        "governance",
        "historical",
        "infrastructure",
        "library",
        "protocol",
        "renderer",
        "server",
        "service",
        "tooling",
        "website"
      ],
      "default_value": null
    },
    {
      "property_name": "provider_set",
      "value_type": "multi_select",
      "required": true,
      "description": "Atrinik provider cohort represented by the repository",
      "allowed_values": [
        "classic",
        "organization",
        "replacement",
        "shared"
      ],
      "default_value": null
    },
    {
      "property_name": "lifecycle",
      "value_type": "single_select",
      "required": true,
      "description": "Current support and delivery stage",
      "allowed_values": [
        "active",
        "archived",
        "maintenance",
        "seed"
      ],
      "default_value": null
    },
    {
      "property_name": "release_policy",
      "value_type": "single_select",
      "required": true,
      "description": "How changes in the repository are released",
      "allowed_values": [
        "none",
        "semantic-release"
      ],
      "default_value": null
    }
  ],
  "repositories": {
    ".github": {
      "component_role": [
        "governance"
      ],
      "provider_set": [
        "organization"
      ],
      "lifecycle": "active",
      "release_policy": "none"
    },
    "atrinik": {
      "component_role": [
        "coordination"
      ],
      "provider_set": [
        "shared"
      ],
      "lifecycle": "active",
      "release_policy": "semantic-release"
    },
    "classic": {
      "component_role": [
        "aggregate",
        "client",
        "editor",
        "library",
        "protocol",
        "server"
      ],
      "provider_set": [
        "classic"
      ],
      "lifecycle": "active",
      "release_policy": "semantic-release"
    },
    "client": {
      "component_role": [
        "client"
      ],
      "provider_set": [
        "replacement"
      ],
      "lifecycle": "active",
      "release_policy": "semantic-release"
    },
    "content": {
