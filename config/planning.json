{
  "project": {
    "title": "Atrinik work",
    "short_description": "The shared cross-repository cockpit for Atrinik issues and pull requests.",
    "readme": "# Atrinik work\n\nThis organization project is the shared source of truth for active Atrinik work across repositories. New issues enter **Inbox**; the existing portfolio was imported into **Backlog**. Use issue type, Priority, Effort, Start date, Target date, milestone, and hierarchy for planning. Pull requests enter **Review** automatically.\n\nStatus changes made by people are preserved while work remains open. Closing an issue or pull request moves it to **Done**; reopening it returns it to the appropriate intake state.",
    "public": true,
    "triage_cutover": "2026-08-08T09:16:03Z",
    "statuses": [
      {
        "name": "Inbox",
        "color": "GRAY",
        "description": "New work awaiting triage.",
        "previous_names": [
          "Todo"
        ]
      },
      {
        "name": "Backlog",
        "color": "BLUE",
        "description": "Accepted work that is not ready to start.",
        "previous_names": []
      },
      {
        "name": "Ready",
        "color": "YELLOW",
        "description": "Triage is complete and the work can be picked up.",
        "previous_names": []
      },
      {
        "name": "In progress",
        "color": "ORANGE",
        "description": "Implementation is actively underway.",
        "previous_names": [
          "In Progress"
        ]
      },
      {
        "name": "Blocked",
        "color": "RED",
        "description": "Progress depends on an unresolved prerequisite.",
        "previous_names": []
      },
      {
        "name": "Review",
        "color": "PURPLE",
        "description": "A pull request or decision is awaiting review.",
        "previous_names": []
      },
      {
        "name": "Done",
        "color": "GREEN",
        "description": "The issue or pull request is closed.",
        "previous_names": []
      }
    ],
    "views": [
      {
        "name": "Triage",
        "layout": "TABLE_LAYOUT",
        "filter": "is:open status:Inbox",
        "visible_fields": [
          "Title",
          "Repository",
          "Priority",
          "Effort",
          "Status",
          "Milestone",
          "Assignees"
        ]
      },
      {
        "name": "Backlog",
        "layout": "TABLE_LAYOUT",
        "filter": "is:open status:Backlog",
        "visible_fields": [
          "Title",
          "Repository",
          "Priority",
          "Effort",
          "Status",
          "Milestone",
          "Assignees"
        ]
      },
      {
        "name": "Active",
        "layout": "BOARD_LAYOUT",
        "filter": "is:open -status:Inbox -status:Backlog",
        "visible_fields": [
          "Title",
          "Repository",
          "Status",
          "Priority",
          "Assignees",
          "Linked pull requests"
        ]
      },
      {
        "name": "Roadmap",
        "layout": "ROADMAP_LAYOUT",
        "filter": "is:open is:issue -status:Inbox",
        "visible_fields": []
      },
      {
        "name": "Pull requests",
        "layout": "TABLE_LAYOUT",
        "filter": "is:open is:pr",
        "visible_fields": [
          "Title",
          "Repository",
          "Status",
          "Reviewers",
          "Linked pull requests"
        ]
      },
      {
        "name": "Done",
        "layout": "TABLE_LAYOUT",
        "filter": "status:Done",
        "visible_fields": [
          "Title",
          "Repository",
          "Status",
          "Milestone",
          "Assignees"
        ]
      }
    ]
  },
  "issue_types": [
    {
