#!/usr/bin/env bash

set -euo pipefail

organization=${ATRINIK_ORGANIZATION:-atrinik}
api_version=2026-03-10

if (($#)); then
  echo "usage: $0" >&2
  exit 2
fi

for command in base64 gh jq; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done
if [[ ${GITHUB_ACTIONS:-false} == true && -z ${GH_TOKEN:-} ]]; then
  echo "error: ATRINIK_SETTINGS_TOKEN is unavailable: GH_TOKEN is empty in GitHub Actions" >&2
  exit 1
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
manual_settings=${root}/config/manual-settings.json
repository_defaults=${root}/config/repository-defaults.json
temporary=$(mktemp -d)
trap 'rm -rf "${temporary}"' EXIT

"${root}/bin/validate" >/dev/null

github_api() {
  local operation=$1
  local response
  local status

  shift
  if response=$(gh api -H "X-GitHub-Api-Version: ${api_version}" "$@"); then
    :
  else
    status=$?
    echo "error: GitHub API operation failed: ${operation}" >&2
    return "${status}"
  fi
  if ! jq -e 'type == "object"' <<<"${response}" >/dev/null; then
    echo "error: GitHub API operation returned invalid JSON: ${operation}" >&2
    return 1
  fi
  printf '%s\n' "${response}"
}

declare -A repository_data_files=()
declare -A repository_secret_files=()
declare -A repository_variable_files=()

load_repository_identity() {
  local repository=$1
  local repository_key status

  if [[ -v repository_data_files["${repository}"] ]]; then
    return
  fi

  repository_key=${repository//\//-}
  repository_data_files["${repository}"]=${temporary}/${repository_key}.json
  if github_api "read ${repository} identity" "repos/${repository}" \
    >"${repository_data_files["${repository}"]}"; then
    :
  else
    status=$?
    return "${status}"
  fi
}

load_repository_secrets() {
  local repository=$1
  local collected expected page page_size repository_key response status

  if [[ -v repository_secret_files["${repository}"] ]]; then
    return
  fi
  if load_repository_identity "${repository}"; then
    :
  else
    status=$?
    return "${status}"
  fi

  repository_key=${repository//\//-}
  repository_secret_files["${repository}"]=${temporary}/${repository_key}-secrets.jsonl
  : >"${repository_secret_files["${repository}"]}"
  expected=
  collected=0
  page=1
  while true; do
    if response=$(github_api \
      "list ${repository} Actions secrets (page ${page})" \
      "repos/${repository}/actions/secrets?per_page=100&page=${page}"); then
      :
    else
      status=$?
      return "${status}"
    fi
    if ! jq -e '
      (.total_count | type == "number" and floor == . and . >= 0) and
      (.secrets | type == "array")
    ' <<<"${response}" >/dev/null; then
      echo "error: Actions secret metadata response is invalid for ${repository} (page ${page})" >&2
      return 1
    fi
    if [[ -z ${expected} ]]; then
      expected=$(jq -r '.total_count' <<<"${response}")
    elif [[ $(jq -r '.total_count' <<<"${response}") != "${expected}" ]]; then
      echo "error: Actions secret metadata changed while listing ${repository}" >&2
      return 1
    fi
    jq -c '.secrets[]' <<<"${response}" \
      >>"${repository_secret_files["${repository}"]}"
    page_size=$(jq -r '.secrets | length' <<<"${response}")
    ((collected += page_size))
    if ((collected >= expected)); then
      break
    fi
    if ((page_size == 0)); then
      echo "error: Actions secret metadata ended before total_count for ${repository}" >&2
      return 1
    fi
    ((page += 1))
  done
  if ((collected != expected)); then
    echo "error: Actions secret metadata count mismatch for ${repository}: expected ${expected}, got ${collected}" >&2
    return 1
  fi
}

load_repository_variables() {
  local repository=$1
  local collected expected page page_size repository_key response status

  if [[ -v repository_variable_files["${repository}"] ]]; then
    return
  fi
  if load_repository_identity "${repository}"; then
    :
  else
    status=$?
    return "${status}"
  fi

  repository_key=${repository//\//-}
  repository_variable_files["${repository}"]=${temporary}/${repository_key}-variables.jsonl
  : >"${repository_variable_files["${repository}"]}"
  expected=
  collected=0
  page=1
  while true; do
    if response=$(github_api \
      "list ${repository} Actions variables (page ${page})" \
      "repos/${repository}/actions/variables?per_page=100&page=${page}"); then
      :
    else
      status=$?
      return "${status}"
    fi
    if ! jq -e '
      (.total_count | type == "number" and floor == . and . >= 0) and
      (.variables | type == "array") and
      all(
        .variables[];
        (.name | type == "string") and
        (.created_at | type == "string") and
        (.updated_at | type == "string")
      )
    ' <<<"${response}" >/dev/null; then
      echo "error: Actions variable metadata response is invalid for ${repository} (page ${page})" >&2
      return 1
    fi
    if [[ -z ${expected} ]]; then
      expected=$(jq -r '.total_count' <<<"${response}")
    elif [[ $(jq -r '.total_count' <<<"${response}") != "${expected}" ]]; then
      echo "error: Actions variable metadata changed while listing ${repository}" >&2
      return 1
    fi
    jq -c '.variables[] | {name, created_at, updated_at}' <<<"${response}" \
      >>"${repository_variable_files["${repository}"]}"
    page_size=$(jq -r '.variables | length' <<<"${response}")
    ((collected += page_size))
    if ((collected >= expected)); then
      break
    fi
    if ((page_size == 0)); then
      echo "error: Actions variable metadata ended before total_count for ${repository}" >&2
      return 1
    fi
    ((page += 1))
  done
  if ((collected != expected)); then
    echo "error: Actions variable metadata count mismatch for ${repository}: expected ${expected}, got ${collected}" >&2
    return 1
  fi
}

load_paginated_metadata() {
  local operation=$1
  local endpoint=$2
  local collection=$3
  local output=$4
  local collected=0
  local expected=
  local page=1
  local page_size response status

  : >"${output}"
  while true; do
    if response=$(github_api \
      "${operation} (page ${page})" \
      "${endpoint}?per_page=100&page=${page}"); then
      :
    else
      status=$?
      return "${status}"
    fi
    if ! jq -e --arg collection "${collection}" '
      (.total_count | type == "number" and floor == . and . >= 0) and
      (.[$collection] | type == "array")
    ' <<<"${response}" >/dev/null; then
      echo "error: ${operation} returned invalid metadata (page ${page})" >&2
      return 1
    fi
    if [[ -z ${expected} ]]; then
      expected=$(jq -r '.total_count' <<<"${response}")
    elif [[ $(jq -r '.total_count' <<<"${response}") != "${expected}" ]]; then
      echo "error: ${operation} changed while listing metadata" >&2
      return 1
    fi
    jq -c --arg collection "${collection}" '.[$collection][]' <<<"${response}" \
      >>"${output}"
    page_size=$(jq -r --arg collection "${collection}" '.[$collection] | length' \
      <<<"${response}")
    ((collected += page_size))
    if ((collected >= expected)); then
      break
    fi
    if ((page_size == 0)); then
      echo "error: ${operation} ended before total_count" >&2
      return 1
    fi
    ((page += 1))
  done
  if ((collected != expected)); then
    echo "error: ${operation} count mismatch: expected ${expected}, got ${collected}" >&2
    return 1
  fi
}

verify_repository_identity() {
  local repository=$1
  local repository_id=$2
  local default_branch repository_data status

  if load_repository_identity "${repository}"; then
    :
  else
    status=$?
    return "${status}"
  fi
  repository_data=$(<"${repository_data_files["${repository}"]}")
  default_branch=$(jq -r '.default_branch' "${repository_defaults}")
  if ! jq -e \
    --arg repository "${repository}" \
    --arg default_branch "${default_branch}" \
    --argjson repository_id "${repository_id}" '
      .id == $repository_id and
      .full_name == $repository and
      .archived == false and
      .default_branch == $default_branch
    ' <<<"${repository_data}" >/dev/null; then
    echo "error: repository identity or active-state drift for ${repository}" >&2
    return 1
  fi
}

missing=0
while IFS= read -r credential; do
  repository=$(jq -r '.repository' <<<"${credential}")
  repository_owner=${repository%%/*}
  repository_id=$(jq -r '.repository_id' <<<"${credential}")
  secret_name=$(jq -r '.secret_name' <<<"${credential}")
  secret_scope=$(jq -r '.secret_scope' <<<"${credential}")

  if [[ ${repository_owner} != "${organization}" ]]; then
    echo "error: credential repository owner does not match ${organization}: ${repository}" >&2
    exit 1
  fi
  if verify_repository_identity "${repository}" "${repository_id}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  if load_repository_secrets "${repository}"; then
    :
  else
    status=$?
    exit "${status}"
  fi

  case ${secret_scope} in
  repository)
    secrets_file=${repository_secret_files["${repository}"]}
    ;;
  *)
    echo "error: unsupported Actions secret scope for ${repository}: ${secret_scope}" >&2
    exit 1
    ;;
  esac

  updated_at=$(jq -sr --arg name "${secret_name}" '
    [.[] | select(.name == $name) | .updated_at] |
    if length == 1 then .[0] else empty end
  ' "${secrets_file}")
  if [[ -z ${updated_at} ]]; then
    echo "MISSING ${repository} ${secret_scope} Actions secret ${secret_name}" >&2
    ((missing += 1))
    continue
  fi
  echo "KEEP ${repository} ${secret_scope} Actions secret ${secret_name} (updated ${updated_at})"
done < <(jq -c '.github_actions_credentials[]' "${manual_settings}")

if ((missing > 0)); then
  echo "error: ${missing} required Actions credential record(s) are missing live secret metadata" >&2
  exit 1
fi

while IFS= read -r pages_record; do
  repository=$(jq -r '.repository' <<<"${pages_record}")
  repository_owner=${repository%%/*}
  repository_id=$(jq -r '.repository_id' <<<"${pages_record}")
  site_url=$(jq -r '.site_url' <<<"${pages_record}")
  workflow_path=$(jq -r '.workflow_path' <<<"${pages_record}")
  activation_marker=$(jq -r '.activation_marker' <<<"${pages_record}")
  pages_key=${repository//\//-}

  if [[ ${repository_owner} != "${organization}" ]]; then
    echo "error: Pages repository owner does not match ${organization}: ${repository}" >&2
    exit 1
  fi
  if verify_repository_identity "${repository}" "${repository_id}"; then
    :
  else
    status=$?
    exit "${status}"
  fi

  pages_file=${temporary}/${pages_key}-pages.json
  workflow_file=${temporary}/${pages_key}-pages-workflow.json
  if github_api "read ${repository} Pages metadata" \
    "repos/${repository}/pages" >"${pages_file}" &&
    github_api "read ${repository} Pages workflow from the default branch" \
      "repos/${repository}/contents/${workflow_path}?ref=main" >"${workflow_file}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  if ! jq -e --arg site_url "${site_url}" '
    .html_url == $site_url and
    .public == true and
    .https_enforced == true and
    .cname == null and
    (.build_type | IN("legacy", "workflow"))
  ' "${pages_file}" >/dev/null; then
    echo "error: Pages identity or HTTPS drift for ${repository}" >&2
    exit 1
  fi
  if ! jq -e '
    .type == "file" and
    .encoding == "base64" and
    (.content | type == "string")
  ' "${workflow_file}" >/dev/null; then
    echo "error: Pages workflow metadata is invalid for ${repository}" >&2
    exit 1
  fi
  if ! jq -r '.content' "${workflow_file}" | base64 --decode \
    >"${temporary}/${pages_key}-pages-workflow.yml"; then
    echo "error: Pages workflow content is not valid base64 for ${repository}" >&2
    exit 1
  fi

  if grep -Fq -- "${activation_marker}" \
    "${temporary}/${pages_key}-pages-workflow.yml"; then
    if [[ $(jq -r '.build_type' "${pages_file}") != workflow ]]; then
      echo "error: Pages Actions source is not active for merged ${repository} workflow" >&2
      exit 1
    fi
    echo "KEEP ${repository} Pages uses the reviewed Actions workflow source"
  else
    if ! jq -e '
      .build_type == "legacy" and
      .source == {branch: "main", path: "/"}
    ' "${pages_file}" >/dev/null; then
      echo "error: pending Pages activation has unexpected live source for ${repository}" >&2
      exit 1
    fi
    echo "PENDING ${repository} Pages remains on the exact legacy main-root source until the reviewed workflow merges"
  fi
done < <(jq -c '.github_pages_sites[]' "${manual_settings}")

while IFS= read -r environment_record; do
  repository=$(jq -r '.repository' <<<"${environment_record}")
  repository_owner=${repository%%/*}
  repository_id=$(jq -r '.repository_id' <<<"${environment_record}")
  environment=$(jq -r '.environment' <<<"${environment_record}")
  environment_key=${repository//\//-}-${environment}

  if [[ ${repository_owner} != "${organization}" ]]; then
    echo "error: environment repository owner does not match ${organization}: ${repository}" >&2
    exit 1
  fi
  if verify_repository_identity "${repository}" "${repository_id}"; then
    :
  else
    status=$?
    exit "${status}"
  fi

  environment_file=${temporary}/${environment_key}.json
  if github_api \
    "read ${repository} environment ${environment}" \
    "repos/${repository}/environments/${environment}" >"${environment_file}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  if ! jq -e --arg environment "${environment}" '
    .name == $environment and
    (.deployment_branch_policy | type == "object") and
    (.protection_rules | type == "array")
  ' "${environment_file}" >/dev/null; then
    echo "error: environment metadata is invalid for ${repository} ${environment}" >&2
    exit 1
  fi

  expected_branch_mode=$(jq -c '.deployment_branch_policy | {
    protected_branches,
    custom_branch_policies
  }' <<<"${environment_record}")
  live_branch_mode=$(jq -c '.deployment_branch_policy | {
    protected_branches,
    custom_branch_policies
  }' "${environment_file}")
  if [[ ${live_branch_mode} != "${expected_branch_mode}" ]]; then
    echo "error: deployment branch mode drift for ${repository} ${environment}" >&2
    exit 1
  fi

  branch_policies_file=${temporary}/${environment_key}-branch-policies.jsonl
  if load_paginated_metadata \
    "list ${repository} environment ${environment} deployment branch policies" \
    "repos/${repository}/environments/${environment}/deployment-branch-policies" \
    branch_policies "${branch_policies_file}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  expected_branch_policies=$(jq -c \
    '[.deployment_branch_policy.patterns[] | {name, type}] | sort_by(.type, .name)' \
    <<<"${environment_record}")
  live_branch_policies=$(jq -sc \
    '[.[] | {name, type}] | sort_by(.type, .name)' "${branch_policies_file}")
  if [[ ${live_branch_policies} != "${expected_branch_policies}" ]]; then
    echo "error: deployment branch policy drift for ${repository} ${environment}" >&2
    exit 1
  fi

  expected_reviewers=$(jq -c \
    '.required_reviewers | sort_by(.type, .id)' <<<"${environment_record}")
  reviewer_rule_count=$(jq \
    '[.protection_rules[] | select(.type == "required_reviewers")] | length' \
    "${environment_file}")
  live_reviewers=$(jq -c '
    [.protection_rules[] |
      select(.type == "required_reviewers") |
      .reviewers[] |
      {type, id: .reviewer.id}] |
    sort_by(.type, .id)
  ' "${environment_file}")
  if [[ (${expected_reviewers} == '[]' && ${reviewer_rule_count} -ne 0) ||
        (${expected_reviewers} != '[]' && ${reviewer_rule_count} -ne 1) ||
        ${live_reviewers} != "${expected_reviewers}" ]]; then
    echo "error: required reviewer drift for ${repository} ${environment}" >&2
    exit 1
  fi
  expected_protection_rule_types=$(jq -cn \
    --argjson reviewers "${expected_reviewers}" \
    '["branch_policy"] +
      (if ($reviewers | length) > 0 then ["required_reviewers"] else [] end) |
      sort')
  live_protection_rule_types=$(jq -c \
    '[.protection_rules[].type] | sort' "${environment_file}")
  if [[ ${live_protection_rule_types} != "${expected_protection_rule_types}" ]]; then
    echo "error: protection rule drift for ${repository} ${environment}" >&2
    exit 1
  fi

  secrets_file=${temporary}/${environment_key}-secrets.jsonl
  if load_paginated_metadata \
    "list ${repository} environment ${environment} secrets" \
    "repos/${repository}/environments/${environment}/secrets" \
    secrets "${secrets_file}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  expected_names=$(jq -c '.secret_names | sort' <<<"${environment_record}")
  live_names=$(jq -sc '[.[].name] | sort' "${secrets_file}")
  if [[ ${live_names} != "${expected_names}" ]]; then
    echo "error: environment secret-name drift for ${repository} ${environment}" >&2
    exit 1
  fi

  variables_file=${temporary}/${environment_key}-variables.jsonl
  if load_paginated_metadata \
    "list ${repository} environment ${environment} variables" \
    "repos/${repository}/environments/${environment}/variables" \
    variables "${variables_file}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  expected_names=$(jq -c '.variable_names | sort' <<<"${environment_record}")
  live_names=$(jq -sc '[.[].name] | sort' "${variables_file}")
  if [[ ${live_names} != "${expected_names}" ]]; then
    echo "error: environment variable-name drift for ${repository} ${environment}" >&2
    exit 1
  fi

  echo "KEEP ${repository} environment ${environment} metadata"
done < <(jq -c '.github_actions_environments[]' "${manual_settings}")

installations_file=${temporary}/${organization}-installations.jsonl
if load_paginated_metadata \
  "list ${organization} GitHub App installations" \
  "orgs/${organization}/installations" \
  installations "${installations_file}"; then
  :
else
  status=$?
  exit "${status}"
fi

while IFS= read -r app_record; do
  app_id=$(jq -r '.app_id' <<<"${app_record}")
  app_slug=$(jq -r '.app_slug' <<<"${app_record}")
  installation_id=$(jq -r '.installation_id' <<<"${app_record}")
  repository=$(jq -r '.repository' <<<"${app_record}")
  repository_owner=${repository%%/*}
  repository_id=$(jq -r '.repository_id' <<<"${app_record}")
  secret_name=$(jq -r '.secret_name' <<<"${app_record}")
  variable_name=$(jq -r '.variable_name' <<<"${app_record}")

  if [[ ${repository_owner} != "${organization}" ]]; then
    echo "error: GitHub App repository owner does not match ${organization}: ${repository}" >&2
    exit 1
  fi
  if verify_repository_identity "${repository}" "${repository_id}"; then
    :
  else
    status=$?
    exit "${status}"
  fi

  expected_permissions=$(jq -c '.permissions' <<<"${app_record}")
  installation=$(jq -sc \
    --argjson app_id "${app_id}" \
    --argjson installation_id "${installation_id}" '
      [.[] | select(.app_id == $app_id and .id == $installation_id)] |
      if length == 1 then .[0] else empty end
    ' "${installations_file}")
  if [[ -z ${installation} ]]; then
    echo "error: GitHub App installation is missing or ambiguous for ${app_slug}" >&2
    exit 1
  fi
  if ! jq -e \
    --arg app_slug "${app_slug}" \
    --arg organization "${organization}" \
    --argjson expected_permissions "${expected_permissions}" '
      .app_slug == $app_slug and
      .target_type == "Organization" and
      .account.login == $organization and
      .account.type == "Organization" and
      .repository_selection == "selected" and
      .permissions == $expected_permissions and
      .events == [] and
      .suspended_at == null
    ' <<<"${installation}" >/dev/null; then
    echo "error: GitHub App installation metadata or permission drift for ${app_slug}" >&2
    exit 1
  fi

  if load_repository_secrets "${repository}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  secret_updated_at=$(jq -sr --arg name "${secret_name}" '
    [.[] | select(.name == $name) | .updated_at] |
    if length == 1 then .[0] else empty end
  ' "${repository_secret_files["${repository}"]}")
  if [[ -z ${secret_updated_at} ]]; then
    echo "error: GitHub App Actions secret name is missing for ${repository}: ${secret_name}" >&2
    exit 1
  fi

  if load_repository_variables "${repository}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
  variable_updated_at=$(jq -sr --arg name "${variable_name}" '
    [.[] | select(.name == $name) | .updated_at] |
    if length == 1 then .[0] else empty end
  ' "${repository_variable_files["${repository}"]}")
  if [[ -z ${variable_updated_at} ]]; then
    echo "error: GitHub App Actions variable name is missing for ${repository}: ${variable_name}" >&2
    exit 1
  fi

  echo "KEEP ${app_slug} installation metadata and exact permissions"
  echo "KEEP ${repository} repository Actions secret ${secret_name} (updated ${secret_updated_at})"
  echo "KEEP ${repository} repository Actions variable ${variable_name} (updated ${variable_updated_at})"
done < <(jq -c '.github_actions_apps[]' "${manual_settings}")

# GraphQL variables must remain literal for GitHub to substitute.
# shellcheck disable=SC2016
pins_response=$(github_api \
  "read ${organization} organization pins" \
  graphql \
  -f query='query($login:String!){organization(login:$login){login pinnedItems(first:10,types:REPOSITORY){totalCount nodes{... on Repository{name databaseId nameWithOwner isArchived visibility}}}}}' \
  -F login="${organization}")
if ! jq -e \
  --arg organization "${organization}" '
    .data.organization as $organization_data |
    ($organization_data | type == "object") and
    $organization_data.login == $organization and
    ($organization_data.pinnedItems.totalCount | type == "number") and
    ($organization_data.pinnedItems.nodes | type == "array") and
    $organization_data.pinnedItems.totalCount ==
      ($organization_data.pinnedItems.nodes | length) and
    all(
      $organization_data.pinnedItems.nodes[];
      (.name | type == "string" and length > 0) and
      (.databaseId | type == "number" and floor == . and . > 0) and
      .nameWithOwner == "\($organization)/\(.name)" and
      .isArchived == false and
      .visibility == "PUBLIC"
    )
  ' <<<"${pins_response}" >/dev/null; then
  echo "error: GitHub returned invalid organization pin metadata for ${organization}" >&2
  exit 1
fi

desired_pins=$(jq -c '.organization_pins.repositories' "${manual_settings}")
live_pins=$(jq -c '
  [.data.organization.pinnedItems.nodes[] |
    {name, repository_id: .databaseId}]
' <<<"${pins_response}")
if [[ ${live_pins} != "${desired_pins}" ]]; then
  echo "error: organization pin order or identity drift for ${organization}" >&2
  echo "desired: ${desired_pins}" >&2
  echo "live: ${live_pins}" >&2
  exit 1
fi
echo "KEEP ${organization} organization pins match the exact governed order"

echo "Manual settings live credential, GitHub App, Pages, environment, and organization pin metadata is present."
