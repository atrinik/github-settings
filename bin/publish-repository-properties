#!/usr/bin/env bash

set -euo pipefail

organization=${ATRINIK_ORGANIZATION:-atrinik}
api_version=2026-03-10
apply=false

case ${1:-} in
"") ;;
--apply) apply=true ;;
*)
  echo "usage: $0 [--apply]" >&2
  exit 2
  ;;
esac

for command in gh jq sort; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
properties_config=${root}/config/repository-properties.json
temporary_files=()
trap 'rm -f "${temporary_files[@]}"' EXIT

"${root}/bin/validate" >/dev/null

github_api() {
  gh api -H "X-GitHub-Api-Version: ${api_version}" "$@"
}

is_temporary_security_advisory_repository() {
  local repository=$1
  local private=$2
  local visibility=$3
  local disabled=$4
  local fork=$5
  local has_issues=$6
  local has_projects=$7
  local has_wiki=$8
  local base_repository

  if [[ ${repository} =~ ^(.+)-ghsa-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$ ]]; then
    base_repository=${BASH_REMATCH[1]}
  else
    return 1
  fi

  [[ ${private} == true ]] &&
    [[ ${visibility} == private ]] &&
    [[ ${disabled} == false ]] &&
    [[ ${fork} == false ]] &&
    [[ ${has_issues} == false ]] &&
    [[ ${has_projects} == false ]] &&
    [[ ${has_wiki} == false ]] &&
    jq -e --arg repository "${base_repository}" \
      '(.pull_request_gate | index($repository)) != null' \
      "${root}/config/repositories.json" >/dev/null
}

run_api() {
  local method=$1
  local endpoint=$2
  local input=$3

  if ${apply}; then
    github_api --method "${method}" "${endpoint}" --input "${input}" \
      >/dev/null
    echo "APPLY ${method} /${endpoint}"
  else
    echo "PLAN ${method} /${endpoint} <= ${input#"${root}/"}"
  fi
}

schema=$(github_api "orgs/${organization}/properties/schema")

while IFS= read -r definition; do
  property_name=$(jq -r '.property_name' <<<"${definition}")
  current=$(jq -c --arg property_name "${property_name}" '
    map(select(.property_name == $property_name))[0] // null
  ' <<<"${schema}")
  desired=$(jq -c '{
    property_name,
    value_type,
    required,
    default_value,
    description,
    allowed_values
  }' <<<"${definition}")

  if jq -e --argjson desired "${desired}" '
    {
      property_name,
      value_type,
      required,
      default_value,
      description,
      allowed_values
    } == $desired
  ' <<<"${current}" >/dev/null; then
    echo "KEEP /orgs/${organization}/properties/schema/${property_name}"
    continue
  fi

  input=$(mktemp)
  temporary_files+=("${input}")
  jq 'del(.property_name)' <<<"${desired}" >"${input}"
  run_api PUT \
    "orgs/${organization}/properties/schema/${property_name}" "${input}"
done < <(jq -c '.definitions[]' "${properties_config}")

declare -A live_repositories=()
declare -A live_active_repositories=()
while IFS= read -r repository; do
  live_repositories["${repository}"]=true
done < <(
  github_api --paginate "orgs/${organization}/repos?per_page=100&type=all" \
    --jq '.[].name'
)

while IFS=$'\t' read -r \
  repository archived private visibility disabled fork has_issues has_projects has_wiki; do
  if [[ ${archived} == false ]] &&
    ! is_temporary_security_advisory_repository \
      "${repository}" "${private}" "${visibility}" "${disabled}" "${fork}" \
      "${has_issues}" "${has_projects}" "${has_wiki}"; then
    live_active_repositories["${repository}"]=true
  fi
done < <(
  github_api --paginate "orgs/${organization}/repos?per_page=100&type=all" \
    --jq '
      .[] |
      [
        .name,
        (.archived | tostring),
        (.private | tostring),
        .visibility,
        (.disabled | tostring),
        (.fork | tostring),
        (.has_issues | tostring),
        (.has_projects | tostring),
        (.has_wiki | tostring)
      ] |
      @tsv
    '
)

while IFS= read -r repository; do
  if [[ ! -v live_active_repositories["${repository}"] ]]; then
    echo "error: governed active repository is missing or archived: ${organization}/${repository}" >&2
    exit 1
  fi
done < <(
  jq -r '.repositories | to_entries[] | select(.value.lifecycle != "archived") | .key' \
    "${properties_config}"
)

while IFS= read -r repository; do
  if [[ -v live_active_repositories["${repository}"] ]] &&
    ! jq -e --arg repository "${repository}" \
      '.repositories | has($repository)' "${properties_config}" >/dev/null; then
    echo "error: live active repository is not in the property inventory: ${organization}/${repository}" >&2
    exit 1
  fi
done < <(printf '%s\n' "${!live_active_repositories[@]}" | sort)

while IFS= read -r repository; do
  if [[ ! -v live_repositories["${repository}"] ]]; then
    lifecycle=$(jq -r --arg repository "${repository}" \
      '.repositories[$repository].lifecycle' "${properties_config}")
    if [[ ${lifecycle} == archived ]]; then
      echo "SKIP ${organization}/${repository} is an absent archived repository"
      continue
    fi
    echo "error: repository property inventory is not live: ${organization}/${repository}" >&2
    exit 1
  fi

  desired=$(jq -c --arg repository "${repository}" '
    .repositories[$repository] |
    to_entries |
    map({property_name: .key, value: .value}) |
    sort_by(.property_name)
  ' "${properties_config}")
  current=$(github_api "repos/${organization}/${repository}/properties/values" |
    jq -c 'map({property_name, value}) | sort_by(.property_name)')
  if jq -e --argjson desired "${desired}" '. == $desired' \
    <<<"${current}" >/dev/null; then
    echo "KEEP /repos/${organization}/${repository}/properties/values"
    continue
  fi

  input=$(mktemp)
  temporary_files+=("${input}")
  jq -n --arg repository "${repository}" --argjson properties "${desired}" '
    {repository_names: [$repository], properties: $properties}
  ' >"${input}"
  run_api PATCH "orgs/${organization}/properties/values" "${input}"
done < <(jq -r '.repositories | keys[]' "${properties_config}")

echo "Repository custom properties are converged."
