#!/usr/bin/env bash

set -euo pipefail

organization=${ATRINIK_ORGANIZATION:-atrinik}
policy_scope=${ATRINIK_POLICY_SCOPE:-auto}
api_version=2026-03-10
apply=false
retire_maintenance=
sha_pinning_canary=

while (($#)); do
  case $1 in
  --apply)
    apply=true
    shift
    ;;
  --sha-pinning-canary)
    if (($# < 2)) || [[ -z $2 ]]; then
      echo "error: --sha-pinning-canary requires OWNER/REPOSITORY/PR" >&2
      exit 2
    fi
    sha_pinning_canary=$2
    shift 2
    ;;
  --retire-maintenance)
    if (($# < 2)) || [[ -z $2 ]]; then
      echo "error: --retire-maintenance requires REPOSITORY/BRANCH" >&2
      exit 2
    fi
    retire_maintenance=$2
    shift 2
    ;;
  *)
    echo "usage: $0 [--apply] [--retire-maintenance REPOSITORY/BRANCH] [--sha-pinning-canary OWNER/REPOSITORY/PR]" >&2
    exit 2
    ;;
  esac
done

case ${policy_scope} in
auto | organization | repository) ;;
*)
  echo "error: ATRINIK_POLICY_SCOPE must be auto, organization, or repository" >&2
  exit 2
  ;;
esac

for command in gh git jq sort python3; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
organization_config=${root}/config/organization.json
repositories_config=${root}/config/repositories.json
advisory_merge_windows_config=${root}/config/advisory-merge-windows.json
codeql_advanced_config=${root}/config/codeql-advanced-setup.json
immutable_releases_config=${root}/config/immutable-releases.json
retired_maintenance_config=${root}/config/retired-maintenance-branches.json
security_merge_config=${root}/config/security-merge-protection.json
if [[ -n ${sha_pinning_canary} && ${sha_pinning_canary} != "${organization}/"* ]]; then
  echo "error: SHA canary must belong to ${organization}" >&2
  exit 2
fi
temporary_files=()
trap 'rm -f "${temporary_files[@]}"' EXIT

"${root}/bin/validate" >/dev/null

github_api() {
  gh api -H "X-GitHub-Api-Version: ${api_version}" "$@"
}

# Capture every page before any caller treats a ruleset as present or absent.
# gh 2.46 emits one JSON array per page; --slurp is unavailable on that host.
list_rulesets() {
  local endpoint=$1 pages
  pages=$(github_api "${endpoint}" --paginate) || {
    echo "error: cannot read complete ruleset inventory: ${endpoint}" >&2
    return 1
  }
  jq -ecs '
    if length > 0 and all(.[];
      type == "array" and all(.[];
        type == "object" and
        (.id | type == "number" and . > 0 and floor == .) and
        (.name | type == "string" and length > 0))) then
      add |
      if (map(.id) | length == (unique | length)) and
         (map(.name) | length == (unique | length)) then .
      else error("duplicate ruleset identity or name") end
    else error("invalid ruleset page") end
  ' <<<"${pages}" || {
    echo "error: invalid or ambiguous complete ruleset inventory: ${endpoint}" >&2
    return 1
  }
}

run_api() {
  local method=$1
  local endpoint=$2
  local input=${3:-}

  if ${apply}; then
    if [[ -n ${input} ]]; then
      github_api --method "${method}" "${endpoint}" --input "${input}" >/dev/null
    else
      github_api --method "${method}" "${endpoint}" >/dev/null
    fi
  elif [[ -n ${input} ]]; then
    echo "PLAN ${method} /${endpoint} <= ${input#"${root}/"}"
  else
    echo "PLAN ${method} /${endpoint}"
  fi
}

retire_maintenance_branch_ruleset() {
  local coordinate=$1
  local retirement repository branch repository_id default_branch
  local branch_commit release_tag release_commit ruleset_id ruleset_name
  local repository_metadata ruleset branch_ref tag_ref release open_pulls
  local rulesets preserved_id preserved_name

  retirement=$(jq -c --arg coordinate "${coordinate}" '
    [
      .retirements[] |
      select("\(.repository)/\(.branch)" == $coordinate)
    ] |
    if length == 1 then .[0] else empty end
  ' "${retired_maintenance_config}")
  if [[ -z ${retirement} ]]; then
    echo "error: retirement coordinate is absent or ambiguous: ${coordinate}" >&2
    exit 1
  fi

  repository=$(jq -r '.repository' <<<"${retirement}")
  branch=$(jq -r '.branch' <<<"${retirement}")
  repository_id=$(jq -r '.repository_id' <<<"${retirement}")
  default_branch=$(jq -r '.default_branch' <<<"${retirement}")
  branch_commit=$(jq -r '.final_branch_commit' <<<"${retirement}")
  release_tag=$(jq -r '.final_release.tag' <<<"${retirement}")
  release_commit=$(jq -r '.final_release.commit' <<<"${retirement}")
  ruleset_id=$(jq -r '.ruleset.id' <<<"${retirement}")
  ruleset_name=$(jq -r '.ruleset.name' <<<"${retirement}")

  if jq -e --arg repository "${repository}" --arg branch "${branch}" '
    any(
      .maintenance_branches[];
      .repository == $repository and .branch == $branch
    )
  ' "${repositories_config}" >/dev/null; then
    echo "error: retirement target remains in desired maintenance branches" >&2
    exit 1
  fi

  repository_metadata=$(github_api "repos/${organization}/${repository}")
  if ! jq -e --argjson id "${repository_id}" \
    --arg default_branch "${default_branch}" '
      .id == $id and
      .archived == false and
      .default_branch == $default_branch
    ' <<<"${repository_metadata}" >/dev/null; then
    echo "error: retirement repository identity or default branch drift" >&2
    exit 1
  fi

  branch_ref=$(github_api \
    "repos/${organization}/${repository}/git/ref/heads/${branch}")
  if [[ $(jq -r '.object.sha // empty' <<<"${branch_ref}") != \
    "${branch_commit}" ]]; then
    echo "error: retirement branch commit drift" >&2
    exit 1
  fi

  tag_ref=$(github_api \
    "repos/${organization}/${repository}/git/ref/tags/${release_tag}")
  if [[ $(jq -r '.object.sha // empty' <<<"${tag_ref}") != \
    "${release_commit}" ]]; then
    echo "error: final rollback tag commit drift" >&2
    exit 1
  fi

  release=$(github_api \
    "repos/${organization}/${repository}/releases/tags/${release_tag}")
  if ! jq -e --arg tag "${release_tag}" --argjson retirement "${retirement}" '
    .tag_name == $tag and
    .draft == false and
    .prerelease == false and
    ([.assets[].name] | sort) == ($retirement.final_release.assets | sort)
  ' <<<"${release}" >/dev/null; then
    echo "error: final rollback release or asset inventory drift" >&2
    exit 1
  fi

  open_pulls=$(github_api \
    "repos/${organization}/${repository}/pulls?state=open&base=${branch}&per_page=100")
  if [[ $(jq 'length' <<<"${open_pulls}") != 0 ]]; then
    echo "error: open pull requests still target the retirement branch" >&2
    exit 1
  fi

  rulesets=$(list_rulesets "orgs/${organization}/rulesets") || return 1
  while IFS=$'\t' read -r preserved_id preserved_name; do
    if ! jq -e --argjson id "${preserved_id}" --arg name "${preserved_name}" '
      any(.[]; .id == $id and .name == $name and .enforcement == "active")
    ' <<<"${rulesets}" >/dev/null; then
      echo "error: preserved ruleset identity or enforcement drift: ${preserved_id}" >&2
      exit 1
    fi
  done < <(jq -r '.preserved_rulesets[] | [.id, .name] | @tsv' \
    <<<"${retirement}")

  if ! jq -e --argjson id "${ruleset_id}" --arg name "${ruleset_name}" '
    [.[] | select(.id == $id and .name == $name)] | length == 1
  ' <<<"${rulesets}" >/dev/null; then
    echo "error: exact retirement ruleset is missing or ambiguous" >&2
    exit 1
  fi

  ruleset=$(github_api "orgs/${organization}/rulesets/${ruleset_id}")
  if ! jq -e --argjson id "${ruleset_id}" --arg name "${ruleset_name}" \
    --arg repository "${repository}" --arg branch "${branch}" \
    --argjson retirement "${retirement}" '
      .id == $id and
      .name == $name and
      .target == "branch" and
      .enforcement == "active" and
      .bypass_actors == [{
        actor_id: null,
        actor_type: "OrganizationAdmin",
        bypass_mode: "pull_request"
      }] and
      .conditions.repository_name.include == [$repository] and
      .conditions.repository_name.exclude == [] and
      .conditions.ref_name.include == ["refs/heads/\($branch)"] and
      .conditions.ref_name.exclude == [] and
      ([.rules[].type] | sort) == ([
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_linear_history",
        "required_status_checks"
      ] | sort) and
      ([.rules[] | select(.type == "pull_request")] | length == 1) and
      ([.rules[] | select(.type == "pull_request")][0].parameters == {
        allowed_merge_methods: ["merge", "squash", "rebase"],
        dismiss_stale_reviews_on_push: false,
        require_code_owner_review: false,
        require_last_push_approval: false,
        required_approving_review_count: 0,
        required_review_thread_resolution: true,
        required_reviewers: []
      }) and
      ([.rules[] | select(.type == "required_status_checks")] | length == 1) and
      ([.rules[] | select(.type == "required_status_checks")][0].parameters == {
        do_not_enforce_on_create: false,
        required_status_checks: (
          $retirement.ruleset.required_ci |
          map({context: ., integration_id: 15368})
        ),
        strict_required_status_checks_policy: true
      })
    ' <<<"${ruleset}" >/dev/null; then
    echo "error: exact retirement ruleset payload drift" >&2
    exit 1
  fi

  echo "KEEP ${organization}/${repository} default branch is ${default_branch}"
  echo "KEEP refs/heads/${branch} is ${branch_commit}"
  echo "KEEP ${release_tag} is ${release_commit} with exact recovery assets"
  echo "KEEP no open pull request targets ${branch}"
  run_api DELETE "orgs/${organization}/rulesets/${ruleset_id}"

  if ${apply}; then
    rulesets=$(list_rulesets "orgs/${organization}/rulesets") || return 1
    if jq -e --argjson id "${ruleset_id}" 'any(.[]; .id == $id)' \
      <<<"${rulesets}" >/dev/null; then
      echo "error: retirement ruleset still exists after apply" >&2
      exit 1
    fi
    while IFS=$'\t' read -r preserved_id preserved_name; do
      if ! jq -e --argjson id "${preserved_id}" --arg name "${preserved_name}" '
        any(.[]; .id == $id and .name == $name and .enforcement == "active")
      ' <<<"${rulesets}" >/dev/null; then
        echo "error: preserved ruleset changed during retirement: ${preserved_id}" >&2
        exit 1
      fi
    done < <(jq -r '.preserved_rulesets[] | [.id, .name] | @tsv' \
      <<<"${retirement}")
    echo "APPLY verified only ruleset ${ruleset_id} is absent"
  fi
}

if [[ -n ${retire_maintenance} ]]; then
  retire_maintenance_branch_ruleset "${retire_maintenance}"
  exit 0
fi

converge_organization_settings() {
  local current=$1
  local desired

  desired=$(jq -c . "${organization_config}")
  if jq -e --argjson desired "${desired}" '
    . as $current |
    all($desired | to_entries[]; $current[.key] == .value)
  ' <<<"${current}" >/dev/null; then
    echo "KEEP /orgs/${organization} metadata and repository defaults"
    return
  fi

  jq -r \
    --arg endpoint "/orgs/${organization}" \
    --argjson desired "${desired}" '
      . as $current |
      $desired | to_entries[] |
      select($current[.key] != .value) |
      "DRIFT \($endpoint) \(.key) live=\($current[.key] | tojson) desired=\(.value | tojson)"
    ' <<<"${current}"
  run_api PATCH "orgs/${organization}" "${organization_config}"
}

repository_uses_advanced_codeql() {
  local repository=$1

  jq -e --arg repository "${repository}" \
    '(.repositories | index($repository)) != null' \
    "${codeql_advanced_config}" >/dev/null
}

repository_has_advisory_merge_window() {
  local repository=$1

  jq -e --arg repository "${repository}" \
    '(.repositories | index($repository)) != null' \
    "${advisory_merge_windows_config}" >/dev/null
}

is_temporary_security_advisory_repository() {
  local repository=$1
  local private=$2
  local visibility=$3
  local disabled=$4
  local fork=$5
  local has_issues=$6
  local has_projects=$7
  local has_wiki=$8
  local base_repository

  if [[ ${repository} =~ ^(.+)-ghsa-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$ ]]; then
    base_repository=${BASH_REMATCH[1]}
  else
    return 1
  fi

  [[ ${private} == true ]] &&
    [[ ${visibility} == private ]] &&
    [[ ${disabled} == false ]] &&
    [[ ${fork} == false ]] &&
    [[ ${has_issues} == false ]] &&
    [[ ${has_projects} == false ]] &&
    [[ ${has_wiki} == false ]] &&
    jq -e --arg repository "${base_repository}" \
      '(.pull_request_gate | index($repository)) != null' \
      "${repositories_config}" >/dev/null
}

upsert_repository_ruleset() {
  local repository=$1
  local input=$2
  local name id rulesets

  name=$(jq -r '.name' "${input}")
  rulesets=$(list_rulesets "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
  id=$(jq -r --arg name "${name}" 'map(select(.name == $name))[0].id // empty' <<<"${rulesets}")

  if [[ -n ${id} ]]; then
    run_api PUT "repos/${organization}/${repository}/rulesets/${id}" "${input}"
  else
    run_api POST "repos/${organization}/${repository}/rulesets" "${input}"
  fi
}

upsert_organization_ruleset() {
  local input=$1
  local name id rulesets

  name=$(jq -r '.name' "${input}")
  rulesets=$(list_rulesets "orgs/${organization}/rulesets") || return 1
  id=$(jq -r --arg name "${name}" 'map(select(.name == $name))[0].id // empty' <<<"${rulesets}")

  if [[ -n ${id} ]]; then
    run_api PUT "orgs/${organization}/rulesets/${id}" "${input}"
  else
    run_api POST "orgs/${organization}/rulesets" "${input}"
  fi
}

make_organization_ruleset() {
  local base=$1
  local name=$2
  local repositories=$3
  local excluded_repositories=${4:-[]}
  local output

  output=$(mktemp)
  temporary_files+=("${output}")
  jq --arg name "${name}" \
    --argjson repositories "${repositories}" \
    --argjson excluded_repositories "${excluded_repositories}" '
    .name = $name |
    .conditions.repository_name = {
      include: $repositories,
      exclude: $excluded_repositories,
      protected: false
    }
  ' "${base}" >"${output}"
  echo "${output}"
}

maintenance_ruleset_name() {
  local repository=$1
  local branch=$2

  printf '05 - Maintenance branch - %s - %s' "${repository}" "${branch}"
}

make_maintenance_ruleset() {
  local repository=$1
  local branch=$2
  local required_ci=$3
  local scope=$4
  local output name

  name=$(maintenance_ruleset_name "${repository}" "${branch}")
  output=$(mktemp)
  temporary_files+=("${output}")
  jq --arg name "${name}" \
    --arg repository "${repository}" \
    --arg branch "${branch}" \
    --arg scope "${scope}" \
    --argjson app_id 15368 \
    --argjson required_ci "${required_ci}" '
      .name = $name |
      .conditions.ref_name.include = ["refs/heads/\($branch)"] |
      .rules = (
        .rules |
        map(
          if .type == "required_status_checks" then
            .parameters.required_status_checks =
              ($required_ci | map({context: ., integration_id: $app_id}))
          else
            .
          end
        ) |
        if ($required_ci | length) == 0 then
          map(select(.type != "required_status_checks"))
        else
          .
        end
      ) |
      if $scope == "organization" then
        .conditions.repository_name = {
          include: [$repository],
          exclude: [],
          protected: false
        }
      else
        .
      end
    ' "${root}/config/rulesets/maintenance-branch.json" >"${output}"
  echo "${output}"
}

maintenance_ruleset_is_desired() {
  local repository=$1
  local candidate=$2
  local branch expected

  while IFS= read -r branch; do
    expected=$(maintenance_ruleset_name "${repository}" "${branch}")
    if [[ ${candidate} == "${expected}" ]]; then
      return 0
    fi
  done < <(
    jq -r --arg repository "${repository}" '
      .maintenance_branches[] |
      select(.repository == $repository) |
      .branch
    ' "${repositories_config}"
  )
  return 1
}

delete_stale_repository_maintenance_rulesets() {
  local repository ruleset name id rulesets

  for repository in "${active_repositories[@]}"; do
    rulesets=$(list_rulesets "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
    while IFS= read -r ruleset; do
      name=$(jq -r '.name' <<<"${ruleset}")
      id=$(jq -r '.id' <<<"${ruleset}")
      if [[ ${name} != "05 - Maintenance branch - "* ]]; then
        continue
      fi
      if ! maintenance_ruleset_is_desired "${repository}" "${name}"; then
        run_api DELETE "repos/${organization}/${repository}/rulesets/${id}" || return 1
      fi
    done < <(jq -c '.[]' <<<"${rulesets}")
  done
}

delete_stale_repository_advisory_rulesets() {
  local repository ruleset name id window_active rulesets

  while IFS= read -r repository; do
    window_active=false
    if repository_has_advisory_merge_window "${repository}"; then
      window_active=true
    fi
    rulesets=$(list_rulesets "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
    while IFS= read -r ruleset; do
      name=$(jq -r '.name' <<<"${ruleset}")
      id=$(jq -r '.id' <<<"${ruleset}")
      if ${window_active}; then
        case ${name} in
        "01 - Default branch integrity" | \
          "01 - Default branch linear history" | \
          "02 - Changes through pull requests")
          run_api DELETE \
            "repos/${organization}/${repository}/rulesets/${id}" || return 1
          ;;
        esac
      else
        case ${name} in
        "01 - Default branch integrity - ${repository}" | \
          "01 - Default branch linear history - ${repository}" | \
          "02 - Changes through pull requests - ${repository}")
          run_api DELETE \
            "repos/${organization}/${repository}/rulesets/${id}" || return 1
          ;;
        esac
      fi
    done < <(jq -c '.[]' <<<"${rulesets}")
  done < <(jq -r '.pull_request_gate[]' "${repositories_config}")
}

delete_managed_repository_rulesets() {
  local repository=$1
  local ruleset name id rulesets

  rulesets=$(list_rulesets "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
  while IFS= read -r ruleset; do
    name=$(jq -r '.name' <<<"${ruleset}")
    id=$(jq -r '.id' <<<"${ruleset}")
    case ${name} in
    "01 - Default branch integrity" | \
      "01 - Default branch integrity - classic" | \
      "01 - Default branch linear history" | \
      "01 - Default branch linear history - classic" | \
      "02 - Changes through pull requests" | \
      "02 - Changes through pull requests - classic" | \
      "03 - Required CI" | \
      "04 - Immutable release tags" | \
      "05 - Maintenance branch - "*)
      run_api DELETE "repos/${organization}/${repository}/rulesets/${id}" || return 1
      ;;
    esac
  done < <(jq -c '.[]' <<<"${rulesets}")
}

delete_managed_organization_rulesets() {
  local ruleset name id rulesets

  rulesets=$(list_rulesets "orgs/${organization}/rulesets") || return 1
  while IFS= read -r ruleset; do
    name=$(jq -r '.name' <<<"${ruleset}")
    id=$(jq -r '.id' <<<"${ruleset}")
    case ${name} in
    "01 - Default branch integrity" | \
      "01 - Default branch integrity - classic" | \
      "01 - Default branch linear history" | \
      "01 - Default branch linear history - classic" | \
      "02 - Changes through pull requests" | \
      "02 - Changes through pull requests - classic" | \
      "04 - Immutable release tags" | \
      "03 - Required CI - "* | \
      "05 - Maintenance branch - "*)
      run_api DELETE "orgs/${organization}/rulesets/${id}" || return 1
      ;;
    esac
  done < <(jq -c '.[]' <<<"${rulesets}")
}

retired_required_ci_matches() {
  local repository=$1 id=$2 template=$3 current=$4
  jq -e --argjson id "${id}" --arg source "${organization}/${repository}" '
    .id == $id and .source_type == "Repository" and .source == $source
  ' <<<"${current}" >/dev/null && security_ruleset_matches "${template}" "${current}"
}

delete_retired_repository_required_ci() {
  local repository listed record id template current metadata fresh
  for repository in "${active_repositories[@]}"; do
    [[ -v active_repository_ids["${repository}"] ]] || continue
    if jq -e --arg repository "${repository}" '.required_ci | has($repository)' \
      "${repositories_config}" >/dev/null; then
      continue
    fi
    listed=$(list_rulesets "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
    listed=$(jq -c '[.[] | select(.name == "03 - Required CI")]' <<<"${listed}")
    [[ $(jq length <<<"${listed}") != 0 ]] || continue
    record=$(jq -c --arg repository "${repository}" \
      '[.retirements[] | select(.repository == $repository)]' "${root}/config/retired-required-ci.json")
    if [[ $(jq length <<<"${listed}") != 1 || $(jq length <<<"${record}") != 1 ]]; then
      echo "SKIP ${organization}/${repository} 03 - Required CI: retained; requires one reviewed config/retired-required-ci.json record and unique live rule"
      continue
    fi
    record=$(jq -c '.[0]' <<<"${record}")
    id=$(jq -r '.ruleset_id' <<<"${record}")
    if ! jq -e --argjson id "${id}" '.[0].id == $id' <<<"${listed}" >/dev/null; then
      echo "SKIP ${organization}/${repository} 03 - Required CI: recorded ruleset identity differs; retained"
      continue
    fi
    template=$(mktemp)
    temporary_files+=("${template}")
    jq --argjson record "${record}" '
      .rules[0].parameters.required_status_checks =
        ($record.required_ci | map({context: ., integration_id: 15368}))
    ' "${root}/config/rulesets/required-ci.json" >"${template}"
    current=$(github_api "repos/${organization}/${repository}/rulesets/${id}") || return 1
    if ! retired_required_ci_matches "${repository}" "${id}" "${template}" "${current}"; then
      echo "SKIP ${organization}/${repository} 03 - Required CI: modified or foreign rule; retained"
      continue
    fi
    metadata=$(github_api "repos/${organization}/${repository}") || return 1
    if ! jq -e --argjson record "${record}" --argjson enumerated "${active_repository_ids["${repository}"]}" \
      --arg full_name "${organization}/${repository}" '
      .id == $record.repository_id and .id == $enumerated and
      .full_name == $full_name and .archived == false
    ' <<<"${metadata}" >/dev/null; then
      echo "SKIP ${organization}/${repository} 03 - Required CI: repository identity or archive state changed; retained"
      continue
    fi
    fresh=$(github_api "repos/${organization}/${repository}/rulesets/${id}") || return 1
    if ! retired_required_ci_matches "${repository}" "${id}" "${template}" "${fresh}"; then
      echo "SKIP ${organization}/${repository} 03 - Required CI: rule changed during retirement preflight; retained"
      continue
    fi
    run_api DELETE "repos/${organization}/${repository}/rulesets/${id}" || return 1
  done
}

publish_repository_rulesets() {
  local repository ruleset_config ci_payload maintenance branch required_ci
  local input

  # Establish the Classic-specific policy before replacing its shared policy.
  for repository in "${active_repositories[@]}"; do
    ruleset_config=${root}/config/rulesets/default-branch-linear-history.json
    if repository_has_advisory_merge_window "${repository}"; then
      ruleset_config=${root}/config/rulesets/default-branch-linear-history-classic.json
    fi
    upsert_repository_ruleset "${repository}" \
      "${ruleset_config}" || return 1
  done

  for repository in "${active_repositories[@]}"; do
    ruleset_config=${root}/config/rulesets/default-branch-integrity.json
    if repository_has_advisory_merge_window "${repository}"; then
      ruleset_config=${root}/config/rulesets/default-branch-integrity-classic.json
    fi
    upsert_repository_ruleset "${repository}" \
      "${ruleset_config}" || return 1
  done

  while IFS= read -r repository; do
    ruleset_config=${root}/config/rulesets/pull-request-gate.json
    if repository_has_advisory_merge_window "${repository}"; then
      ruleset_config=${root}/config/rulesets/pull-request-gate-classic.json
    fi
    upsert_repository_ruleset "${repository}" \
      "${ruleset_config}" || return 1
  done < <(jq -r '.pull_request_gate[]' "${repositories_config}")

  while IFS= read -r repository; do
    ci_payload=$(mktemp)
    temporary_files+=("${ci_payload}")
    jq --arg repository "${repository}" \
      --argjson app_id 15368 \
      --slurpfile advisory_windows "${advisory_merge_windows_config}" \
      --slurpfile repositories "${repositories_config}" '
        .bypass_actors |= map(
          if ($advisory_windows[0].repositories | index($repository)) != null then
            .bypass_mode = "always"
          else
            .
          end
        ) |
        .rules[0].parameters.required_status_checks =
          ($repositories[0].required_ci[$repository] |
           map({context: ., integration_id: $app_id}))
      ' "${root}/config/rulesets/required-ci.json" >"${ci_payload}"
    upsert_repository_ruleset "${repository}" "${ci_payload}" || return 1
  done < <(jq -r '.required_ci | keys[]' "${repositories_config}")

  while IFS= read -r repository; do
    upsert_repository_ruleset "${repository}" \
      "${root}/config/rulesets/immutable-release-tags.json" || return 1
  done < <(jq -r '.release_tags[]' "${repositories_config}")

  while IFS= read -r maintenance; do
    repository=$(jq -r '.repository' <<<"${maintenance}")
    branch=$(jq -r '.branch' <<<"${maintenance}")
    required_ci=$(jq -c '.required_ci' <<<"${maintenance}")
    input=$(make_maintenance_ruleset \
      "${repository}" "${branch}" "${required_ci}" repository)
    temporary_files+=("${input}")
    upsert_repository_ruleset "${repository}" "${input}" || return 1
  done < <(jq -c '.maintenance_branches[]' "${repositories_config}")

  delete_retired_repository_required_ci || return 1
  delete_stale_repository_maintenance_rulesets || return 1
  delete_stale_repository_advisory_rulesets || return 1

  if [[ ${organization_plan} != free ]]; then
    delete_managed_organization_rulesets || return 1
  fi
}

publish_organization_rulesets() {
  local input repository ci_payload maintenance branch required_ci
  local -a desired_rulesets
  local repositories ruleset name id desired rulesets

  desired_rulesets=(
    "01 - Default branch integrity"
    "01 - Default branch linear history"
    "02 - Changes through pull requests"
    "04 - Immutable release tags"
  )

  # Establish the Classic-specific policies before excluding it from their
  # shared counterparts.
  if repository_has_advisory_merge_window classic; then
    desired_rulesets+=(
      "01 - Default branch integrity - classic"
      "01 - Default branch linear history - classic"
      "02 - Changes through pull requests - classic"
    )
    input=$(make_organization_ruleset \
      "${root}/config/rulesets/default-branch-integrity-classic.json" \
      "01 - Default branch integrity - classic" '["classic"]')
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}" || return 1
    input=$(make_organization_ruleset \
      "${root}/config/rulesets/default-branch-linear-history-classic.json" \
      "01 - Default branch linear history - classic" '["classic"]')
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}" || return 1
  fi

  repositories=$(jq -c '.repositories' "${advisory_merge_windows_config}")

  input=$(make_organization_ruleset \
    "${root}/config/rulesets/default-branch-linear-history.json" \
    "01 - Default branch linear history" '["~ALL"]' "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}" || return 1

  input=$(make_organization_ruleset \
    "${root}/config/rulesets/default-branch-integrity.json" \
    "01 - Default branch integrity" '["~ALL"]' "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}" || return 1

  # Establish the Classic-specific policy before excluding it from the shared
  # pull-request policy.
  if repository_has_advisory_merge_window classic; then
    input=$(make_organization_ruleset \
      "${root}/config/rulesets/pull-request-gate-classic.json" \
      "02 - Changes through pull requests - classic" '["classic"]')
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}" || return 1
  fi

  repositories=$(jq -c \
    --slurpfile advisory_windows "${advisory_merge_windows_config}" \
    '.pull_request_gate - $advisory_windows[0].repositories' \
    "${repositories_config}")
  input=$(make_organization_ruleset \
    "${root}/config/rulesets/pull-request-gate.json" \
    "02 - Changes through pull requests" "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}" || return 1

  repositories=$(jq -c '.release_tags' "${repositories_config}")
  input=$(make_organization_ruleset \
    "${root}/config/rulesets/immutable-release-tags.json" \
    "04 - Immutable release tags" "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}" || return 1

  while IFS= read -r repository; do
    name="03 - Required CI - ${repository}"
    desired_rulesets+=("${name}")
    ci_payload=$(mktemp)
    temporary_files+=("${ci_payload}")
    jq --arg name "${name}" \
      --arg repository "${repository}" \
      --argjson app_id 15368 \
      --slurpfile advisory_windows "${advisory_merge_windows_config}" \
      --slurpfile repositories "${repositories_config}" '
        .name = $name |
        .bypass_actors |= map(
          if ($advisory_windows[0].repositories | index($repository)) != null then
            .bypass_mode = "always"
          else
            .
          end
        ) |
        .conditions.repository_name = {
          include: [$repository],
          exclude: [],
          protected: false
        } |
        .rules[0].parameters.required_status_checks =
          ($repositories[0].required_ci[$repository] |
           map({context: ., integration_id: $app_id}))
      ' "${root}/config/rulesets/required-ci.json" >"${ci_payload}"
    upsert_organization_ruleset "${ci_payload}" || return 1
  done < <(jq -r '.required_ci | keys[]' "${repositories_config}")

  while IFS= read -r maintenance; do
    repository=$(jq -r '.repository' <<<"${maintenance}")
    branch=$(jq -r '.branch' <<<"${maintenance}")
    required_ci=$(jq -c '.required_ci' <<<"${maintenance}")
    name=$(maintenance_ruleset_name "${repository}" "${branch}")
    desired_rulesets+=("${name}")
    input=$(make_maintenance_ruleset \
      "${repository}" "${branch}" "${required_ci}" organization)
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}" || return 1
  done < <(jq -c '.maintenance_branches[]' "${repositories_config}")

  rulesets=$(list_rulesets "orgs/${organization}/rulesets") || return 1
  while IFS= read -r ruleset; do
    name=$(jq -r '.name' <<<"${ruleset}")
    id=$(jq -r '.id' <<<"${ruleset}")
    case ${name} in
    "01 - Default branch integrity - "* | \
      "01 - Default branch linear history - "* | \
      "02 - Changes through pull requests - "* | \
      "03 - Required CI - "* | \
      "05 - Maintenance branch - "*) ;;
    *)
      continue
      ;;
    esac
    desired=false
    for repository in "${desired_rulesets[@]}"; do
      if [[ ${repository} == "${name}" ]]; then
        desired=true
        break
      fi
    done
    if ! ${desired}; then
      run_api DELETE "orgs/${organization}/rulesets/${id}" || return 1
    fi
  done < <(jq -c '.[]' <<<"${rulesets}")

  for repository in "${active_repositories[@]}"; do
    delete_managed_repository_rulesets "${repository}" || return 1
  done
}

upsert_code_security_configuration() {
  local input=$1
  local placeholder=$2
  local name id current

  name=$(jq -r '.name' "${input}")
  id=$(
    github_api "orgs/${organization}/code-security/configurations" |
      jq -r --arg name "${name}" 'map(select(.name == $name))[0].id // empty'
  )

  if [[ -n ${id} ]]; then
    current=$(github_api \
      "orgs/${organization}/code-security/configurations/${id}")
    if code_security_configuration_matches "${input}" "${current}"; then
      echo "KEEP /orgs/${organization}/code-security/configurations/${id} matches ${input#"${root}/"}"
    else
      run_api PATCH \
        "orgs/${organization}/code-security/configurations/${id}" \
        "${input}"
    fi
  elif ${apply}; then
    id=$(
      github_api --method POST \
        "orgs/${organization}/code-security/configurations" \
        --input "${input}" | jq -r '.id'
    )
  else
    echo "PLAN POST /orgs/${organization}/code-security/configurations <= ${input#"${root}/"}"
    id=${placeholder}
  fi

  if ${apply} && [[ ! ${id} =~ ^[0-9]+$ ]]; then
    echo "error: invalid code security configuration id for ${name}: ${id}" >&2
    exit 1
  fi

  upserted_code_security_configuration_id=${id}
}

code_security_configuration_matches() {
  local input=$1
  local current=$2

  # GitHub currently returns the legacy advanced_security summary even when
  # code_security and secret_protection were written separately. Normalize
  # that response before comparing only the fields owned by desired state.
  jq -e --slurpfile desired "${input}" '
    . as $current |
    (
      $current + {
        code_security: (
          if $current.code_security != null then
            $current.code_security
          elif (
            $current.advanced_security == "enabled" or
            $current.advanced_security == "code_security"
          ) then
            "enabled"
          elif (
            $current.advanced_security == "disabled" or
            $current.advanced_security == "secret_protection"
          ) then
            "disabled"
          else
            "not_set"
          end
        ),
        secret_protection: (
          if $current.secret_protection != null then
            $current.secret_protection
          elif (
            $current.advanced_security == "enabled" or
            $current.advanced_security == "secret_protection"
          ) then
            "enabled"
          elif (
            $current.advanced_security == "disabled" or
            $current.advanced_security == "code_security"
          ) then
            "disabled"
          else
            "not_set"
          end
        )
      }
    ) as $normalized |
    $desired[0] as $wanted |
    reduce ($wanted | keys[]) as $key
      (true; . and ($normalized[$key] == $wanted[$key]))
  ' <<<"${current}" >/dev/null
}

make_security_attach_payload() {
  local advanced=$1
  local expected_id=$2
  local repository repository_is_advanced id current status current_id
  local ids='[]'

  security_attachment_wait_needed=false

  for repository in "${active_repositories[@]}"; do
    repository_is_advanced=false
    if repository_uses_advanced_codeql "${repository}"; then
      repository_is_advanced=true
    fi
    if [[ ${repository_is_advanced} != "${advanced}" ]]; then
      continue
    fi

    id=${active_repository_ids["${repository}"]}
    current=
    if current=$(github_api \
      "repos/${organization}/${repository}/code-security-configuration" \
      2>/dev/null); then
      status=$(jq -r '.status // empty' <<<"${current}")
      current_id=$(jq -r '.configuration.id // empty' <<<"${current}")
      if [[ ${current_id} == "${expected_id}" ]]; then
        # Both managed configurations require enforcement. An attached
        # relationship must settle to enforced, but must not be re-attached.
        case ${status} in
        enforced)
          continue
          ;;
        attached | attaching | updating)
          security_attachment_wait_needed=true
          continue
          ;;
        esac
      fi
    fi

    ids=$(jq --argjson id "${id}" '. + [$id]' <<<"${ids}")
    security_attachment_wait_needed=true
  done

  security_attach_payload=$(mktemp)
  jq -n --argjson ids "${ids}" \
    '{scope: "selected", selected_repository_ids: $ids}' \
    >"${security_attach_payload}"
  security_attachment_count=$(jq '.selected_repository_ids | length' \
    "${security_attach_payload}")
}

converge_security_configuration_attachments() {
  local advanced=$1
  local expected_id=$2
  local cohort=$3

  make_security_attach_payload "${advanced}" "${expected_id}"
  temporary_files+=("${security_attach_payload}")

  if ((security_attachment_count > 0)); then
    run_api POST \
      "orgs/${organization}/code-security/configurations/${expected_id}/attach" \
      "${security_attach_payload}"
  elif ! ${security_attachment_wait_needed}; then
    echo "KEEP /orgs/${organization}/code-security/configurations/${expected_id}/attach already covers ${cohort} repositories"
  fi

  if ${security_attachment_wait_needed}; then
    wait_for_code_security_configuration "${advanced}" "${expected_id}"
  fi
}

wait_for_code_security_configuration() {
  local advanced=$1
  local expected_id=$2
  local repository response status id attempt
  local -r maximum_attempts=30

  for repository in "${active_repositories[@]}"; do
    if repository_uses_advanced_codeql "${repository}"; then
      [[ ${advanced} == true ]] || continue
    else
      [[ ${advanced} == false ]] || continue
    fi

    if ! ${apply}; then
      echo "PLAN WAIT /repos/${organization}/${repository}/code-security-configuration => ${expected_id}"
      continue
    fi

    for ((attempt = 1; attempt <= maximum_attempts; attempt++)); do
      if response=$(github_api \
        "repos/${organization}/${repository}/code-security-configuration" \
        2>/dev/null); then
        status=$(jq -r '.status // empty' <<<"${response}")
        id=$(jq -r '.configuration.id // empty' <<<"${response}")
        # "attached" is active but not the enforced terminal state required
        # by both managed configurations.
        if [[ ${id} == "${expected_id}" ]] &&
          [[ ${status} == enforced ]]; then
          break
        fi
        if [[ ${id} == "${expected_id}" ]] &&
          [[ ${status} == failed ]]; then
          echo "error: security configuration attachment failed for ${organization}/${repository}" >&2
          exit 1
        fi
      fi

      if ((attempt == maximum_attempts)); then
        echo "error: timed out waiting for security configuration ${expected_id} on ${organization}/${repository}" >&2
        exit 1
      fi
      sleep 2
    done
  done
}

converge_codeql_default_setup() {
  local repository input desired_state desired_query current required_languages
  local current_state current_query language_match

  for repository in "${active_repositories[@]}"; do
    input=${root}/config/codeql-default-setup.json
    if repository_uses_advanced_codeql "${repository}"; then
      input=${root}/config/codeql-default-setup-advanced.json
    fi
    required_languages=$(jq -c --arg repository "${repository}" \
      '.codeql_required_languages[$repository] // []' "${security_merge_config}")
    desired_state=$(jq -r '.state' "${input}")
    desired_query=$(jq -r '.query_suite // empty' "${input}")
    current='{}'
    if current=$(github_api \
      "repos/${organization}/${repository}/code-scanning/default-setup" \
      2>/dev/null); then
      current_state=$(jq -r '.state // empty' <<<"${current}")
      if ! jq -e '
        (.state == "not-configured" and .languages == null) or
        (.languages | type == "array" and all(.[]; type == "string" and length > 0))
      ' <<<"${current}" >/dev/null; then
        echo "error: invalid existing CodeQL languages for ${repository}" >&2
        return 1
      fi
      current_query=$(jq -r '.query_suite // empty' <<<"${current}")
      language_match=$(jq --argjson required "${required_languages}" \
        '($required - (.languages // [])) == []' <<<"${current}")
      if [[ ${current_state} == "${desired_state}" && ${language_match} == true ]] &&
        { [[ -z ${desired_query} ]] || [[ ${current_query} == "${desired_query}" ]]; }; then
        echo "KEEP /repos/${organization}/${repository}/code-scanning/default-setup is ${desired_state}"
        continue
      fi
    else
      # A failed read is unknown state, including repositories with no policy
      # language minimum or with advanced setup. Never publish from that state.
      echo "error: cannot read existing CodeQL languages for ${repository}" >&2
      return 1
    fi
    if [[ ${required_languages} != '[]' ]]; then
      local language_payload
      language_payload=$(mktemp)
      temporary_files+=("${language_payload}")
      jq --argjson current "${current}" --argjson required "${required_languages}" \
        '.languages = (($current.languages // []) + $required |
          map(if . == "javascript" or . == "typescript" then
            "javascript-typescript" else . end) | unique)' \
        "${input}" >"${language_payload}"
      input=${language_payload}
    fi
    run_api PATCH \
      "repos/${organization}/${repository}/code-scanning/default-setup" \
      "${input}"
  done
}

security_ruleset_matches() {
  local template=$1 current=$2
  jq -e --slurpfile desired "${template}" '
    # GitHub returns the organization-owner sentinel with a null ID.
    def normalize:
      .bypass_actors |= (map(
        if .actor_type == "OrganizationAdmin" and .actor_id == null then
          .actor_id = 1
        else . end) | sort_by(.actor_type, .actor_id, .bypass_mode)) |
      # GitHub expands this omitted request parameter to false. Keep true,
      # null and unknown parameters visible so modified gates are not retired.
      .rules |= map(if .type == "required_status_checks" then
          .parameters |= (
            if .do_not_enforce_on_create == false then del(.do_not_enforce_on_create) else . end |
            .required_status_checks |= sort_by(.context, .integration_id))
        else . end);
    normalize as $current |
    all($desired[0] | normalize | to_entries[]; $current[.key] == .value)
  ' <<<"${current}" >/dev/null
}

security_ruleset_restoration_allowed() {
  local repository=$1 id=$2 template=$3 current=$4
  jq -e --argjson id "${id}" --slurpfile desired "${template}" \
    --arg source "${organization}/${repository}" '
    .id == $id and .name == $desired[0].name and
    .source_type == "Repository" and .source == $source and
    (.enforcement | IN("active", "disabled", "evaluate"))
  ' <<<"${current}" >/dev/null &&
    security_ruleset_matches "${template}" "$(jq --slurpfile desired "${template}" '
      .enforcement = $desired[0].enforcement |
      .conditions.ref_name.include = $desired[0].conditions.ref_name.include |
      .conditions.ref_name.exclude = $desired[0].conditions.ref_name.exclude
    ' <<<"${current}")"
}

security_gate_applies_to_default_branch() {
  local repository=$1 kind=$2 id=$3 metadata branch effective
  metadata=$(github_api "repos/${organization}/${repository}") || return 1
  jq -e --argjson id "${active_repository_ids["${repository}"]}" '
    .id == $id and .archived == false and
    (.default_branch | type == "string" and length > 0)
  ' <<<"${metadata}" >/dev/null || return 1
  branch=$(jq -r '.default_branch | @uri' <<<"${metadata}")
  effective=$(github_api "repos/${organization}/${repository}/rules/branches/${branch}") || return 1
  jq -e --argjson id "${id}" --arg kind "${kind}" '
    any(.[]; .ruleset_id == $id and
      if $kind == "code_scanning" then
        .type == "code_scanning" and
        any(.parameters.code_scanning_tools[]?; .tool == "CodeQL")
      else
        .type == "required_status_checks" and
        any(.parameters.required_status_checks[]?;
          .context == "Dependency review" and .integration_id == 15368)
      end)
  ' <<<"${effective}" >/dev/null || return 1
  printf '%s\n' "${branch}"
}

owned_security_ruleset_matches() {
  local repository=$1 id=$2 template=$3 current=$4
  jq -e --argjson id "${id}" --arg source "${organization}/${repository}" '
    .id == $id and .source_type == "Repository" and .source == $source
  ' <<<"${current}" >/dev/null && security_ruleset_matches "${template}" "${current}"
}

delete_removed_security_merge_rulesets() {
  local repository kind template name existing rule id current metadata
  for repository in "${active_repositories[@]}"; do
    [[ -v active_repository_ids["${repository}"] ]] || continue
    # The complete live inventory was checked against governed repositories
    # before this function; archived repositories never enter this collection.
    for kind in code_scanning dependency_review; do
      if jq -e --arg kind "${kind}" --arg repository "${repository}" \
        '.[$kind] | index($repository) != null' "${security_merge_config}" >/dev/null; then
        continue
      fi
      if [[ ${kind} == code_scanning ]]; then
        template=${root}/config/rulesets/code-scanning.json
      else
        template=${root}/config/rulesets/dependency-review.json
      fi
      name=$(jq -r '.name' "${template}")
      existing=$(list_rulesets "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
      while IFS= read -r rule; do
        id=$(jq -r '.id' <<<"${rule}")
        current=$(github_api "repos/${organization}/${repository}/rulesets/${id}") || return 1
        if owned_security_ruleset_matches "${repository}" "${id}" "${template}" "${current}"; then
          metadata=$(github_api "repos/${organization}/${repository}") || return 1
          if jq -e --argjson id "${active_repository_ids["${repository}"]}" \
            --arg full_name "${organization}/${repository}" '
            .id == $id and .full_name == $full_name and .archived == false
          ' <<<"${metadata}" >/dev/null; then
            current=$(github_api "repos/${organization}/${repository}/rulesets/${id}") || {
              echo "error: security gate final retirement read failed; retained: ${repository} ${name}" >&2
              return 1
            }
            if ! owned_security_ruleset_matches "${repository}" "${id}" "${template}" "${current}"; then
              echo "SKIP ${organization}/${repository} ${name}: rule changed during retirement preflight; retained"
              continue
            fi
            run_api DELETE "repos/${organization}/${repository}/rulesets/${id}" || return 1
          else
            echo "SKIP ${organization}/${repository} ${name}: repository identity or archive state changed; retained"
          fi
        else
          echo "SKIP ${organization}/${repository} ${name}: unrecognized ownership or payload; retained"
        fi
      done < <(jq -c --arg name "${name}" '.[] | select(.name == $name)' <<<"${existing}")
    done
  done
}

# These repository rules remain repository-owned even in organization scope:
# GitHub Team does not support organization-level code-scanning rules.
publish_security_merge_rulesets() {
  local repository kind template name existing id current reason status readiness_mode phase metadata effective_branch proven_current
  delete_removed_security_merge_rulesets || return 1
  for kind in code_scanning dependency_review; do
    if [[ ${kind} == code_scanning ]]; then
      template=${root}/config/rulesets/code-scanning.json
      readiness_mode=codeql
    else
      template=${root}/config/rulesets/dependency-review.json
      readiness_mode=dependency
    fi
    name=$(jq -r '.name' "${template}")
    while IFS= read -r repository; do
      if [[ ! -v active_repository_ids["${repository}"] ]]; then
        echo "SKIP ${organization}/${repository} is not active; ${name}"
        continue
      fi
      phase=$(jq -er --arg kind "${kind}" --arg repository "${repository}" \
        '.activation[$kind][$repository] | select(. == "pending" or . == "enforced")' \
        "${security_merge_config}") || {
        echo "error: invalid security gate activation intent: ${repository} ${kind}" >&2
        return 1
      }
      existing=$(list_rulesets \
        "repos/${organization}/${repository}/rulesets?includes_parents=false") || return 1
      if ! jq -e --arg name "${name}" \
        '[.[] | select(.name == $name)] | length <= 1' <<<"${existing}" >/dev/null; then
        echo "error: ambiguous managed ruleset ${name} on ${repository}" >&2
        return 1
      fi
      id=$(jq -r --arg name "${name}" \
        '.[] | select(.name == $name) | .id' <<<"${existing}")
      current='{}'
      if [[ -n ${id} ]]; then
        current=$(github_api "repos/${organization}/${repository}/rulesets/${id}")
        if ! security_ruleset_restoration_allowed "${repository}" "${id}" "${template}" "${current}"; then
          echo "error: security gate ownership or managed rule identity changed; retained: ${repository} ${name}" >&2
          return 1
        fi
        if security_ruleset_matches "${template}" "${current}"; then
          echo "KEEP /repos/${organization}/${repository}/rulesets/${id} ${name}"
          continue
        fi
      fi
      # Pending qualification cannot create protection before reviewed intent is
      # persisted. Existing effective gates still survive producer failures.
      effective_branch=
      proven_current=${current}
      if [[ ${phase} == pending ]] && { [[ -z ${id} ]] ||
        ! effective_branch=$(security_gate_applies_to_default_branch "${repository}" "${kind}" "${id}"); }; then
        status=0
        reason=$("${root}/bin/security-readiness" "${readiness_mode}" \
          "${organization}/${repository}") || status=$?
        if ((status == 0)); then
          echo "READY ${organization}/${repository} ${name}: promote reviewed activation intent before installation"
        else
          echo "PENDING ${organization}/${repository} ${name}: ${reason}"
        fi
        continue
      fi
      # Enforced source is durable intent, not a claim about current producer
      # health. Restore it only on the same active repository and owned gate.
      metadata=$(github_api "repos/${organization}/${repository}") || return 1
      if ! jq -e --argjson id "${active_repository_ids["${repository}"]}" \
        --arg name "${organization}/${repository}" '
        .id == $id and .full_name == $name and .archived == false and
        (.default_branch | type == "string" and length > 0)
      ' <<<"${metadata}" >/dev/null; then
        echo "error: security gate repository identity or archive state changed: ${repository}" >&2
        return 1
      fi
      if [[ ${phase} == pending ]] &&
        [[ $(jq -r '.default_branch | @uri' <<<"${metadata}") != "${effective_branch}" ]]; then
        echo "error: default branch changed after existing security gate proof; retained: ${repository} ${name}" >&2
        return 1
      fi
      if [[ -n ${id} ]]; then
        # Re-read after producer and repository checks: a concurrent policy edit
        # must not be overwritten with the earlier restoration decision.
        current=$(github_api "repos/${organization}/${repository}/rulesets/${id}") || {
          echo "error: security gate final read failed; retained: ${repository} ${name}" >&2
          return 1
        }
        if ! security_ruleset_restoration_allowed "${repository}" "${id}" "${template}" "${current}"; then
          echo "error: security gate changed during restoration preflight; retained: ${repository} ${name}" >&2
          return 1
        fi
        # Pending intent may preserve a proven effective gate, but cannot
        # restore protection revoked after that proof. Only enforced intent
        # authorizes enforcement or ref-scope restoration without qualification.
        if [[ ${phase} == pending ]] && ! jq -e --argjson proven "${proven_current}" '
          def protection:
            {enforcement, ref_name: (.conditions.ref_name |
              .include |= sort | .exclude |= sort)};
          protection == ($proven | protection)
        ' <<<"${current}" >/dev/null; then
          echo "error: existing security gate protection changed after effective proof; retained: ${repository} ${name}" >&2
          return 1
        fi
        if security_ruleset_matches "${template}" "${current}"; then
          echo "KEEP /repos/${organization}/${repository}/rulesets/${id} ${name}"
          continue
        fi
        run_api PUT "repos/${organization}/${repository}/rulesets/${id}" "${template}"
      else
        run_api POST "repos/${organization}/${repository}/rulesets" "${template}"
      fi
    done < <(jq -r --arg kind "${kind}" '.[$kind][]' "${security_merge_config}")
  done
}

validate_sha_canary_target() {
  local canary=$1 owner repository number metadata
  IFS=/ read -r owner repository number <<<"${canary}"
  if [[ ${owner} != "${organization}" || ! ${number} =~ ^[1-9][0-9]*$ ||
    ! ${repository} =~ ^[A-Za-z0-9_.-]+$ ]] ||
    [[ ! -v active_repository_ids["${repository}"] ]]; then
    echo "error: SHA canary must identify an active governed repository in ${organization}" >&2
    return 1
  fi
  metadata=$(github_api "repos/${organization}/${repository}")
  if ! jq -e --argjson id "${active_repository_ids["${repository}"]}" \
    --arg name "${organization}/${repository}" '
      .id == $id and .full_name == $name and .archived == false
    ' <<<"${metadata}" >/dev/null; then
    echo "error: SHA canary repository identity or archive state changed" >&2
    return 1
  fi
}

converge_actions_permissions() {
  local current selected input reason phase canary staging_needed=false
  local permissions_filter='type == "object" and
    (.enabled_repositories | IN("all", "none", "selected")) and
    (.allowed_actions | IN("all", "local_only", "selected")) and
    (.sha_pinning_required == null or (.sha_pinning_required | type == "boolean"))'
  current=$(github_api "orgs/${organization}/actions/permissions") || return 1
  if ! jq -e "${permissions_filter}" <<<"${current}" >/dev/null; then
    echo "error: cannot read current organization Actions permissions" >&2
    return 1
  fi
  phase=$(jq -r '.phase' "${root}/config/actions-sha-pinning.json")
  canary=$(jq -r '.canary // empty' "${root}/config/actions-sha-pinning.json")
  if [[ ${phase} == pending && -n ${sha_pinning_canary} ]]; then
    validate_sha_canary_target "${sha_pinning_canary}" || return 1
  elif [[ ${phase} == enforced ]] &&
    ! jq -e '.sha_pinning_required == true' <<<"${current}" >/dev/null; then
    validate_sha_canary_target "${canary}" || return 1
  fi

  # GitHub requires selected mode before its selected-actions endpoint can be
  # updated. Stage both conservative controls before proving SHA compatibility.
  # Omit SHA entirely: this preserves an existing value without enabling it
  # from a stale read if another actor changes the field during staging.
  input=$(mktemp)
  temporary_files+=("${input}")
  jq 'del(.sha_pinning_required)' "${root}/config/actions-permissions.json" >"${input}"
  if jq -e --slurpfile desired "${input}" '
    . as $current | all($desired[0] | to_entries[]; $current[.key] == .value)
  ' <<<"${current}" >/dev/null; then
    echo "KEEP /orgs/${organization}/actions/permissions"
  else
    staging_needed=true
    run_api PUT "orgs/${organization}/actions/permissions" "${input}" || return 1
  fi
  # This endpoint may require selected mode. A dry run with a mode change
  # can plan its update, but cannot claim to have read the staged live policy.
  if ! ${apply} && [[ $(jq -r '.allowed_actions' <<<"${current}") != selected ]]; then
    selected=null
  else
    selected=$(github_api "orgs/${organization}/actions/permissions/selected-actions") || return 1
    if ! jq -e '
      (.github_owned_allowed | type == "boolean") and
      (.verified_allowed | type == "boolean") and
      (.patterns_allowed | type == "array" and all(.[]; type == "string"))
    ' <<<"${selected}" >/dev/null; then
      echo "error: cannot read current selected Actions policy" >&2
      return 1
    fi
  fi
  if jq -e --slurpfile desired "${root}/config/actions-selected.json" '
    .github_owned_allowed == $desired[0].github_owned_allowed and
    .verified_allowed == $desired[0].verified_allowed and
    (.patterns_allowed | sort) == ($desired[0].patterns_allowed | sort)
  ' <<<"${selected}" >/dev/null; then
    echo "KEEP /orgs/${organization}/actions/permissions/selected-actions"
  else
    staging_needed=true
    run_api PUT "orgs/${organization}/actions/permissions/selected-actions" \
      "${root}/config/actions-selected.json" || return 1
  fi
  if ${apply}; then
    # Base the SHA decision on live post-staging state: another writer may
    # disable it while conservative mode or pattern updates are in flight.
    current=$(github_api "orgs/${organization}/actions/permissions") || return 1
    if ! jq -e "${permissions_filter}" <<<"${current}" >/dev/null ||
      ! jq -e --slurpfile desired "${input}" '
        . as $current | all($desired[0] | to_entries[]; $current[.key] == .value)
      ' <<<"${current}" >/dev/null; then
      echo "error: organization Actions permissions unreadable or changed during staging" >&2
      return 1
    fi
  fi
  # An explicitly requested pending-phase probe is read-only and independent
  # of whether SHA pinning is already enabled. Do not let preservation skip it.
  if [[ ${phase} == pending && -n ${sha_pinning_canary} ]]; then
    validate_sha_canary_target "${sha_pinning_canary}" || return 1
    if reason=$("${root}/bin/security-readiness" sha "${sha_pinning_canary}"); then
      echo "READY canary evidence: ${reason}; source rollout phase remains pending"
    else
      echo "PENDING canary evidence: ${reason}"
    fi
  fi
  if jq -e '.sha_pinning_required == true' <<<"${current}" >/dev/null; then
    return 0
  fi
  if [[ ${phase} == enforced ]]; then
    if ! ${apply} && ${staging_needed}; then
      echo "PLAN SHA pinning proof and restoration after Actions policy staging is applied"
      return 0
    fi
    validate_sha_canary_target "${canary}" || return 1
    if ! reason=$("${root}/bin/security-readiness" sha "${canary}"); then
      echo "error: enforced SHA pinning cannot be restored: ${reason}" >&2
      return 1
    fi
    echo "READY enforced SHA pinning: ${reason}"
    run_api PUT "orgs/${organization}/actions/permissions" \
      "${root}/config/actions-permissions.json" || return 1
  else
    echo "PENDING SHA pinning: promote the reviewed source rollout phase and accepted canary after readiness"
  fi
}

converge_repository_workflow_permissions() {
  local repository current
  for repository in "${active_repositories[@]}"; do
    [[ -v active_repository_ids["${repository}"] ]] || continue
    current=$(github_api "repos/${organization}/${repository}/actions/permissions/workflow")
    if ! jq -e 'type == "object" and
      (.default_workflow_permissions | IN("read", "write")) and
      (.can_approve_pull_request_reviews | type == "boolean")
    ' <<<"${current}" >/dev/null; then
      echo "error: cannot read repository workflow permissions: ${repository}" >&2
      return 1
    fi
    if jq -e --slurpfile desired "${root}/config/actions-workflow.json" '
      . as $current | all($desired[0] | to_entries[]; $current[.key] == .value)
    ' <<<"${current}" >/dev/null; then
      echo "KEEP /repos/${organization}/${repository}/actions/permissions/workflow"
    else
      run_api PUT "repos/${organization}/${repository}/actions/permissions/workflow" \
        "${root}/config/actions-workflow.json"
    fi
  done
}

publish_organization_security() {
  local advanced_id baseline_id defaults_payload defaults
  local advanced_repository_count baseline_repository_count

  # Move governed advanced-setup repositories first. This prevents a baseline
  # update from temporarily re-enabling default setup during later publishes.
  upsert_code_security_configuration \
    "${root}/config/code-security-advanced.json" \
    '{advanced-codeql-configuration-id}'
  advanced_id=${upserted_code_security_configuration_id}
  advanced_repository_count=$(jq '.repositories | length' \
    "${codeql_advanced_config}")
  if ((advanced_repository_count > 0)); then
    converge_security_configuration_attachments \
      true "${advanced_id}" "${advanced_repository_count}"
  else
    echo "SKIP advanced CodeQL attachment: inventory is empty"
  fi

  upsert_code_security_configuration \
    "${root}/config/code-security.json" \
    '{baseline-configuration-id}'
  baseline_id=${upserted_code_security_configuration_id}

  defaults_payload=$(mktemp)
  temporary_files+=("${defaults_payload}")
  jq -n '{default_for_new_repos: "all"}' >"${defaults_payload}"
  defaults=$(github_api \
    "orgs/${organization}/code-security/configurations/defaults")
  if jq -e --arg id "${baseline_id}" '
    any(
      .[];
      (
        (
          .configuration.id // .configuration.value.id // null |
          tostring
        ) == $id
      ) and
      .default_for_new_repos == "all"
    )
  ' <<<"${defaults}" >/dev/null; then
    echo "KEEP /orgs/${organization}/code-security/configurations/${baseline_id}/defaults is all"
  else
    run_api PUT \
      "orgs/${organization}/code-security/configurations/${baseline_id}/defaults" \
      "${defaults_payload}"
  fi

  baseline_repository_count=$((${#active_repositories[@]} - \
    advanced_repository_count))
  converge_security_configuration_attachments \
    false "${baseline_id}" "${baseline_repository_count}"

  converge_codeql_default_setup
}

publish_repository_security() {
  local repository

  for repository in "${active_repositories[@]}"; do
    run_api PATCH "repos/${organization}/${repository}" \
      "${root}/config/repository-security.json"
    run_api PUT "repos/${organization}/${repository}/vulnerability-alerts"
    run_api PUT "repos/${organization}/${repository}/automated-security-fixes"
    run_api PUT "repos/${organization}/${repository}/private-vulnerability-reporting"
  done

  converge_codeql_default_setup
}

current_immutable_release_payload() {
  local response mode selected_repository_ids

  if ! response=$(github_api \
    "orgs/${organization}/settings/immutable-releases"); then
    echo "error: failed to read the organization immutable-release policy" >&2
    return 1
  fi
  mode=$(jq -r '.enforced_repositories // empty' <<<"${response}")
  case ${mode} in
  all | none)
    jq -cn --arg mode "${mode}" '{enforced_repositories: $mode}'
    ;;
  selected)
    if ! selected_repository_ids=$(
      github_api --paginate \
        "orgs/${organization}/settings/immutable-releases/repositories?per_page=100" \
        --jq '.repositories[].id' | jq -cs 'map(tonumber) | sort | unique'
    ); then
      echo "error: failed to read repositories selected for immutable releases" >&2
      return 1
    fi
    jq -cn \
      --argjson selected_repository_ids "${selected_repository_ids}" \
      '{
        enforced_repositories: "selected",
        selected_repository_ids: $selected_repository_ids
      }'
    ;;
  *)
    echo "error: unsupported immutable-release policy mode: ${mode:-missing}" >&2
    return 1
    ;;
  esac
}

immutable_release_policy_matches() {
  local expected=$1
  local verify_owner_enforcement=$2
  local current repository response

  if ! current=$(current_immutable_release_payload); then
    return 1
  fi
  if ! jq -e --argjson expected "${expected}" \
    '. == $expected' <<<"${current}" >/dev/null; then
    return 1
  fi

  if [[ ${verify_owner_enforcement} != true ]]; then
    return 0
  fi
  while IFS= read -r repository; do
    if ! response=$(github_api \
      "repos/${organization}/${repository}/immutable-releases"); then
      return 1
    fi
    if ! jq -e \
      '.enabled == true and .enforced_by_owner == true' \
      <<<"${response}" >/dev/null; then
      return 1
    fi
  done < <(jq -r '.repositories[].name' "${immutable_releases_config}")
}

write_immutable_release_payload() {
  local payload=$1
  local output

  output=$(mktemp)
  jq . <<<"${payload}" >"${output}"
  printf '%s\n' "${output}"
}

rollback_immutable_release_policy() {
  local snapshot=$1
  local input

  input=$(write_immutable_release_payload "${snapshot}")
  temporary_files+=("${input}")
  echo "ROLLBACK PUT /orgs/${organization}/settings/immutable-releases <= ${snapshot}" >&2
  if ! github_api --method PUT \
    "orgs/${organization}/settings/immutable-releases" \
    --input "${input}" >/dev/null; then
    echo "error: immutable-release policy rollback request failed" >&2
    return 1
  fi
  if ! immutable_release_policy_matches "${snapshot}" false; then
    echo "error: immutable-release policy rollback verification failed" >&2
    return 1
  fi
  echo "ROLLBACK verified the previous immutable-release policy" >&2
}

converge_immutable_release_policy() {
  local desired snapshot input

  desired=$(jq -c '
    {
      enforced_repositories,
      selected_repository_ids: ([.repositories[].id] | sort)
    }
  ' "${immutable_releases_config}")
  if immutable_release_policy_matches "${desired}" true; then
    echo "KEEP /orgs/${organization}/settings/immutable-releases is ${desired}"
    return 0
  fi

  if ! snapshot=$(current_immutable_release_payload); then
    return 1
  fi
  if ! ${apply}; then
    echo "PLAN PUT /orgs/${organization}/settings/immutable-releases <= ${desired}"
    while IFS= read -r repository; do
      echo "PLAN VERIFY /repos/${organization}/${repository}/immutable-releases" \
        "=> enabled=true,enforced_by_owner=true"
    done < <(jq -r '.repositories[].name' "${immutable_releases_config}")
    return 0
  fi

  input=$(write_immutable_release_payload "${desired}")
  temporary_files+=("${input}")
  if github_api --method PUT \
    "orgs/${organization}/settings/immutable-releases" \
    --input "${input}" >/dev/null &&
    immutable_release_policy_matches "${desired}" true; then
    echo "APPLY /orgs/${organization}/settings/immutable-releases <= ${desired}"
    return 0
  fi

  echo "error: immutable-release policy apply or verification failed" >&2
  if ! rollback_immutable_release_policy "${snapshot}"; then
    echo "error: previous immutable-release policy could not be restored" >&2
  fi
  return 1
}

preflight_new_crate_immutable_selection() {
  local snapshot additions repository
  ${apply} || return 0
  snapshot=$(current_immutable_release_payload)
  additions=$(jq -cn --argjson current "${snapshot}" \
    --slurpfile desired "${immutable_releases_config}" '
    if $current.enforced_repositories == "all" then []
    elif $current.enforced_repositories == "none" then [$desired[0].repositories[].id]
    else [$desired[0].repositories[].id] - $current.selected_repository_ids end
  ')
  while IFS= read -r repository; do
    # These are the newly introduced library producers; Classic retains its
    # existing separately qualified release policy. Missing manual records fail
    # the scoped verifier rather than silently skipping qualification.
    "${root}/bin/verify-manual-settings" --crate-publication-setup "${organization}/${repository}"
  done < <(jq -r --argjson additions "${additions}" '
    .repositories[] | select(.name | IN("protocol", "renderer", "content-toolkit")) |
    select(.id as $id | $additions | index($id) != null) | .name
  ' "${immutable_releases_config}")
  if [[ $(current_immutable_release_payload) != "${snapshot}" ]]; then
    echo "error: immutable-release policy changed during initial qualification; no broad apply performed" >&2
    exit 1
  fi
}

organization_metadata=$(github_api "orgs/${organization}")
if ! jq -e 'type == "object" and (.plan.name | type == "string")' \
  <<<"${organization_metadata}" >/dev/null; then
  echo "error: GitHub returned invalid organization metadata" >&2
  exit 1
fi
organization_plan=$(jq -r '.plan.name' <<<"${organization_metadata}")
if [[ ${policy_scope} == auto ]]; then
  case ${organization_plan} in
  team | enterprise) policy_scope=organization ;;
  *) policy_scope=repository ;;
  esac
fi

echo "Organization: ${organization}"
echo "Plan: ${organization_plan}"
echo "Policy scope: ${policy_scope}"
${apply} && echo "Mode: apply" || echo "Mode: plan"

declare -a active_repositories=()
declare -A active_repository_ids=()
while IFS=$'\t' read -r \
  repository id private visibility disabled fork has_issues has_projects has_wiki; do
  if [[ ! ${id} =~ ^[0-9]+$ ]]; then
    echo "error: invalid repository id for ${repository}: ${id}" >&2
    exit 1
  fi
  if is_temporary_security_advisory_repository \
    "${repository}" "${private}" "${visibility}" "${disabled}" "${fork}" \
    "${has_issues}" "${has_projects}" "${has_wiki}"; then
    echo "SKIP ${organization}/${repository} is a temporary security-advisory workspace"
    continue
  fi
  active_repositories+=("${repository}")
  active_repository_ids["${repository}"]=${id}
done < <(
  github_api --paginate "orgs/${organization}/repos?per_page=100&type=all" \
    --jq '
      .[] |
      select(.archived == false) |
      [
        .name,
        .id,
        .private,
        .visibility,
        .disabled,
        .fork,
        .has_issues,
        .has_projects,
        .has_wiki
      ] |
      @tsv
    '
)

declare -A governed_active_repositories=()
while IFS= read -r repository; do
  governed_active_repositories["${repository}"]=true
done < <(
  jq -r '[".github"] + .pull_request_gate | .[]' "${repositories_config}"
)

while IFS= read -r repository; do
  if [[ ! -v governed_active_repositories["${repository}"] ]]; then
    echo "error: live active repository is not in the governance inventory: ${organization}/${repository}" >&2
    exit 1
  fi
done < <(printf '%s\n' "${active_repositories[@]}" | sort)

while IFS= read -r repository; do
  if [[ ! -v active_repository_ids["${repository}"] ]]; then
    echo "error: advanced CodeQL inventory repository is not active: ${repository}" >&2
    exit 1
  fi
done < <(jq -r '.repositories[]' "${codeql_advanced_config}")

while IFS=$'\t' read -r repository expected_id; do
  if [[ ! -v active_repository_ids["${repository}"] ]]; then
    echo "error: immutable-release inventory repository is not active: ${repository}" >&2
    exit 1
  fi
  if [[ ${active_repository_ids["${repository}"]} != "${expected_id}" ]]; then
    echo "error: immutable-release inventory id for ${repository} is" \
      "${expected_id}, but GitHub reports" \
      "${active_repository_ids["${repository}"]}" >&2
    exit 1
  fi
done < <(
  jq -r '.repositories[] | [.name, .id] | @tsv' \
    "${immutable_releases_config}"
)

preflight_new_crate_immutable_selection
converge_immutable_release_policy

converge_organization_settings "${organization_metadata}"
converge_actions_permissions
run_api PUT "orgs/${organization}/actions/permissions/workflow" \
  "${root}/config/actions-workflow.json"

for repository in "${active_repositories[@]}"; do
  run_api PATCH "repos/${organization}/${repository}" \
    "${root}/config/repository-defaults.json"
done

converge_repository_workflow_permissions

if [[ ${policy_scope} == organization ]]; then
  publish_organization_rulesets
  publish_organization_security
else
  publish_repository_rulesets
  publish_repository_security
fi

publish_security_merge_rulesets

while IFS= read -r repository; do
  if ! repository_archived=$(
    github_api "repos/${organization}/${repository}" --jq '.archived' 2>/dev/null
  ); then
    echo "SKIP ${organization}/${repository} does not exist"
    continue
  fi

  if [[ ${repository_archived} == true ]]; then
    echo "SKIP ${organization}/${repository} is already archived"
    continue
  fi

  archive_payload=$(mktemp)
  temporary_files+=("${archive_payload}")
  jq -n '{archived: true}' >"${archive_payload}"
  run_api PATCH "repos/${organization}/${repository}" "${archive_payload}"
done < <(jq -r '.archive[]' "${repositories_config}")

if [[ $(jq -r '.members_can_create_teams' <<<"${organization_metadata}") != false ]]; then
  echo "MANUAL members can still create teams; disable this in Member privileges."
fi
while IFS= read -r external_app; do
  app_slug=$(jq -r '.app_slug' <<<"${external_app}")
  installation_id=$(jq -r '.installation_id' <<<"${external_app}")
  repositories=$(jq -r '[.repositories[].repository] | join(", ")' <<<"${external_app}")
  echo "MANUAL ${app_slug} installation ${installation_id} selected repositories: ${repositories}; publisher does not apply"
done < <(jq -c '.external_provider_apps[]' "${root}/config/manual-settings.json")
while IFS= read -r crate_record; do
  repository=$(jq -r '.repository' <<<"${crate_record}")
  crate=$(jq -r '.crates | join(",")' <<<"${crate_record}")
  state=$(jq -r '"source=\(.source_state), environment=\(.environment_state), registration=\(.publisher_registration.state)"' <<<"${crate_record}")
  echo "MANUAL ${repository} crates.io ${crate}: ${state}; reviewed source/version merge, automatic crates-io-release environment (zero reviewers/wait), and Trusted Publisher owner setup; publisher does not apply"
done < <(jq -c '.crates_io_trusted_publishing[]' "${root}/config/manual-settings.json")
while IFS= read -r package_record; do
  repository=$(jq -r '.actions_repository' <<<"${package_record}")
  package_name=$(jq -r '.package_name' <<<"${package_record}")
  grant_state=$(jq -r '.grant_state // "manual-owner-ui"' <<<"${package_record}")
  echo "MANUAL ${repository} read-only package Actions access to ${package_name}: ${grant_state}; publisher never provisions grants"
done < <(jq -c '.github_packages_actions_access[]' "${root}/config/manual-settings.json")
app_state=$(jq -r '.crate_dependency_update_app | "identity=\(.status), credential_names=\(.credential_state), workflow=\(.workflow_activation.state)"' "${root}/config/manual-settings.json")
echo "MANUAL atrinik-crate-dependency-update ${app_state} selected client/editor App and credential slots; publisher does not apply"
echo "Manual confirmation required for config/manual-settings.json."
