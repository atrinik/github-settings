#!/usr/bin/env bash

set -euo pipefail

organization=${ATRINIK_ORGANIZATION:-atrinik}
policy_scope=${ATRINIK_POLICY_SCOPE:-auto}
api_version=2026-03-10
apply=false

case "${1:-}" in
"") ;;
--apply) apply=true ;;
*)
  echo "usage: $0 [--apply]" >&2
  exit 2
  ;;
esac

case ${policy_scope} in
auto | organization | repository) ;;
*)
  echo "error: ATRINIK_POLICY_SCOPE must be auto, organization, or repository" >&2
  exit 2
  ;;
esac

for command in gh git jq; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
organization_config=${root}/config/organization.json
repositories_config=${root}/config/repositories.json
advisory_merge_windows_config=${root}/config/advisory-merge-windows.json
codeql_advanced_config=${root}/config/codeql-advanced-setup.json
immutable_releases_config=${root}/config/immutable-releases.json
temporary_files=()
trap 'rm -f "${temporary_files[@]}"' EXIT

"${root}/bin/validate" >/dev/null

github_api() {
  gh api -H "X-GitHub-Api-Version: ${api_version}" "$@"
}

run_api() {
  local method=$1
  local endpoint=$2
  local input=${3:-}

  if ${apply}; then
    if [[ -n ${input} ]]; then
      github_api --method "${method}" "${endpoint}" --input "${input}" >/dev/null
    else
      github_api --method "${method}" "${endpoint}" >/dev/null
    fi
  elif [[ -n ${input} ]]; then
    echo "PLAN ${method} /${endpoint} <= ${input#"${root}/"}"
  else
    echo "PLAN ${method} /${endpoint}"
  fi
}

converge_organization_settings() {
  local current=$1
  local desired

  desired=$(jq -c . "${organization_config}")
  if jq -e --argjson desired "${desired}" '
    . as $current |
    all($desired | to_entries[]; $current[.key] == .value)
  ' <<<"${current}" >/dev/null; then
    echo "KEEP /orgs/${organization} metadata and repository defaults"
    return
  fi

  jq -r \
    --arg endpoint "/orgs/${organization}" \
    --argjson desired "${desired}" '
      . as $current |
      $desired | to_entries[] |
      select($current[.key] != .value) |
      "DRIFT \($endpoint) \(.key) live=\($current[.key] | tojson) desired=\(.value | tojson)"
    ' <<<"${current}"
  run_api PATCH "orgs/${organization}" "${organization_config}"
}

repository_uses_advanced_codeql() {
  local repository=$1

  jq -e --arg repository "${repository}" \
    '(.repositories | index($repository)) != null' \
    "${codeql_advanced_config}" >/dev/null
}

repository_has_advisory_merge_window() {
  local repository=$1

  jq -e --arg repository "${repository}" \
    '(.repositories | index($repository)) != null' \
    "${advisory_merge_windows_config}" >/dev/null
}

is_temporary_security_advisory_repository() {
  local repository=$1
  local private=$2
  local visibility=$3
  local disabled=$4
  local fork=$5
  local has_issues=$6
  local has_projects=$7
  local has_wiki=$8
  local base_repository

  if [[ ${repository} =~ ^(.+)-ghsa-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$ ]]; then
    base_repository=${BASH_REMATCH[1]}
  else
    return 1
  fi

  [[ ${private} == true ]] &&
    [[ ${visibility} == private ]] &&
    [[ ${disabled} == false ]] &&
    [[ ${fork} == false ]] &&
    [[ ${has_issues} == false ]] &&
    [[ ${has_projects} == false ]] &&
    [[ ${has_wiki} == false ]] &&
    jq -e --arg repository "${base_repository}" \
      '(.pull_request_gate | index($repository)) != null' \
      "${repositories_config}" >/dev/null
}

upsert_repository_ruleset() {
  local repository=$1
  local input=$2
  local name id

  name=$(jq -r '.name' "${input}")
  id=$(
    github_api "repos/${organization}/${repository}/rulesets?includes_parents=false" |
      jq -r --arg name "${name}" 'map(select(.name == $name))[0].id // empty'
  )

  if [[ -n ${id} ]]; then
    run_api PUT "repos/${organization}/${repository}/rulesets/${id}" "${input}"
  else
    run_api POST "repos/${organization}/${repository}/rulesets" "${input}"
  fi
}

upsert_organization_ruleset() {
  local input=$1
  local name id

  name=$(jq -r '.name' "${input}")
  id=$(
    github_api "orgs/${organization}/rulesets" |
      jq -r --arg name "${name}" 'map(select(.name == $name))[0].id // empty'
  )

  if [[ -n ${id} ]]; then
    run_api PUT "orgs/${organization}/rulesets/${id}" "${input}"
  else
    run_api POST "orgs/${organization}/rulesets" "${input}"
  fi
}

make_organization_ruleset() {
  local base=$1
  local name=$2
  local repositories=$3
  local excluded_repositories=${4:-[]}
  local output

  output=$(mktemp)
  temporary_files+=("${output}")
  jq --arg name "${name}" \
    --argjson repositories "${repositories}" \
    --argjson excluded_repositories "${excluded_repositories}" '
    .name = $name |
    .conditions.repository_name = {
      include: $repositories,
      exclude: $excluded_repositories,
      protected: false
    }
  ' "${base}" >"${output}"
  echo "${output}"
}

maintenance_ruleset_name() {
  local repository=$1
  local branch=$2

  printf '05 - Maintenance branch - %s - %s' "${repository}" "${branch}"
}

make_maintenance_ruleset() {
  local repository=$1
  local branch=$2
  local required_ci=$3
  local scope=$4
  local output name

  name=$(maintenance_ruleset_name "${repository}" "${branch}")
  output=$(mktemp)
  temporary_files+=("${output}")
  jq --arg name "${name}" \
    --arg repository "${repository}" \
    --arg branch "${branch}" \
    --arg scope "${scope}" \
    --argjson app_id 15368 \
    --argjson required_ci "${required_ci}" '
      .name = $name |
      .conditions.ref_name.include = ["refs/heads/\($branch)"] |
      .rules = (
        .rules |
        map(
          if .type == "required_status_checks" then
            .parameters.required_status_checks =
              ($required_ci | map({context: ., integration_id: $app_id}))
          else
            .
          end
        ) |
        if ($required_ci | length) == 0 then
          map(select(.type != "required_status_checks"))
        else
          .
        end
      ) |
      if $scope == "organization" then
        .conditions.repository_name = {
          include: [$repository],
          exclude: [],
          protected: false
        }
      else
        .
      end
    ' "${root}/config/rulesets/maintenance-branch.json" >"${output}"
  echo "${output}"
}

maintenance_ruleset_is_desired() {
  local repository=$1
  local candidate=$2
  local branch expected

  while IFS= read -r branch; do
    expected=$(maintenance_ruleset_name "${repository}" "${branch}")
    if [[ ${candidate} == "${expected}" ]]; then
      return 0
    fi
  done < <(
    jq -r --arg repository "${repository}" '
      .maintenance_branches[] |
      select(.repository == $repository) |
      .branch
    ' "${repositories_config}"
  )
  return 1
}

delete_stale_repository_maintenance_rulesets() {
  local repository ruleset name id

  for repository in "${active_repositories[@]}"; do
    while IFS= read -r ruleset; do
      name=$(jq -r '.name' <<<"${ruleset}")
      id=$(jq -r '.id' <<<"${ruleset}")
      if [[ ${name} != "05 - Maintenance branch - "* ]]; then
        continue
      fi
      if ! maintenance_ruleset_is_desired "${repository}" "${name}"; then
        run_api DELETE "repos/${organization}/${repository}/rulesets/${id}"
      fi
    done < <(
      github_api \
        "repos/${organization}/${repository}/rulesets?includes_parents=false" |
        jq -c '.[]'
    )
  done
}

delete_stale_repository_advisory_rulesets() {
  local repository ruleset name id window_active

  while IFS= read -r repository; do
    window_active=false
    if repository_has_advisory_merge_window "${repository}"; then
      window_active=true
    fi
    while IFS= read -r ruleset; do
      name=$(jq -r '.name' <<<"${ruleset}")
      id=$(jq -r '.id' <<<"${ruleset}")
      if ${window_active}; then
        case ${name} in
        "01 - Default branch integrity" | \
          "01 - Default branch linear history" | \
          "02 - Changes through pull requests")
          run_api DELETE \
            "repos/${organization}/${repository}/rulesets/${id}"
          ;;
        esac
      else
        case ${name} in
        "01 - Default branch integrity - ${repository}" | \
          "01 - Default branch linear history - ${repository}" | \
          "02 - Changes through pull requests - ${repository}")
          run_api DELETE \
            "repos/${organization}/${repository}/rulesets/${id}"
          ;;
        esac
      fi
    done < <(
      github_api \
        "repos/${organization}/${repository}/rulesets?includes_parents=false" |
        jq -c '.[]'
    )
  done < <(jq -r '.pull_request_gate[]' "${repositories_config}")
}

delete_managed_repository_rulesets() {
  local repository=$1
  local ruleset name id

  while IFS= read -r ruleset; do
    name=$(jq -r '.name' <<<"${ruleset}")
    id=$(jq -r '.id' <<<"${ruleset}")
    case ${name} in
    "01 - Default branch integrity" | \
      "01 - Default branch integrity - classic" | \
      "01 - Default branch linear history" | \
      "01 - Default branch linear history - classic" | \
      "02 - Changes through pull requests" | \
      "02 - Changes through pull requests - classic" | \
      "03 - Required CI" | \
      "04 - Immutable release tags" | \
      "05 - Maintenance branch - "*)
      run_api DELETE "repos/${organization}/${repository}/rulesets/${id}"
      ;;
    esac
  done < <(
    github_api "repos/${organization}/${repository}/rulesets?includes_parents=false" |
      jq -c '.[]'
  )
}

delete_managed_organization_rulesets() {
  local ruleset name id

  while IFS= read -r ruleset; do
    name=$(jq -r '.name' <<<"${ruleset}")
    id=$(jq -r '.id' <<<"${ruleset}")
    case ${name} in
    "01 - Default branch integrity" | \
      "01 - Default branch integrity - classic" | \
      "01 - Default branch linear history" | \
      "01 - Default branch linear history - classic" | \
      "02 - Changes through pull requests" | \
      "02 - Changes through pull requests - classic" | \
      "04 - Immutable release tags" | \
      "03 - Required CI - "* | \
      "05 - Maintenance branch - "*)
      run_api DELETE "orgs/${organization}/rulesets/${id}"
      ;;
    esac
  done < <(github_api "orgs/${organization}/rulesets" | jq -c '.[]')
}

publish_repository_rulesets() {
  local repository ruleset_config ci_payload maintenance branch required_ci
  local input

  # Establish the Classic-specific policy before replacing its shared policy.
  for repository in "${active_repositories[@]}"; do
    ruleset_config=${root}/config/rulesets/default-branch-linear-history.json
    if repository_has_advisory_merge_window "${repository}"; then
      ruleset_config=${root}/config/rulesets/default-branch-linear-history-classic.json
    fi
    upsert_repository_ruleset "${repository}" \
      "${ruleset_config}"
  done

  for repository in "${active_repositories[@]}"; do
    ruleset_config=${root}/config/rulesets/default-branch-integrity.json
    if repository_has_advisory_merge_window "${repository}"; then
      ruleset_config=${root}/config/rulesets/default-branch-integrity-classic.json
    fi
    upsert_repository_ruleset "${repository}" \
      "${ruleset_config}"
  done

  while IFS= read -r repository; do
    ruleset_config=${root}/config/rulesets/pull-request-gate.json
    if repository_has_advisory_merge_window "${repository}"; then
      ruleset_config=${root}/config/rulesets/pull-request-gate-classic.json
    fi
    upsert_repository_ruleset "${repository}" \
      "${ruleset_config}"
  done < <(jq -r '.pull_request_gate[]' "${repositories_config}")

  while IFS= read -r repository; do
    ci_payload=$(mktemp)
    temporary_files+=("${ci_payload}")
    jq --arg repository "${repository}" \
      --argjson app_id 15368 \
      --slurpfile advisory_windows "${advisory_merge_windows_config}" \
      --slurpfile repositories "${repositories_config}" '
        .bypass_actors |= map(
          if ($advisory_windows[0].repositories | index($repository)) != null then
            .bypass_mode = "always"
          else
            .
          end
        ) |
        .rules[0].parameters.required_status_checks =
          ($repositories[0].required_ci[$repository] |
           map({context: ., integration_id: $app_id}))
      ' "${root}/config/rulesets/required-ci.json" >"${ci_payload}"
    upsert_repository_ruleset "${repository}" "${ci_payload}"
  done < <(jq -r '.required_ci | keys[]' "${repositories_config}")

  while IFS= read -r repository; do
    upsert_repository_ruleset "${repository}" \
      "${root}/config/rulesets/immutable-release-tags.json"
  done < <(jq -r '.release_tags[]' "${repositories_config}")

  while IFS= read -r maintenance; do
    repository=$(jq -r '.repository' <<<"${maintenance}")
    branch=$(jq -r '.branch' <<<"${maintenance}")
    required_ci=$(jq -c '.required_ci' <<<"${maintenance}")
    input=$(make_maintenance_ruleset \
      "${repository}" "${branch}" "${required_ci}" repository)
    temporary_files+=("${input}")
    upsert_repository_ruleset "${repository}" "${input}"
  done < <(jq -c '.maintenance_branches[]' "${repositories_config}")

  delete_stale_repository_maintenance_rulesets
  delete_stale_repository_advisory_rulesets

  if [[ ${organization_plan} != free ]]; then
    delete_managed_organization_rulesets
  fi
}

publish_organization_rulesets() {
  local input repository ci_payload maintenance branch required_ci
  local -a desired_rulesets
  local repositories ruleset name id desired

  desired_rulesets=(
    "01 - Default branch integrity"
    "01 - Default branch linear history"
    "02 - Changes through pull requests"
    "04 - Immutable release tags"
  )

  # Establish the Classic-specific policies before excluding it from their
  # shared counterparts.
  if repository_has_advisory_merge_window classic; then
    desired_rulesets+=(
      "01 - Default branch integrity - classic"
      "01 - Default branch linear history - classic"
      "02 - Changes through pull requests - classic"
    )
    input=$(make_organization_ruleset \
      "${root}/config/rulesets/default-branch-integrity-classic.json" \
      "01 - Default branch integrity - classic" '["classic"]')
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}"
    input=$(make_organization_ruleset \
      "${root}/config/rulesets/default-branch-linear-history-classic.json" \
      "01 - Default branch linear history - classic" '["classic"]')
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}"
  fi

  repositories=$(jq -c '.repositories' "${advisory_merge_windows_config}")

  input=$(make_organization_ruleset \
    "${root}/config/rulesets/default-branch-linear-history.json" \
    "01 - Default branch linear history" '["~ALL"]' "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}"

  input=$(make_organization_ruleset \
    "${root}/config/rulesets/default-branch-integrity.json" \
    "01 - Default branch integrity" '["~ALL"]' "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}"

  # Establish the Classic-specific policy before excluding it from the shared
  # pull-request policy.
  if repository_has_advisory_merge_window classic; then
    input=$(make_organization_ruleset \
      "${root}/config/rulesets/pull-request-gate-classic.json" \
      "02 - Changes through pull requests - classic" '["classic"]')
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}"
  fi

  repositories=$(jq -c \
    --slurpfile advisory_windows "${advisory_merge_windows_config}" \
    '.pull_request_gate - $advisory_windows[0].repositories' \
    "${repositories_config}")
  input=$(make_organization_ruleset \
    "${root}/config/rulesets/pull-request-gate.json" \
    "02 - Changes through pull requests" "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}"

  repositories=$(jq -c '.release_tags' "${repositories_config}")
  input=$(make_organization_ruleset \
    "${root}/config/rulesets/immutable-release-tags.json" \
    "04 - Immutable release tags" "${repositories}")
  temporary_files+=("${input}")
  upsert_organization_ruleset "${input}"

  while IFS= read -r repository; do
    name="03 - Required CI - ${repository}"
    desired_rulesets+=("${name}")
    ci_payload=$(mktemp)
    temporary_files+=("${ci_payload}")
    jq --arg name "${name}" \
      --arg repository "${repository}" \
      --argjson app_id 15368 \
      --slurpfile advisory_windows "${advisory_merge_windows_config}" \
      --slurpfile repositories "${repositories_config}" '
        .name = $name |
        .bypass_actors |= map(
          if ($advisory_windows[0].repositories | index($repository)) != null then
            .bypass_mode = "always"
          else
            .
          end
        ) |
        .conditions.repository_name = {
          include: [$repository],
          exclude: [],
          protected: false
        } |
        .rules[0].parameters.required_status_checks =
          ($repositories[0].required_ci[$repository] |
           map({context: ., integration_id: $app_id}))
      ' "${root}/config/rulesets/required-ci.json" >"${ci_payload}"
    upsert_organization_ruleset "${ci_payload}"
  done < <(jq -r '.required_ci | keys[]' "${repositories_config}")

  while IFS= read -r maintenance; do
    repository=$(jq -r '.repository' <<<"${maintenance}")
    branch=$(jq -r '.branch' <<<"${maintenance}")
    required_ci=$(jq -c '.required_ci' <<<"${maintenance}")
    name=$(maintenance_ruleset_name "${repository}" "${branch}")
    desired_rulesets+=("${name}")
    input=$(make_maintenance_ruleset \
      "${repository}" "${branch}" "${required_ci}" organization)
    temporary_files+=("${input}")
    upsert_organization_ruleset "${input}"
  done < <(jq -c '.maintenance_branches[]' "${repositories_config}")

  while IFS= read -r ruleset; do
    name=$(jq -r '.name' <<<"${ruleset}")
    id=$(jq -r '.id' <<<"${ruleset}")
    case ${name} in
    "01 - Default branch integrity - "* | \
      "01 - Default branch linear history - "* | \
      "02 - Changes through pull requests - "* | \
      "03 - Required CI - "* | \
      "05 - Maintenance branch - "*) ;;
    *)
      continue
      ;;
    esac
    desired=false
    for repository in "${desired_rulesets[@]}"; do
      if [[ ${repository} == "${name}" ]]; then
        desired=true
        break
      fi
    done
    if ! ${desired}; then
      run_api DELETE "orgs/${organization}/rulesets/${id}"
    fi
  done < <(github_api "orgs/${organization}/rulesets" | jq -c '.[]')

  for repository in "${active_repositories[@]}"; do
    delete_managed_repository_rulesets "${repository}"
  done
}

upsert_code_security_configuration() {
  local input=$1
  local placeholder=$2
  local name id current

  name=$(jq -r '.name' "${input}")
  id=$(
    github_api "orgs/${organization}/code-security/configurations" |
      jq -r --arg name "${name}" 'map(select(.name == $name))[0].id // empty'
  )

  if [[ -n ${id} ]]; then
    current=$(github_api \
      "orgs/${organization}/code-security/configurations/${id}")
    if code_security_configuration_matches "${input}" "${current}"; then
      echo "KEEP /orgs/${organization}/code-security/configurations/${id} matches ${input#"${root}/"}"
    else
      run_api PATCH \
        "orgs/${organization}/code-security/configurations/${id}" \
        "${input}"
    fi
  elif ${apply}; then
    id=$(
      github_api --method POST \
        "orgs/${organization}/code-security/configurations" \
        --input "${input}" | jq -r '.id'
    )
  else
    echo "PLAN POST /orgs/${organization}/code-security/configurations <= ${input#"${root}/"}"
    id=${placeholder}
  fi

  if ${apply} && [[ ! ${id} =~ ^[0-9]+$ ]]; then
    echo "error: invalid code security configuration id for ${name}: ${id}" >&2
    exit 1
  fi

  upserted_code_security_configuration_id=${id}
}

code_security_configuration_matches() {
  local input=$1
  local current=$2

  # GitHub currently returns the legacy advanced_security summary even when
  # code_security and secret_protection were written separately. Normalize
  # that response before comparing only the fields owned by desired state.
  jq -e --slurpfile desired "${input}" '
    . as $current |
    (
      $current + {
        code_security: (
          if $current.code_security != null then
            $current.code_security
          elif (
            $current.advanced_security == "enabled" or
            $current.advanced_security == "code_security"
          ) then
            "enabled"
          elif (
            $current.advanced_security == "disabled" or
            $current.advanced_security == "secret_protection"
          ) then
            "disabled"
          else
            "not_set"
          end
        ),
        secret_protection: (
          if $current.secret_protection != null then
            $current.secret_protection
          elif (
            $current.advanced_security == "enabled" or
            $current.advanced_security == "secret_protection"
          ) then
            "enabled"
          elif (
            $current.advanced_security == "disabled" or
            $current.advanced_security == "code_security"
          ) then
            "disabled"
          else
            "not_set"
          end
        )
      }
    ) as $normalized |
    $desired[0] as $wanted |
    reduce ($wanted | keys[]) as $key
      (true; . and ($normalized[$key] == $wanted[$key]))
  ' <<<"${current}" >/dev/null
}

make_security_attach_payload() {
  local advanced=$1
  local expected_id=$2
  local repository repository_is_advanced id current status current_id
  local ids='[]'

  security_attachment_wait_needed=false

  for repository in "${active_repositories[@]}"; do
    repository_is_advanced=false
    if repository_uses_advanced_codeql "${repository}"; then
      repository_is_advanced=true
    fi
    if [[ ${repository_is_advanced} != "${advanced}" ]]; then
      continue
    fi

    id=${active_repository_ids["${repository}"]}
    current=
    if current=$(github_api \
      "repos/${organization}/${repository}/code-security-configuration" \
      2>/dev/null); then
      status=$(jq -r '.status // empty' <<<"${current}")
      current_id=$(jq -r '.configuration.id // empty' <<<"${current}")
      if [[ ${current_id} == "${expected_id}" ]]; then
        # Both managed configurations require enforcement. An attached
        # relationship must settle to enforced, but must not be re-attached.
        case ${status} in
        enforced)
          continue
          ;;
        attached | attaching | updating)
          security_attachment_wait_needed=true
          continue
          ;;
        esac
      fi
    fi

    ids=$(jq --argjson id "${id}" '. + [$id]' <<<"${ids}")
    security_attachment_wait_needed=true
  done

  security_attach_payload=$(mktemp)
  jq -n --argjson ids "${ids}" \
    '{scope: "selected", selected_repository_ids: $ids}' \
    >"${security_attach_payload}"
  security_attachment_count=$(jq '.selected_repository_ids | length' \
    "${security_attach_payload}")
}

converge_security_configuration_attachments() {
  local advanced=$1
  local expected_id=$2
  local cohort=$3

  make_security_attach_payload "${advanced}" "${expected_id}"
  temporary_files+=("${security_attach_payload}")

  if ((security_attachment_count > 0)); then
    run_api POST \
      "orgs/${organization}/code-security/configurations/${expected_id}/attach" \
      "${security_attach_payload}"
  elif ! ${security_attachment_wait_needed}; then
    echo "KEEP /orgs/${organization}/code-security/configurations/${expected_id}/attach already covers ${cohort} repositories"
  fi

  if ${security_attachment_wait_needed}; then
    wait_for_code_security_configuration "${advanced}" "${expected_id}"
  fi
}

wait_for_code_security_configuration() {
  local advanced=$1
  local expected_id=$2
  local repository response status id attempt
  local -r maximum_attempts=30

  for repository in "${active_repositories[@]}"; do
    if repository_uses_advanced_codeql "${repository}"; then
      [[ ${advanced} == true ]] || continue
    else
      [[ ${advanced} == false ]] || continue
    fi

    if ! ${apply}; then
      echo "PLAN WAIT /repos/${organization}/${repository}/code-security-configuration => ${expected_id}"
      continue
    fi

    for ((attempt = 1; attempt <= maximum_attempts; attempt++)); do
      if response=$(github_api \
        "repos/${organization}/${repository}/code-security-configuration" \
        2>/dev/null); then
        status=$(jq -r '.status // empty' <<<"${response}")
        id=$(jq -r '.configuration.id // empty' <<<"${response}")
        # "attached" is active but not the enforced terminal state required
        # by both managed configurations.
        if [[ ${id} == "${expected_id}" ]] &&
          [[ ${status} == enforced ]]; then
          break
        fi
        if [[ ${id} == "${expected_id}" ]] &&
          [[ ${status} == failed ]]; then
          echo "error: security configuration attachment failed for ${organization}/${repository}" >&2
          exit 1
        fi
      fi

      if ((attempt == maximum_attempts)); then
        echo "error: timed out waiting for security configuration ${expected_id} on ${organization}/${repository}" >&2
        exit 1
      fi
      sleep 2
    done
  done
}

converge_codeql_default_setup() {
  local repository input desired_state desired_query current
  local current_state current_query

  for repository in "${active_repositories[@]}"; do
    input=${root}/config/codeql-default-setup.json
    if repository_uses_advanced_codeql "${repository}"; then
      input=${root}/config/codeql-default-setup-advanced.json
    fi

    desired_state=$(jq -r '.state' "${input}")
    desired_query=$(jq -r '.query_suite // empty' "${input}")
    if current=$(github_api \
      "repos/${organization}/${repository}/code-scanning/default-setup" \
      2>/dev/null); then
      current_state=$(jq -r '.state // empty' <<<"${current}")
      current_query=$(jq -r '.query_suite // empty' <<<"${current}")
      if [[ ${current_state} == "${desired_state}" ]] &&
        { [[ -z ${desired_query} ]] || [[ ${current_query} == "${desired_query}" ]]; }; then
        echo "KEEP /repos/${organization}/${repository}/code-scanning/default-setup is ${desired_state}"
        continue
      fi
    fi

    run_api PATCH \
      "repos/${organization}/${repository}/code-scanning/default-setup" \
      "${input}"
  done
}

publish_organization_security() {
  local advanced_id baseline_id defaults_payload defaults
  local advanced_repository_count baseline_repository_count

  # Move governed advanced-setup repositories first. This prevents a baseline
  # update from temporarily re-enabling default setup during later publishes.
  upsert_code_security_configuration \
    "${root}/config/code-security-advanced.json" \
    '{advanced-codeql-configuration-id}'
  advanced_id=${upserted_code_security_configuration_id}
  advanced_repository_count=$(jq '.repositories | length' \
    "${codeql_advanced_config}")
  if ((advanced_repository_count > 0)); then
    converge_security_configuration_attachments \
      true "${advanced_id}" "${advanced_repository_count}"
  else
    echo "SKIP advanced CodeQL attachment: inventory is empty"
  fi

  upsert_code_security_configuration \
    "${root}/config/code-security.json" \
    '{baseline-configuration-id}'
  baseline_id=${upserted_code_security_configuration_id}

  defaults_payload=$(mktemp)
  temporary_files+=("${defaults_payload}")
  jq -n '{default_for_new_repos: "all"}' >"${defaults_payload}"
  defaults=$(github_api \
    "orgs/${organization}/code-security/configurations/defaults")
  if jq -e --arg id "${baseline_id}" '
    any(
      .[];
      (
        (
          .configuration.id // .configuration.value.id // null |
          tostring
        ) == $id
      ) and
      .default_for_new_repos == "all"
    )
  ' <<<"${defaults}" >/dev/null; then
    echo "KEEP /orgs/${organization}/code-security/configurations/${baseline_id}/defaults is all"
  else
    run_api PUT \
      "orgs/${organization}/code-security/configurations/${baseline_id}/defaults" \
      "${defaults_payload}"
  fi

  baseline_repository_count=$((${#active_repositories[@]} - \
    advanced_repository_count))
  converge_security_configuration_attachments \
    false "${baseline_id}" "${baseline_repository_count}"

  converge_codeql_default_setup
}

publish_repository_security() {
  local repository

  for repository in "${active_repositories[@]}"; do
    run_api PATCH "repos/${organization}/${repository}" \
      "${root}/config/repository-security.json"
    run_api PUT "repos/${organization}/${repository}/vulnerability-alerts"
    run_api PUT "repos/${organization}/${repository}/automated-security-fixes"
    run_api PUT "repos/${organization}/${repository}/private-vulnerability-reporting"
  done

  converge_codeql_default_setup
}

current_immutable_release_payload() {
  local response mode selected_repository_ids

  if ! response=$(github_api \
    "orgs/${organization}/settings/immutable-releases"); then
    echo "error: failed to read the organization immutable-release policy" >&2
    return 1
  fi
  mode=$(jq -r '.enforced_repositories // empty' <<<"${response}")
  case ${mode} in
  all | none)
    jq -cn --arg mode "${mode}" '{enforced_repositories: $mode}'
    ;;
  selected)
    if ! selected_repository_ids=$(
      github_api --paginate \
        "orgs/${organization}/settings/immutable-releases/repositories?per_page=100" \
        --jq '.repositories[].id' | jq -cs 'map(tonumber) | sort | unique'
    ); then
      echo "error: failed to read repositories selected for immutable releases" >&2
      return 1
    fi
    jq -cn \
      --argjson selected_repository_ids "${selected_repository_ids}" \
      '{
        enforced_repositories: "selected",
        selected_repository_ids: $selected_repository_ids
      }'
    ;;
  *)
    echo "error: unsupported immutable-release policy mode: ${mode:-missing}" >&2
    return 1
    ;;
  esac
}

immutable_release_policy_matches() {
  local expected=$1
  local verify_owner_enforcement=$2
  local current repository response

  if ! current=$(current_immutable_release_payload); then
    return 1
  fi
  if ! jq -e --argjson expected "${expected}" \
    '. == $expected' <<<"${current}" >/dev/null; then
    return 1
  fi

  if [[ ${verify_owner_enforcement} != true ]]; then
    return 0
  fi
  while IFS= read -r repository; do
    if ! response=$(github_api \
      "repos/${organization}/${repository}/immutable-releases"); then
      return 1
    fi
    if ! jq -e \
      '.enabled == true and .enforced_by_owner == true' \
      <<<"${response}" >/dev/null; then
      return 1
    fi
  done < <(jq -r '.repositories[].name' "${immutable_releases_config}")
}

write_immutable_release_payload() {
  local payload=$1
  local output

  output=$(mktemp)
  jq . <<<"${payload}" >"${output}"
  printf '%s\n' "${output}"
}

rollback_immutable_release_policy() {
  local snapshot=$1
  local input

  input=$(write_immutable_release_payload "${snapshot}")
  temporary_files+=("${input}")
  echo "ROLLBACK PUT /orgs/${organization}/settings/immutable-releases <= ${snapshot}" >&2
  if ! github_api --method PUT \
    "orgs/${organization}/settings/immutable-releases" \
    --input "${input}" >/dev/null; then
    echo "error: immutable-release policy rollback request failed" >&2
    return 1
  fi
  if ! immutable_release_policy_matches "${snapshot}" false; then
    echo "error: immutable-release policy rollback verification failed" >&2
    return 1
  fi
  echo "ROLLBACK verified the previous immutable-release policy" >&2
}

converge_immutable_release_policy() {
  local desired snapshot input

  desired=$(jq -c '
    {
      enforced_repositories,
      selected_repository_ids: ([.repositories[].id] | sort)
    }
  ' "${immutable_releases_config}")
  if immutable_release_policy_matches "${desired}" true; then
    echo "KEEP /orgs/${organization}/settings/immutable-releases is ${desired}"
    return 0
  fi

  if ! snapshot=$(current_immutable_release_payload); then
    return 1
  fi
  if ! ${apply}; then
    echo "PLAN PUT /orgs/${organization}/settings/immutable-releases <= ${desired}"
    while IFS= read -r repository; do
      echo "PLAN VERIFY /repos/${organization}/${repository}/immutable-releases" \
        "=> enabled=true,enforced_by_owner=true"
    done < <(jq -r '.repositories[].name' "${immutable_releases_config}")
    return 0
  fi

  input=$(write_immutable_release_payload "${desired}")
  temporary_files+=("${input}")
  if github_api --method PUT \
    "orgs/${organization}/settings/immutable-releases" \
    --input "${input}" >/dev/null &&
    immutable_release_policy_matches "${desired}" true; then
    echo "APPLY /orgs/${organization}/settings/immutable-releases <= ${desired}"
    return 0
  fi

  echo "error: immutable-release policy apply or verification failed" >&2
  if ! rollback_immutable_release_policy "${snapshot}"; then
    echo "error: previous immutable-release policy could not be restored" >&2
  fi
  return 1
}

organization_metadata=$(github_api "orgs/${organization}")
if ! jq -e 'type == "object" and (.plan.name | type == "string")' \
  <<<"${organization_metadata}" >/dev/null; then
  echo "error: GitHub returned invalid organization metadata" >&2
  exit 1
fi
organization_plan=$(jq -r '.plan.name' <<<"${organization_metadata}")
if [[ ${policy_scope} == auto ]]; then
  case ${organization_plan} in
  team | enterprise) policy_scope=organization ;;
  *) policy_scope=repository ;;
  esac
fi

echo "Organization: ${organization}"
echo "Plan: ${organization_plan}"
echo "Policy scope: ${policy_scope}"
${apply} && echo "Mode: apply" || echo "Mode: plan"

declare -a active_repositories=()
declare -A active_repository_ids=()
while IFS=$'\t' read -r \
  repository id private visibility disabled fork has_issues has_projects has_wiki; do
  if [[ ! ${id} =~ ^[0-9]+$ ]]; then
    echo "error: invalid repository id for ${repository}: ${id}" >&2
    exit 1
  fi
  if is_temporary_security_advisory_repository \
    "${repository}" "${private}" "${visibility}" "${disabled}" "${fork}" \
    "${has_issues}" "${has_projects}" "${has_wiki}"; then
    echo "SKIP ${organization}/${repository} is a temporary security-advisory workspace"
    continue
  fi
  active_repositories+=("${repository}")
  active_repository_ids["${repository}"]=${id}
done < <(
  github_api --paginate "orgs/${organization}/repos?per_page=100&type=all" \
    --jq '
      .[] |
      select(.archived == false) |
      [
        .name,
        .id,
        .private,
        .visibility,
        .disabled,
        .fork,
        .has_issues,
        .has_projects,
        .has_wiki
      ] |
      @tsv
    '
)

while IFS= read -r repository; do
  if [[ ! -v active_repository_ids["${repository}"] ]]; then
    echo "error: advanced CodeQL inventory repository is not active: ${repository}" >&2
    exit 1
  fi
done < <(jq -r '.repositories[]' "${codeql_advanced_config}")

while IFS=$'\t' read -r repository expected_id; do
  if [[ ! -v active_repository_ids["${repository}"] ]]; then
    echo "error: immutable-release inventory repository is not active: ${repository}" >&2
    exit 1
  fi
  if [[ ${active_repository_ids["${repository}"]} != "${expected_id}" ]]; then
    echo "error: immutable-release inventory id for ${repository} is" \
      "${expected_id}, but GitHub reports" \
      "${active_repository_ids["${repository}"]}" >&2
    exit 1
  fi
done < <(
  jq -r '.repositories[] | [.name, .id] | @tsv' \
    "${immutable_releases_config}"
)

converge_immutable_release_policy

converge_organization_settings "${organization_metadata}"
run_api PUT "orgs/${organization}/actions/permissions" \
  "${root}/config/actions-permissions.json"
run_api PUT "orgs/${organization}/actions/permissions/selected-actions" \
  "${root}/config/actions-selected.json"
run_api PUT "orgs/${organization}/actions/permissions/workflow" \
  "${root}/config/actions-workflow.json"

for repository in "${active_repositories[@]}"; do
  run_api PATCH "repos/${organization}/${repository}" \
    "${root}/config/repository-defaults.json"
done

if [[ ${policy_scope} == organization ]]; then
  publish_organization_rulesets
  publish_organization_security
else
  publish_repository_rulesets
  publish_repository_security
fi

while IFS= read -r repository; do
  if ! repository_archived=$(
    github_api "repos/${organization}/${repository}" --jq '.archived' 2>/dev/null
  ); then
    echo "SKIP ${organization}/${repository} does not exist"
    continue
  fi

  if [[ ${repository_archived} == true ]]; then
    echo "SKIP ${organization}/${repository} is already archived"
    continue
  fi

  archive_payload=$(mktemp)
  temporary_files+=("${archive_payload}")
  jq -n '{archived: true}' >"${archive_payload}"
  run_api PATCH "repos/${organization}/${repository}" "${archive_payload}"
done < <(jq -r '.archive[]' "${repositories_config}")

if [[ $(jq -r '.members_can_create_teams' <<<"${organization_metadata}") != false ]]; then
  echo "MANUAL members can still create teams; disable this in Member privileges."
fi
echo "Manual confirmation required for config/manual-settings.json."
