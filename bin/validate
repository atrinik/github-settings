#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
repositories_config=${root}/config/repositories.json
advanced_codeql_config=${root}/config/codeql-advanced-setup.json
immutable_releases_config=${root}/config/immutable-releases.json

for command in git jq; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done

while IFS= read -r -d '' config; do
  jq empty "${config}" >/dev/null
done < <(find "${root}/config" -name '*.json' -print0 | sort -z)

jq -e '
  . as $config |
  (.pull_request_gate | type == "array") and
  ((.pull_request_gate | length) == (.pull_request_gate | unique | length)) and
  all(.pull_request_gate[]; type == "string" and length > 0) and
  (.required_ci | type == "object") and
  all(
    .required_ci | to_entries[];
    (.key | type == "string" and length > 0) and
    (.value | type == "array" and length > 0) and
    ((.value | length) == (.value | unique | length)) and
    all(.value[]; type == "string" and length > 0) and
    (.key as $repository |
      ($config.pull_request_gate | index($repository)) != null)
  ) and
  (.release_tags | type == "array") and
  ((.release_tags | length) == (.release_tags | unique | length)) and
  all(.release_tags[]; type == "string" and length > 0) and
  (.archive | type == "array") and
  ((.archive | length) == (.archive | unique | length)) and
  all(.archive[]; type == "string" and length > 0) and
  all(
    .archive[];
    . as $repository |
    ($config.pull_request_gate | index($repository)) == null and
    ($config.required_ci | has($repository) | not) and
    ($config.release_tags | index($repository)) == null and
    all(
      $config.maintenance_branches[];
      .repository != $repository
    )
  ) and
  (.maintenance_branches | type == "array") and
  all(
    .maintenance_branches[];
    (keys == ["branch", "repository", "required_ci"]) and
    (.repository | type == "string" and length > 0) and
    (.branch | type == "string" and length > 0 and . != "main") and
    (.required_ci | type == "array") and
    ((.required_ci | length) == (.required_ci | unique | length)) and
    all(.required_ci[]; type == "string" and length > 0) and
    (.repository as $repository |
      ($config.pull_request_gate | index($repository)) != null) and
    (.repository as $repository |
      .required_ci |
      all(
        .[];
        . as $check |
        (($config.required_ci[$repository] // []) | index($check)) != null
      ))
  ) and
  ([.maintenance_branches[] | [.repository, .branch]] as $branches |
    ($branches | length) == ($branches | unique | length))
' "${repositories_config}" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
    (keys == ["repositories"]) and
    (.repositories | type == "array") and
    ((.repositories | length) == (.repositories | unique | length)) and
    all(
      .repositories[];
      type == "string" and length > 0 and
      (. as $repository |
        ($repositories[0].pull_request_gate | index($repository)) != null) and
      (. as $repository |
        ($repositories[0].archive | index($repository)) == null)
    )
  ' "${advanced_codeql_config}" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
    (keys == ["enforced_repositories", "repositories"]) and
    .enforced_repositories == "selected" and
    (.repositories | type == "array" and length > 0) and
    all(
      .repositories[];
      (keys == ["id", "name"]) and
      (.id | type == "number" and floor == . and . > 0) and
      (.name | type == "string" and length > 0) and
      (.name as $repository |
        ($repositories[0].pull_request_gate | index($repository)) != null) and
      (.name as $repository |
        ($repositories[0].release_tags | index($repository)) != null) and
      (.name as $repository |
        ($repositories[0].archive | index($repository)) == null)
    ) and
    ([.repositories[].id] as $ids |
      ($ids | length) == ($ids | unique | length)) and
    ([.repositories[].name] as $names |
      ($names | length) == ($names | unique | length) and
      $names == ($names | sort))
  ' "${immutable_releases_config}" >/dev/null

jq -e '
  .code_scanning_default_setup == "enabled" and
  .code_scanning_options == {allow_advanced: false} and
  .enforcement == "enforced"
' "${root}/config/code-security.json" >/dev/null

jq -e \
  --slurpfile baseline "${root}/config/code-security.json" '
    .name == "Atrinik advanced CodeQL baseline" and
    (.description | type == "string" and length > 0) and
    .code_scanning_default_setup == "enabled" and
    .code_scanning_options == {allow_advanced: true} and
    .enforcement == "enforced" and
    (
      del(.name, .description, .code_scanning_options) ==
      ($baseline[0] | del(.name, .description, .code_scanning_options))
    )
  ' "${root}/config/code-security-advanced.json" >/dev/null

jq -e '. == {state: "configured", query_suite: "default"}' \
  "${root}/config/codeql-default-setup.json" >/dev/null

jq -e '. == {state: "not-configured"}' \
  "${root}/config/codeql-default-setup-advanced.json" >/dev/null

while IFS= read -r branch; do
  if ! git check-ref-format --branch "${branch}" >/dev/null; then
    echo "error: invalid maintenance branch name: ${branch}" >&2
    exit 1
  fi
done < <(jq -r '.maintenance_branches[].branch' "${repositories_config}")

echo "Governance configuration is valid."
