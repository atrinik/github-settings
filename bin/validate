#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
organization_config=${root}/config/organization.json
repositories_config=${root}/config/repositories.json
advisory_merge_windows_config=${root}/config/advisory-merge-windows.json
advanced_codeql_config=${root}/config/codeql-advanced-setup.json
immutable_releases_config=${root}/config/immutable-releases.json
retired_maintenance_config=${root}/config/retired-maintenance-branches.json
manual_settings_config=${root}/config/manual-settings.json
planning_config=${root}/config/planning.json
planning_health_config=${root}/config/planning-health.json
repository_properties_config=${root}/config/repository-properties.json
community_health_config=${root}/config/community-health.json

for command in date git jq; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done

validation_today=${ATRINIK_VALIDATION_TODAY:-$(date -u +%F)}
if ! jq -en --arg value "${validation_today}" '
  ($value | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) and
  (
    try (
      (($value + "T00:00:00Z" | fromdateiso8601) |
        strftime("%Y-%m-%d")) == $value
    ) catch false
  )
' >/dev/null; then
  echo "error: ATRINIK_VALIDATION_TODAY must use YYYY-MM-DD" >&2
  exit 2
fi

while IFS= read -r -d '' config; do
  jq empty "${config}" >/dev/null
done < <(find "${root}/config" -name '*.json' -print0 | sort -z)

jq -e '
  . == {
    description: "A cooperative fantasy world of islands, ruins, and crystal-lit mysteries—open source, playable in Classic, and rebuilding for the future.",
    blog: "https://atrinik.org",
    default_repository_permission: "none",
    members_can_create_repositories: false,
    members_can_create_public_repositories: false,
    members_can_create_private_repositories: false
  }
' "${organization_config}" >/dev/null

jq -e '
  .bypass_actors == [] and
  [.rules[].type] == ["deletion", "non_fast_forward"]
' "${root}/config/rulesets/default-branch-integrity.json" >/dev/null

jq -e '
  .bypass_actors == [{
    actor_id: 1,
    actor_type: "OrganizationAdmin",
    bypass_mode: "pull_request"
  }] and
  [.rules[].type] == ["required_linear_history"]
' "${root}/config/rulesets/default-branch-linear-history.json" >/dev/null

jq -e '
  .bypass_actors == [{
    actor_id: 1,
    actor_type: "OrganizationAdmin",
    bypass_mode: "always"
  }] and
  [.rules[].type] == ["required_linear_history"]
' "${root}/config/rulesets/default-branch-linear-history-classic.json" \
  >/dev/null

jq -e '
  .bypass_actors == [{
    actor_id: 1,
    actor_type: "OrganizationAdmin",
    bypass_mode: "pull_request"
  }] and
  [.rules[].type] == ["pull_request"]
' "${root}/config/rulesets/pull-request-gate.json" >/dev/null

jq -e '
  .bypass_actors == [{
    actor_id: 1,
    actor_type: "OrganizationAdmin",
    bypass_mode: "always"
  }] and
  [.rules[].type] == ["pull_request"]
' "${root}/config/rulesets/pull-request-gate-classic.json" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
    (keys == ["repositories"]) and
    (.repositories == ["classic"] or .repositories == []) and
    all(
      .repositories[];
      . as $repository |
      ($repositories[0].pull_request_gate | index($repository)) != null and
      ($repositories[0].required_ci | has($repository))
    )
  ' "${advisory_merge_windows_config}" >/dev/null

jq -e '
  . as $config |
  (.pull_request_gate | type == "array") and
  ((.pull_request_gate | length) == (.pull_request_gate | unique | length)) and
  all(.pull_request_gate[]; type == "string" and length > 0) and
  (.required_ci | type == "object") and
  all(
    .required_ci | to_entries[];
    (.key | type == "string" and length > 0) and
    (.value | type == "array" and length > 0) and
    ((.value | length) == (.value | unique | length)) and
    all(.value[]; type == "string" and length > 0) and
    (.key as $repository |
      ($config.pull_request_gate | index($repository)) != null)
  ) and
  (.release_tags | type == "array") and
  ((.release_tags | length) == (.release_tags | unique | length)) and
  all(.release_tags[]; type == "string" and length > 0) and
  (.archive | type == "array") and
  ((.archive | length) == (.archive | unique | length)) and
  all(.archive[]; type == "string" and length > 0) and
  all(
    .archive[];
    . as $repository |
    ($config.pull_request_gate | index($repository)) == null and
    ($config.required_ci | has($repository) | not) and
    ($config.release_tags | index($repository)) == null and
    all(
      $config.maintenance_branches[];
      .repository != $repository
    )
  ) and
  (.maintenance_branches | type == "array") and
  all(
    .maintenance_branches[];
    (keys == ["branch", "repository", "required_ci"]) and
    (.repository | type == "string" and length > 0) and
    (.branch | type == "string" and length > 0 and . != "main") and
    (.required_ci | type == "array") and
    ((.required_ci | length) == (.required_ci | unique | length)) and
    all(.required_ci[]; type == "string" and length > 0) and
    (.repository as $repository |
      ($config.pull_request_gate | index($repository)) != null) and
    (.repository as $repository |
      .required_ci |
      all(
        .[];
        . as $check |
        (($config.required_ci[$repository] // []) | index($check)) != null
      ))
  ) and
  ([.maintenance_branches[] | [.repository, .branch]] as $branches |
    ($branches | length) == ($branches | unique | length))
' "${repositories_config}" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
    (keys == ["retirements"]) and
    (.retirements | type == "array") and
    all(
      .retirements[];
      (keys == [
        "branch",
        "default_branch",
        "final_branch_commit",
        "final_release",
        "preserved_rulesets",
        "repository",
        "repository_id",
        "ruleset"
      ]) and
      (.repository | type == "string" and length > 0) and
      (.repository_id | type == "number" and floor == . and . > 0) and
      .default_branch == "main" and
      (. as $retirement |
        ($retirement.branch | type == "string" and length > 0) and
        $retirement.branch != $retirement.default_branch) and
      (.final_branch_commit | test("^[0-9a-f]{40}$")) and
      (.final_release | keys == ["assets", "commit", "tag"]) and
      (.final_release.tag | test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")) and
      (.final_release.commit | test("^[0-9a-f]{40}$")) and
      (.final_release.assets | type == "array" and length > 0) and
      ((.final_release.assets | length) ==
        (.final_release.assets | unique | length)) and
      all(.final_release.assets[]; type == "string" and length > 0) and
      (.ruleset | keys == ["id", "name", "required_ci"]) and
      (.ruleset.id | type == "number" and floor == . and . > 0) and
      (.ruleset.name ==
        "05 - Maintenance branch - \(.repository) - \(.branch)") and
      (.ruleset.required_ci | type == "array" and length > 0) and
      ((.ruleset.required_ci | length) ==
        (.ruleset.required_ci | unique | length)) and
      all(.ruleset.required_ci[]; type == "string" and length > 0) and
      (.preserved_rulesets | type == "array" and length > 0) and
      all(
        .preserved_rulesets[];
        (keys == ["id", "name"]) and
        (.id | type == "number" and floor == . and . > 0) and
        (.name | type == "string" and length > 0)
      ) and
      ((.preserved_rulesets | map(.id) | length) ==
        (.preserved_rulesets | map(.id) | unique | length)) and
      (.repository as $repository | .branch as $branch |
        all(
          $repositories[0].maintenance_branches[];
          .repository != $repository or .branch != $branch
        ))
    ) and
    ((.retirements | map([.repository, .branch]) | length) ==
      (.retirements | map([.repository, .branch]) | unique | length)) and
    ((.retirements | map(.ruleset.id) | length) ==
      (.retirements | map(.ruleset.id) | unique | length))
  ' "${retired_maintenance_config}" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
    (keys == ["repositories"]) and
    (.repositories | type == "array") and
    ((.repositories | length) == (.repositories | unique | length)) and
    all(
      .repositories[];
      type == "string" and length > 0 and
      (. as $repository |
        ($repositories[0].pull_request_gate | index($repository)) != null) and
      (. as $repository |
        ($repositories[0].archive | index($repository)) == null)
    )
  ' "${advanced_codeql_config}" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
    (keys == ["enforced_repositories", "repositories"]) and
    .enforced_repositories == "selected" and
    (.repositories | type == "array" and length > 0) and
    all(
      .repositories[];
      (keys == ["id", "name"]) and
      (.id | type == "number" and floor == . and . > 0) and
      (.name | type == "string" and length > 0) and
      (.name as $repository |
        ($repositories[0].pull_request_gate | index($repository)) != null) and
      (.name as $repository |
        ($repositories[0].release_tags | index($repository)) != null) and
      (.name as $repository |
        ($repositories[0].archive | index($repository)) == null)
    ) and
    ([.repositories[].id] as $ids |
      ($ids | length) == ($ids | unique | length)) and
    ([.repositories[].name] as $names |
      ($names | length) == ($names | unique | length) and
      $names == ($names | sort))
  ' "${immutable_releases_config}" >/dev/null

jq -e '
  .code_scanning_default_setup == "enabled" and
  .code_scanning_options == {allow_advanced: false} and
  .enforcement == "enforced"
' "${root}/config/code-security.json" >/dev/null

jq -e \
  --slurpfile baseline "${root}/config/code-security.json" '
    .name == "Atrinik advanced CodeQL baseline" and
    (.description | type == "string" and length > 0) and
    .code_scanning_default_setup == "enabled" and
    .code_scanning_options == {allow_advanced: true} and
    .enforcement == "enforced" and
    (
      del(.name, .description, .code_scanning_options) ==
      ($baseline[0] | del(.name, .description, .code_scanning_options))
    )
  ' "${root}/config/code-security-advanced.json" >/dev/null

jq -e '. == {state: "configured", query_suite: "default"}' \
  "${root}/config/codeql-default-setup.json" >/dev/null

jq -e '. == {state: "not-configured"}' \
  "${root}/config/codeql-default-setup-advanced.json" >/dev/null

jq -e '
  (keys == [
    "codecov_github_app_repositories",
    "github_actions_apps",
    "github_actions_credentials",
    "github_actions_environments",
    "github_packages_actions_access",
    "members_can_change_repository_visibility",
    "members_can_create_teams",
    "members_can_delete_or_transfer_repositories",
    "members_can_request_github_apps",
    "organization_pins",
    "reason",
    "repository_admins_can_install_github_apps",
    "require_secure_two_factor_methods",
    "require_two_factor_authentication"
  ])
' "${manual_settings_config}" >/dev/null

jq -e \
  --arg today "${validation_today}" \
  --slurpfile repositories "${repositories_config}" '
  def day_epoch($value):
    ($value + "T00:00:00Z" | fromdateiso8601);
  def valid_day($value):
    ($value | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) and
    (try ((day_epoch($value) | strftime("%Y-%m-%d")) == $value) catch false);
  .github_actions_apps as $apps |
  ($apps | type == "array" and length > 0) and
  ([$apps[].app_id] | length == (unique | length)) and
  ([$apps[].installation_id] | length == (unique | length)) and
  (
    [$apps[] | [.repository, .secret_scope, .secret_name]] |
    length == (unique | length)
  ) and
  (
    [$apps[] | [.repository, .variable_scope, .variable_name]] |
    length == (unique | length)
  ) and
  all(
    $apps[];
    (keys == [
      "app_id",
      "app_slug",
      "consumers",
      "events",
      "installation_id",
      "last_verified_on",
      "owner",
      "permissions",
      "purpose",
      "repository",
      "repository_id",
      "repository_scope_verification",
      "repository_selection",
      "rotate_by",
      "rotation_cadence_days",
      "rotation_owner",
      "runbook",
      "secret_name",
      "secret_scope",
      "variable_name",
      "variable_scope"
    ]) and
    (.app_id | type == "number" and floor == . and . > 0) and
    (
      .app_slug |
      type == "string" and
      test("^[a-z0-9]+(?:-[a-z0-9]+)*$")
    ) and
    (.installation_id | type == "number" and floor == . and . > 0) and
    .repository_selection == "selected" and
    .repository_scope_verification == "organization_owner_ui" and
    .events == [] and
    .permissions == {
      contents: "write",
      metadata: "read",
      pull_requests: "write"
    } and
    (
      .repository |
      type == "string" and
      test("^atrinik/[A-Za-z0-9_.-]+$")
    ) and
    (
      .repository as $full_name |
      ($full_name | split("/")[1]) as $repository |
      ($repositories[0].pull_request_gate | index($repository)) != null and
      ($repositories[0].archive | index($repository)) == null
    ) and
    (.repository_id | type == "number" and floor == . and . > 0) and
    .secret_scope == "repository" and
    .variable_scope == "repository" and
    (.secret_name | type == "string" and test("^[A-Z][A-Z0-9_]*$")) and
    (.variable_name | type == "string" and test("^[A-Z][A-Z0-9_]*$")) and
    .secret_name != .variable_name and
    (
      .consumers |
      type == "array" and
      length > 0 and
      . == (sort | unique) and
      all(
        .[];
        type == "string" and
        test("^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$")
      )
    ) and
    (.purpose | type == "string" and length > 0) and
    (.owner | type == "string" and length > 0) and
    (.rotation_owner | type == "string" and length > 0) and
    (
      .rotation_cadence_days |
      type == "number" and floor == . and . >= 1 and . <= 365
    ) and
    valid_day(.last_verified_on) and
    valid_day(.rotate_by) and
    (day_epoch(.last_verified_on) <= day_epoch($today)) and
    (day_epoch(.rotate_by) >= day_epoch($today)) and
    (day_epoch(.rotate_by) > day_epoch(.last_verified_on)) and
    (
      (day_epoch(.rotate_by) - day_epoch(.last_verified_on)) / 86400 <=
      .rotation_cadence_days
    ) and
    (
      .runbook |
      type == "string" and
      test("^[A-Za-z0-9._/-]+\\.md#[a-z0-9-]+$")
    )
  ) and
  all(
    $apps[];
    . as $app |
    all(
      $apps[];
      .repository != $app.repository or
      .repository_id == $app.repository_id
    )
  )
' "${manual_settings_config}" >/dev/null

jq -e '
  .organization_pins as $pins |
  ($pins | keys == ["apply_path", "repositories", "verification"]) and
  $pins.apply_path == "https://github.com/atrinik" and
  $pins.verification == "read_only_graphql" and
  ($pins.repositories | type == "array" and length == 6) and
  [$pins.repositories[].name] == [
    "classic",
    "atrinik",
    "website",
    "content",
    "protocol",
    "playtester"
  ] and
  ([ $pins.repositories[].repository_id ] | length == (unique | length)) and
  all(
    $pins.repositories[];
    (keys == ["name", "repository_id"]) and
    (.name | type == "string" and length > 0) and
    (.repository_id | type == "number" and floor == . and . > 0)
  )
' "${manual_settings_config}" >/dev/null

jq -e \
  --arg today "${validation_today}" \
  --slurpfile repositories "${repositories_config}" '
  def day_epoch($value):
    ($value + "T00:00:00Z" | fromdateiso8601);
  def valid_day($value):
    ($value | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")) and
    (try ((day_epoch($value) | strftime("%Y-%m-%d")) == $value) catch false);
  .github_actions_credentials as $credentials |
  ($credentials | type == "array" and length > 0) and
  (
    [$credentials[] | [.repository, .secret_scope, .secret_name]] |
    length == (unique | length)
  ) and
  all(
    $credentials[];
    (keys == [
      "consumers",
      "credential_type",
      "last_verified_on",
      "owner",
      "purpose",
      "repository",
      "repository_id",
      "required_scopes",
      "rotate_by",
      "rotation_cadence_days",
      "rotation_owner",
      "runbook",
      "secret_name",
      "secret_scope"
    ]) and
    .credential_type == "classic_pat" and
    .secret_scope == "repository" and
    (
      .repository |
      type == "string" and
      test("^atrinik/[A-Za-z0-9_.-]+$")
    ) and
    (
      .repository as $full_name |
      ($full_name | split("/")[1]) as $repository |
      ($repositories[0].pull_request_gate | index($repository)) != null and
      ($repositories[0].archive | index($repository)) == null
    ) and
    (.repository_id | type == "number" and . > 0 and floor == .) and
    (.secret_name | type == "string" and test("^[A-Z][A-Z0-9_]*$")) and
    (
      .required_scopes |
      . == ["admin:org", "project", "repo"]
    ) and
    (
      .consumers |
      type == "array" and
      length > 0 and
      . == (sort | unique) and
      all(
        .[];
        type == "string" and
        test("^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$")
      )
    ) and
    (.purpose | type == "string" and length > 0) and
    (.owner | type == "string" and length > 0) and
    (.rotation_owner | type == "string" and length > 0) and
    (
      .rotation_cadence_days |
      type == "number" and floor == . and . >= 1 and . <= 365
    ) and
    valid_day(.last_verified_on) and
    valid_day(.rotate_by) and
    (day_epoch(.last_verified_on) <= day_epoch($today)) and
    (day_epoch(.rotate_by) >= day_epoch($today)) and
    (day_epoch(.rotate_by) > day_epoch(.last_verified_on)) and
    (
      (day_epoch(.rotate_by) - day_epoch(.last_verified_on)) / 86400 <=
      .rotation_cadence_days
    ) and
    (
      .runbook |
      type == "string" and
      test("^[A-Za-z0-9._/-]+\\.md#[a-z0-9-]+$")
    )
  ) and
  all(
    $credentials[];
    . as $credential |
    all(
      $credentials[];
      .repository != $credential.repository or
      .repository_id == $credential.repository_id
    )
  )
' "${manual_settings_config}" >/dev/null

while IFS= read -r consumer; do
  if [[ ! -f ${root}/${consumer} ]]; then
    echo "error: credential consumer workflow is missing: ${consumer}" >&2
    exit 1
  fi
done < <(jq -r '.github_actions_credentials[].consumers[]' \
  "${manual_settings_config}")

jq -e '
  .github_packages_actions_access as $access |
  ($access | type == "array") and
  (
    [$access[] |
      [.package_owner, .package_type, .package_name, .actions_repository]] |
    length
  ) == (
    [$access[] |
      [.package_owner, .package_type, .package_name, .actions_repository]] |
    unique | length
  ) and
  all(
    $access[];
    (keys == [
      "actions_repository",
      "actions_repository_id",
      "package_id",
      "package_name",
      "package_owner",
      "package_type",
      "preserve_visibility",
      "role"
    ]) and
    (.package_owner | type == "string" and length > 0) and
    (.package_type | type == "string" and length > 0) and
    (.package_name | type == "string" and length > 0) and
    (.package_id | type == "number" and . > 0 and floor == .) and
    (.preserve_visibility | IN("private", "internal", "public")) and
    (
      .actions_repository |
      type == "string" and
      test("^[^/[:space:]]+/[^/[:space:]]+$")
    ) and
    (
      .actions_repository_id |
      type == "number" and . > 0 and floor == .
    ) and
    (.role == "read")
  )
' "${manual_settings_config}" >/dev/null

jq -e \
  --slurpfile repositories "${repositories_config}" '
  .github_actions_environments as $environments |
  ($environments | type == "array") and
  (
    [$environments[] | [.repository, .environment]] |
    length == (unique | length)
  ) and
  all(
    $environments[];
    (keys == [
      "deployment_branch_policy",
      "environment",
      "repository",
      "repository_id",
      "required_reviewers",
      "secret_names",
      "variable_names"
    ]) and
    (
      .repository |
      type == "string" and
      test("^atrinik/[A-Za-z0-9_.-]+$")
    ) and
    (
      .repository as $full_name |
      ($full_name | split("/")[1]) as $repository |
      ($repositories[0].pull_request_gate | index($repository)) != null and
      ($repositories[0].archive | index($repository)) == null
    ) and
    (.repository_id | type == "number" and . > 0 and floor == .) and
    (
      .environment |
      type == "string" and
      length <= 255 and
      test("^[a-z0-9][a-z0-9-]*[a-z0-9]$")
    ) and
    (.required_reviewers == []) and
    (
      .deployment_branch_policy |
      (keys == [
        "custom_branch_policies",
        "patterns",
        "protected_branches"
      ]) and
      .custom_branch_policies == true and
      .protected_branches == false and
      (.patterns | type == "array" and length > 0) and
      ([.patterns[] | [.type, .name]] | length == (unique | length)) and
      all(
        .patterns[];
        (keys == ["name", "type"]) and
        (
          (
            .type == "branch" and
            (.name | type == "string" and test("^[A-Za-z0-9._/-]+$"))
          ) or
          (
            .type == "tag" and
            .name == "v*"
          )
        )
      )
    ) and
    (
      .variable_names |
      type == "array" and
      length == (unique | length) and
      all(.[]; type == "string" and test("^[A-Z][A-Z0-9_]*$"))
    ) and
    (
      .secret_names |
      type == "array" and
      length > 0 and
      length == (unique | length) and
      all(.[]; type == "string" and test("^[A-Z][A-Z0-9_]*$"))
    ) and
    (
      .variable_names as $variables |
      all(.secret_names[]; . as $secret | ($variables | index($secret)) == null)
    )
  ) and
  all(
    $environments[];
    . as $environment |
    all(
      $environments[];
      .repository != $environment.repository or
      .repository_id == $environment.repository_id
    )
  )
' "${manual_settings_config}" >/dev/null

jq -e '
  (keys == [
    "issue_fields",
    "issue_types",
    "personal_saved_views",
    "project",
    "type_inference"
  ]) and
  (.project | keys == [
    "public",
    "readme",
    "short_description",
    "statuses",
    "title",
    "triage_cutover",
    "views"
  ]) and
  (.project.title | type == "string" and length > 0) and
  (.project.short_description | type == "string" and length > 0) and
  (.project.readme | type == "string" and length > 0) and
  (.project.public | type == "boolean") and
  (.project.triage_cutover | fromdateiso8601 | type == "number") and
  (.project.statuses | type == "array" and length >= 3) and
  ([.project.statuses[].name] | length == (unique | length)) and
  all(
    .project.statuses[];
    (keys == ["color", "description", "name", "previous_names"]) and
    (.name | type == "string" and length > 0) and
    (.description | type == "string" and length > 0) and
    (.color | IN(
      "BLUE", "GRAY", "GREEN", "ORANGE", "PINK", "PURPLE", "RED", "YELLOW"
    )) and
    (.previous_names | type == "array") and
    ((.previous_names | length) == (.previous_names | unique | length)) and
    all(.previous_names[]; type == "string" and length > 0)
  ) and
  ([.project.statuses[].previous_names[]] as $previous |
    ($previous | length) == ($previous | unique | length)) and
  ([.project.statuses[].name] as $status_names |
    all(
      .project.statuses[].previous_names[];
      . as $previous_name |
      ($status_names | index($previous_name)) == null
    )) and
  ([.project.statuses[].name] | index("Inbox") != null) and
  ([.project.statuses[].name] | index("Backlog") != null) and
  ([.project.statuses[].name] | index("Review") != null) and
  ([.project.statuses[].name] | index("Done") != null) and
  (.project.views | type == "array" and length > 0) and
  ([.project.views[].name] | length == (unique | length)) and
  all(
    .project.views[];
    (keys == ["filter", "layout", "name", "visible_fields"]) and
    (.name | type == "string" and length > 0) and
    (.layout | IN("BOARD_LAYOUT", "ROADMAP_LAYOUT", "TABLE_LAYOUT")) and
    (.filter | type == "string") and
    (.visible_fields | type == "array") and
    (if .layout == "ROADMAP_LAYOUT" then
       (.visible_fields | length == 0)
     else
       (.visible_fields | length > 0)
     end) and
    ((.visible_fields | length) == (.visible_fields | unique | length)) and
    all(.visible_fields[]; type == "string" and length > 0)
  ) and
  (.issue_types | type == "array" and length > 0) and
  ([.issue_types[].name] | length == (unique | length)) and
  all(
    .issue_types[];
    (keys == ["color", "description", "enabled", "name"]) and
    (.name | type == "string" and length > 0) and
    (.description | type == "string" and length > 0) and
    (.color | IN("BLUE", "GRAY", "GREEN", "ORANGE", "PINK", "PURPLE", "RED", "YELLOW")) and
    (.enabled | type == "boolean")
  ) and
  (.issue_fields | type == "array" and length > 0) and
  ([.issue_fields[].name] | length == (unique | length)) and
  all(
    .issue_fields[];
    (.name | type == "string" and length > 0) and
    (.description | type == "string" and length > 0) and
    (.data_type | IN("DATE", "MULTI_SELECT", "NUMBER", "SINGLE_SELECT", "TEXT")) and
    (.visibility | IN("ALL", "ORG_ONLY")) and
    if (.data_type | IN("MULTI_SELECT", "SINGLE_SELECT")) then
      (keys == ["data_type", "description", "name", "options", "visibility"]) and
      (.options | type == "array" and length > 0) and
      ([.options[].name] | length == (unique | length)) and
      all(
        .options[];
        (keys == ["color", "description", "name"]) and
        (.name | type == "string" and length > 0) and
        (.description == null or
          (.description | type == "string" and length > 0)) and
        (.color | IN("BLUE", "GRAY", "GREEN", "ORANGE", "PINK", "PURPLE", "RED", "YELLOW"))
      )
    else
      (keys == ["data_type", "description", "name", "visibility"])
    end
  ) and
  ([.issue_types[].name] as $type_names |
    (.type_inference | keys == [
      "bug_labels", "default", "feature_labels", "initiative_when_parent"
    ]) and
    (.type_inference.initiative_when_parent | type == "boolean") and
    (.type_inference.default as $name | ($type_names | index($name)) != null) and
    all(.type_inference.bug_labels[]; type == "string" and length > 0) and
    all(.type_inference.feature_labels[]; type == "string" and length > 0) and
    ((.type_inference.bug_labels + .type_inference.feature_labels) |
      length == (unique | length))) and
  (.personal_saved_views | type == "array" and length > 0) and
  ([.personal_saved_views[].name] | length == (unique | length)) and
  all(
    .personal_saved_views[];
    (keys == ["name", "query"]) and
    (.name | type == "string" and length > 0) and
    (.query | type == "string" and startswith("org:atrinik "))
  )
' "${planning_config}" >/dev/null

jq -e '
  (keys == [
    "consecutive_failure_threshold",
    "freshness_threshold_minutes",
    "incident_actor",
    "incident_marker",
    "incident_title",
    "monitor_workflow",
    "monitoring_owner",
    "repository",
    "sync_workflow"
  ]) and
  (
    .consecutive_failure_threshold |
    type == "number" and floor == . and . >= 2 and . <= 10
  ) and
  (
    .freshness_threshold_minutes |
    type == "number" and floor == . and . >= 60 and . <= 1440
  ) and
  .incident_actor == "github-actions[bot]" and
  .incident_marker == "<!-- atrinik-project-sync-health -->" and
  (.incident_title | type == "string" and length > 0 and length <= 120) and
  (
    .monitor_workflow |
    type == "string" and test("^[A-Za-z0-9_.-]+\\.ya?ml$")
  ) and
  (.monitoring_owner | type == "string" and length > 0) and
  .repository == "atrinik/github-settings" and
  (
    .sync_workflow |
    type == "string" and test("^[A-Za-z0-9_.-]+\\.ya?ml$")
  )
' "${planning_health_config}" >/dev/null

for workflow in $(jq -r '.monitor_workflow, .sync_workflow' \
  "${planning_health_config}"); do
  if [[ ! -f ${root}/.github/workflows/${workflow} ]]; then
    echo "error: planning health workflow is missing: ${workflow}" >&2
    exit 1
  fi
done

jq -e \
  --slurpfile repositories "${repositories_config}" '
    . as $config |
    ([".github"] + $repositories[0].pull_request_gate + $repositories[0].archive |
      sort | unique) as $expected_repositories |
    ($config.definitions |
      map({key: .property_name, value: .}) | from_entries) as $definitions |
    ($config | keys == ["definitions", "repositories"]) and
    ($config.definitions | type == "array" and length > 0) and
    ([$config.definitions[].property_name] | length == (unique | length)) and
    all(
      $config.definitions[];
      . as $definition |
      (keys == [
        "allowed_values",
        "default_value",
        "description",
        "property_name",
        "required",
        "value_type"
      ]) and
      (.property_name | type == "string" and test("^[a-z][a-z0-9_]*$")) and
      (.description | type == "string" and length > 0) and
      (.value_type | IN("multi_select", "single_select")) and
      (.required == true) and
      (.allowed_values | type == "array" and length > 0) and
      (.allowed_values == (.allowed_values | sort | unique)) and
      all(.allowed_values[]; type == "string" and length > 0) and
      if $definition.value_type == "multi_select" then
        ($definition.default_value | type == "array" and length > 0) and
        ($definition.default_value ==
          ($definition.default_value | sort | unique)) and
        all(
          $definition.default_value[];
          . as $value |
          ($definition.allowed_values | index($value)) != null
        )
      else
        ($definition.default_value | type == "string") and
        ($definition.default_value as $value |
          ($definition.allowed_values | index($value)) != null)
      end
    ) and
    ($config.repositories | keys) == $expected_repositories and
    all(
      $config.repositories | to_entries[];
      (.value | keys) == ($definitions | keys) and
      all(
        .value | to_entries[];
        .key as $name |
        $definitions[$name] as $definition |
        if $definition.value_type == "multi_select" then
          (.value | type == "array" and length > 0) and
          (.value == (.value | sort | unique)) and
          all(.value[]; . as $value | ($definition.allowed_values | index($value)) != null)
        else
          (.value | type == "string") and
          (.value as $value | ($definition.allowed_values | index($value)) != null)
        end
      )
    ) and
    all(
      $repositories[0].archive[];
      . as $repository |
      $config.repositories[$repository].lifecycle == "archived" and
      $config.repositories[$repository].release_policy == "none"
    ) and
    all(
      $repositories[0].pull_request_gate[];
      . as $repository |
      $config.repositories[$repository].lifecycle != "archived" and
      $config.repositories[$repository].release_policy == "semantic-release"
    ) and
    $config.repositories[".github"] == {
      component_role: ["governance"],
      provider_set: ["organization"],
      lifecycle: "active",
      release_policy: "none"
    }
  ' "${repository_properties_config}" >/dev/null

jq -e '
  (keys == ["files", "repository"]) and
  (.repository == {
    name: ".github",
    description: "Atrinik organization-wide community health defaults",
    private: false,
    has_issues: false,
    has_projects: false,
    has_wiki: false
  }) and
  (.files | type == "array" and length > 0) and
  any(
    .files[];
    . == {source: "profile/README.md", target: "profile/README.md"}
  ) and
  ([.files[].source] | length == (unique | length)) and
  ([.files[].target] | length == (unique | length)) and
  all(
    .files[];
    (keys == ["source", "target"]) and
    (.source | type == "string" and length > 0 and startswith("/") | not) and
    (.target | type == "string" and length > 0 and startswith("/") | not) and
    (.source | contains("..") | not) and
    (.target | contains("..") | not)
  )
' "${community_health_config}" >/dev/null

while IFS= read -r community_file; do
  if [[ ! -s ${root}/community-health/${community_file} ]]; then
    echo "error: missing community-health source file: ${community_file}" >&2
    exit 1
  fi
done < <(jq -r '.files[].source' "${community_health_config}")

profile_readme=${root}/community-health/profile/README.md
for required_text in \
  '# Atrinik' \
  'Atrinik is an open-source cooperative fantasy role-playing world' \
  'GPL-licensed [Atrinik Classic](https://github.com/atrinik/classic)' \
  'next-generation MIT' \
  'They do not yet form a complete game release.' \
  'Game content and' \
  'media remain separately licensed' \
  'historical MIT provenance registry' \
  'exact, independently separable' \
  'copy it, migrate or port it, translate or adapt it, or' \
  'each selected contribution' \
  "applicable named grantor's original work" \
  'solely authored by that grantor' \
  "row's temporal scope" \
  'only when each independently' \
  'satisfies one row' \
  'jointly authored' \
  'contributions, generated output, or' \
  'inseparable mixed work' \
  'does not relicense the source' \
  'repositories or by itself' \
  'GPL dependency, link, or bundle' \
  '[Play Atrinik Classic](https://atrinik.org/downloads/)' \
  '[Follow the next-generation roadmap](https://github.com/atrinik/atrinik/issues/168)' \
  'Direct human contributions are welcome.'; do
  if ! grep -Fq "${required_text}" "${profile_readme}"; then
    echo "error: organization profile is missing required text: ${required_text}" >&2
    exit 1
  fi
done

validate_issue_form() {
  local form_name=$1
  local inference_key=$2
  local inferred_type=$3
  local form_file labels_json

  form_file=${root}/community-health/.github/ISSUE_TEMPLATE/${form_name}.yml
  if grep -Eq '^(title|type)[[:space:]]*:' "${form_file}"; then
    echo "error: ${form_name} issue form uses live-validator-incompatible title or type metadata" >&2
    exit 1
  fi

  if [[ -z ${inference_key} ]]; then
    if grep -Eq '^labels[[:space:]]*:' "${form_file}"; then
      echo "error: ${form_name} issue form must remain unlabeled for default type inference" >&2
      exit 1
    fi
    if ! jq -e --arg inferred_type "${inferred_type}" '
      .type_inference.default == $inferred_type and
      any(.issue_types[]; .name == $inferred_type and .enabled)
    ' "${planning_config}" >/dev/null; then
      echo "error: ${form_name} issue form default type inference is unavailable" >&2
      exit 1
    fi
    return
  fi

  if [[ $(grep -Ec '^labels[[:space:]]*:' "${form_file}") -ne 1 ]]; then
    echo "error: ${form_name} issue form must declare one inline labels array" >&2
    exit 1
  fi
  labels_json=$(sed -n 's/^labels[[:space:]]*:[[:space:]]*//p' "${form_file}")
  if ! jq -e '
    type == "array" and
    length > 0 and
    length == (unique | length) and
    all(.[]; type == "string" and length > 0)
  ' <<<"${labels_json}" >/dev/null; then
    echo "error: ${form_name} issue form labels must be a non-empty JSON-style array" >&2
    exit 1
  fi
  if ! jq -e \
    --arg inference_key "${inference_key}" \
    --arg inferred_type "${inferred_type}" \
    --argjson form_labels "${labels_json}" '
      any(.issue_types[]; .name == $inferred_type and .enabled) and
      (
        ($form_labels | map(ascii_downcase)) as $labels |
        (.type_inference[$inference_key] | map(ascii_downcase)) as $inference_labels |
        any($labels[]; . as $label | ($inference_labels | index($label)) != null)
      )
    ' "${planning_config}" >/dev/null; then
    echo "error: ${form_name} issue form labels do not infer enabled type ${inferred_type}" >&2
    exit 1
  fi
}

# GitHub's live community-health renderer currently rejects direct issue-form
# type metadata. Labels retain Bug and Feature inference; Task is the fallback.
validate_issue_form bug bug_labels Bug
validate_issue_form feature feature_labels Feature
validate_issue_form task "" Task

while IFS= read -r branch; do
  if ! git check-ref-format --branch "${branch}" >/dev/null; then
    echo "error: invalid maintenance branch name: ${branch}" >&2
    exit 1
  fi
done < <(jq -r '.maintenance_branches[].branch' "${repositories_config}")

echo "Governance configuration is valid."
