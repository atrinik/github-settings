#!/usr/bin/env bash

set -euo pipefail

organization=${ATRINIK_ORGANIZATION:-atrinik}
api_version=2026-03-10

for command in gh grep jq sort; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
repositories_config=${root}/config/repositories.json
repository_defaults=${root}/config/repository-defaults.json
repository_properties=${root}/config/repository-properties.json
advisory_windows=${root}/config/advisory-merge-windows.json
temporary=$(mktemp -d)
trap 'rm -rf "${temporary}"' EXIT

"${root}/bin/validate" >/dev/null

github_api() {
  gh api --method GET -H "X-GitHub-Api-Version: ${api_version}" "$@"
}

declare -a findings=()
declare -a pending=()
declare -A ruleset_cache=()

record_finding() {
  findings+=("$1")
}

is_temporary_security_advisory_repository() {
  local repository=$1
  local private=$2
  local visibility=$3
  local disabled=$4
  local fork=$5
  local has_issues=$6
  local has_projects=$7
  local has_wiki=$8
  local base_repository

  if [[ ${repository} =~ ^(.+)-ghsa-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$ ]]; then
    base_repository=${BASH_REMATCH[1]}
  else
    return 1
  fi

  [[ ${private} == true ]] &&
    [[ ${visibility} == private ]] &&
    [[ ${disabled} == false ]] &&
    [[ ${fork} == false ]] &&
    [[ ${has_issues} == false ]] &&
    [[ ${has_projects} == false ]] &&
    [[ ${has_wiki} == false ]] &&
    jq -e --arg repository "${base_repository}" \
      '(.pull_request_gate | index($repository)) != null' \
      "${repositories_config}" >/dev/null
}

# Capture before parsing: process substitutions otherwise hide API failures.
if ! github_api --paginate --slurp "orgs/${organization}/repos?per_page=100&type=all" |
  jq -e 'add | if type == "array" then . else error("invalid inventory") end' \
    >"${temporary}/inventory.json"; then
  echo "error: organization repository inventory could not be read" >&2
  exit 1
fi

declare -A live_archived=()
while IFS=$'\t' read -r \
  repository archived private visibility disabled fork has_issues has_projects has_wiki; do
  [[ -n ${repository} ]] || continue
  if is_temporary_security_advisory_repository \
    "${repository}" "${private}" "${visibility}" "${disabled}" "${fork}" \
    "${has_issues}" "${has_projects}" "${has_wiki}"; then
    continue
  fi
  live_archived["${repository}"]=${archived}
done < <(jq -r '
  .[] | [.name, (.archived | tostring), (.private | tostring), .visibility,
    (.disabled | tostring), (.fork | tostring), (.has_issues | tostring),
    (.has_projects | tostring), (.has_wiki | tostring)] | @tsv
' "${temporary}/inventory.json")

declare -A expected_active=()
declare -A expected_archived=()
while IFS=$'\t' read -r repository lifecycle; do
  if [[ ${lifecycle} == archived ]]; then
    expected_archived["${repository}"]=true
  else
    expected_active["${repository}"]=true
  fi
done < <(
  jq -r '.repositories | to_entries[] | [.key, .value.lifecycle] | @tsv' \
    "${repository_properties}"
)

desired_property_schema=$(jq -c '
  .definitions |
  map({property_name, value_type, required, default_value, description, allowed_values}) |
  sort_by(.property_name)
' "${repository_properties}")
if current_property_schema=$(github_api \
  "orgs/${organization}/properties/schema" | \
  jq -c 'map({property_name, value_type, required, default_value, description, allowed_values}) | sort_by(.property_name)'); then
  if [[ ${current_property_schema} != "${desired_property_schema}" ]]; then
    record_finding "organization custom-property schema drift: ${organization}"
  fi
else
  record_finding "organization custom-property schema could not be read: ${organization}"
fi

for repository in "${!live_archived[@]}"; do
  if [[ ${live_archived["${repository}"]} == false ]] &&
    [[ ! -v expected_active["${repository}"] ]]; then
    record_finding "active repository is not in the desired-state inventory: ${organization}/${repository}"
  fi
done

for repository in "${!expected_active[@]}"; do
  if [[ ! -v live_archived["${repository}"] ]]; then
    record_finding "governed active repository is missing: ${organization}/${repository}"
  elif [[ ${live_archived["${repository}"]} != false ]]; then
    record_finding "governed active repository is archived: ${organization}/${repository}"
  fi
done

for repository in "${!expected_archived[@]}"; do
  if [[ -v live_archived["${repository}"] ]] &&
    [[ ${live_archived["${repository}"]} != true ]]; then
    record_finding "archived inventory repository is not archived: ${organization}/${repository}"
  fi
done

has_configured_repository() {
  local property=$1
  local repository=$2

  jq -e --arg repository "${repository}" \
    "${property} | index(\$repository) != null" "${repositories_config}" \
    >/dev/null
}

has_required_ci() {
  local repository=$1
  jq -e --arg repository "${repository}" \
    '.required_ci | has($repository)' "${repositories_config}" >/dev/null
}

has_release_tags() {
  local repository=$1
  jq -e --arg repository "${repository}" \
    '.release_tags | index($repository) != null' "${repositories_config}" \
    >/dev/null
}

audit_actions() {
  local current
  for policy in permissions selected-actions workflow; do
    local endpoint="orgs/${organization}/actions/permissions"
    local config="${root}/config/actions-permissions.json"
    case ${policy} in
      selected-actions) endpoint+=/selected-actions; config="${root}/config/actions-selected.json" ;;
      workflow) endpoint+=/workflow; config="${root}/config/actions-workflow.json" ;;
    esac
    if ! current=$(github_api "${endpoint}"); then
      record_finding "organization Actions ${policy} could not be read: ${organization}"
      continue
    fi
    if ! jq -e --slurpfile desired "${config}" '
      . as $current | $desired[0] | to_entries | all(.[];
        if .key == "sha_pinning_required" then true
        elif .key == "patterns_allowed" then
          (.value | sort) == ($current.patterns_allowed | sort)
        else $current[.key] == .value end)
    ' <<<"${current}" >/dev/null; then
      record_finding "organization Actions ${policy} drift: ${organization}"
    fi
    if [[ ${policy} == permissions ]] &&
      jq -e '.sha_pinning_required == true' "${config}" >/dev/null; then
      case $(jq -r '.sha_pinning_required | if type == "boolean" then tostring else "unreadable" end' <<<"${current}") in
        true) ;;
        false)
          case $(jq -r '.phase' "${root}/config/actions-sha-pinning.json") in
            pending) pending+=("Actions SHA pinning deferred pending canary proof: ${organization}") ;;
            enforced) record_finding "Actions SHA pinning enforcement drift: ${organization}" ;;
            *) record_finding "Actions SHA pinning rollout phase could not be read: ${organization}" ;;
          esac
          ;;
        *) record_finding "Actions SHA pinning state could not be read: ${organization}" ;;
      esac
    fi
  done
}

audit_actions

# The branch endpoint proves effective applicability; inherited names alone do not.
# Details additionally prove bypass and ref/repository scope, including tag policy.
# Match the entire publisher-owned repository scope. Being included in a wider
# scope does not prove convergence: a widened tag rule can constrain services
# with no release contract. Repository-level rulesets have only ref conditions.
organization_ruleset_scope() {
  local name=$1 repository=$2
  jq -cn --arg name "${name}" --arg repository "${repository}" \
    --slurpfile repositories "${repositories_config}" \
    --slurpfile windows "${advisory_windows}" '
    {include: [], exclude: [], protected: false} |
    if $name == "01 - Default branch integrity" or
      $name == "01 - Default branch linear history" then
      .include = ["~ALL"] | .exclude = $windows[0].repositories
    elif $name == "01 - Default branch integrity - classic" or
      $name == "01 - Default branch linear history - classic" or
      $name == "02 - Changes through pull requests - classic" then
      .include = ["classic"]
    elif $name == "02 - Changes through pull requests" then
      .include = ($repositories[0].pull_request_gate - $windows[0].repositories)
    elif ($name | startswith("03 - Required CI - ")) then
      .include = [$repository]
    elif $name == "04 - Immutable release tags" then
      .include = $repositories[0].release_tags
    else error("unknown managed ruleset scope") end'
}

ruleset_normalization='
# Omitted request fields are expanded by GitHub to these exact defaults.
# Preserve nondefault, malformed and unknown fields as observable drift.
def normalize_rules:
  map(if .type == "pull_request" then
    .parameters |= (
      if .required_reviewers == [] then del(.required_reviewers) else . end |
      if .require_extra_approval_for_unattributed_changes == true then
        del(.require_extra_approval_for_unattributed_changes) else . end |
      if (.allowed_merge_methods | type) == "array" and
        (.allowed_merge_methods | sort) == ["merge", "rebase", "squash"] then
        del(.allowed_merge_methods) else . end)
  elif .type == "required_status_checks" then
    .parameters |= (
      if .do_not_enforce_on_create == false then del(.do_not_enforce_on_create) else . end |
      .required_status_checks |= sort_by(.context, .integration_id))
  else . end) | sort_by(.type);
'

check_ruleset() {
  local repository=$1 name=$2 template=$3 list=$4
  local entry id source endpoint detail wanted scope
  entry=$(jq -c --arg name "${name}" '[.[] | select(.name == $name)]' <<<"${list}")
  if [[ $(jq length <<<"${entry}") != 1 ]]; then
    record_finding "missing or duplicate inherited ruleset '${name}': ${organization}/${repository}"
    return
  fi
  id=$(jq -r '.[0].id' <<<"${entry}")
  source=$(jq -r '.[0].source_type' <<<"${entry}")
  if [[ ${name} == '06 - CodeQL security' || ${name} == '07 - Dependency review' ]] &&
    [[ ${source} != Repository ]]; then
    record_finding "managed security ruleset must be repository-owned '${name}': ${organization}/${repository}"
    return
  fi
  case ${source} in
    Organization) endpoint="orgs/${organization}/rulesets/${id}" ;;
    Repository) endpoint="repos/${organization}/${repository}/rulesets/${id}" ;;
    *) record_finding "ruleset source could not be read '${name}': ${organization}/${repository}"; return ;;
  esac
  if [[ ${name} == '04 - Immutable release tags' && ${source} == Repository ]] &&
    ! has_release_tags "${repository}"; then
    record_finding "unexpected managed release-tag protection: ${organization}/${repository}"
    return
  fi
  if [[ ! -v ruleset_cache["${endpoint}"] ]]; then
    if ! detail=$(github_api "${endpoint}"); then
      record_finding "ruleset contents could not be read '${name}': ${organization}/${repository}"
      return
    fi
    ruleset_cache["${endpoint}"]=${detail}
  fi
  detail=${ruleset_cache["${endpoint}"]}
  wanted=$(cat "${template}")
  if [[ ${name} == '03 - Required CI - '* ]]; then
    wanted=$(jq --argjson checks "${expected_checks}" \
      '.rules[0].parameters.required_status_checks = $checks' <<<"${wanted}")
    # Dependency review is governed by its separate rollout ruleset.
    wanted=$(jq '.rules[0].parameters.required_status_checks |= map(select(.context != "Dependency review"))' <<<"${wanted}")
  fi
  if jq -e --arg repository "${repository}" '.repositories | index($repository) != null' \
    "${advisory_windows}" >/dev/null && [[ ${name} == '03 - Required CI - '* ]]; then
    wanted=$(jq '.bypass_actors[].bypass_mode = "always"' <<<"${wanted}")
  fi
  if [[ ${source} == Organization ]]; then
    scope=$(organization_ruleset_scope "${name}" "${repository}")
    wanted=$(jq --argjson scope "${scope}" '.conditions.repository_name = $scope' <<<"${wanted}")
  fi
  if ! jq -e --argjson wanted "${wanted}" "${ruleset_normalization}"'
      # GitHub returns null for OrganizationAdmin, whose desired actor ID is 1.
      def normalize_bypass:
        map(if .actor_type == "OrganizationAdmin" and .actor_id == null then
          .actor_id = 1 else . end) | sort_by(.actor_type, .actor_id, .bypass_mode);
      def normalize_conditions:
        with_entries(if .key == "ref_name" or .key == "repository_name" then
          .value.include |= sort | .value.exclude |= sort else . end);
      .enforcement == $wanted.enforcement and .target == $wanted.target and
      (.bypass_actors | normalize_bypass) == ($wanted.bypass_actors | normalize_bypass) and
      (.conditions | normalize_conditions) == ($wanted.conditions | normalize_conditions) and
      (.rules | normalize_rules) == ($wanted.rules | normalize_rules)
    ' <<<"${detail}" >/dev/null; then
    record_finding "ruleset scope or policy drift '${name}': ${organization}/${repository}"
  fi
}

# Rulesets are the declared protection contract in both publisher scopes.
# Legacy protection layers additional requirements outside the rules endpoint;
# retain it for manual review rather than silently treating rulesets as complete.
audit_legacy_protection() {
  local repository=$1 branch=$2 encoded response status=0 body
  encoded=$(jq -rn --arg branch "${branch}" '$branch | @uri')
  response=$(github_api --include \
    "repos/${organization}/${repository}/branches/${encoded}/protection" \
    2>"${temporary}/legacy-protection.err") || status=$?
  response=${response//$'\r'/}
  body=${response#*$'\n\n'}
  if [[ ${status} == 1 && ${response%%$'\n'*} =~ ^HTTP/[0-9.]+\ 404(\ |$) ]] &&
    jq -se 'length == 1 and (.[0] | type == "object" and
      .message == "Branch not protected" and .status == "404")' \
      <<<"${body}" >/dev/null 2>&1; then
    return
  fi
  if [[ ${status} == 0 && ${response%%$'\n'*} =~ ^HTTP/[0-9.]+\ 200(\ |$) ]] &&
    jq -se 'length == 1 and (.[0] | type == "object")' \
      <<<"${body}" >/dev/null 2>&1; then
    record_finding "unexpected legacy branch protection requires manual review: ${organization}/${repository}/${branch}"
  else
    record_finding "legacy branch protection could not be read: ${organization}/${repository}/${branch}"
  fi
}

audit_security() {
  local repository=$1 desired="${root}/config/code-security.json" setup="${root}/config/codeql-default-setup.json"
  local current languages
  if jq -e --arg repository "${repository}" '.repositories | index($repository) != null' \
    "${root}/config/codeql-advanced-setup.json" >/dev/null; then
    desired="${root}/config/code-security-advanced.json"
    setup="${root}/config/codeql-default-setup-advanced.json"
  fi
  if current=$(github_api "repos/${organization}/${repository}/code-security-configuration"); then
    if ! jq -e --slurpfile desired "${desired}" '
      .status == "enforced" and (.configuration | . as $config |
        . + {code_security: (.code_security //
          (if .advanced_security == "enabled" or .advanced_security == "code_security" then "enabled" else "disabled" end)),
          secret_protection: (.secret_protection //
          (if .advanced_security == "enabled" or .advanced_security == "secret_protection" then "enabled" else "disabled" end))} |
        . as $normalized | $desired[0] | to_entries | all(.[]; $normalized[.key] == .value))
    ' <<<"${current}" >/dev/null; then
      record_finding "security configuration attachment or baseline drift: ${organization}/${repository}"
    fi
  else
    record_finding "security configuration could not be read: ${organization}/${repository}"
  fi
  if current=$(github_api "repos/${organization}/${repository}/code-scanning/default-setup"); then
    languages=$(jq -c --arg repository "${repository}" '.codeql_required_languages[$repository] // []' \
      "${root}/config/security-merge-protection.json")
    if ! jq -e --slurpfile desired "${setup}" --argjson languages "${languages}" '
      . as $current | ($desired[0] | to_entries | all(.[]; $current[.key] == .value)) and
      (if $desired[0].state == "configured" then
        $current.languages | if type == "array" then all(.[]; type == "string") else false end
       else true end) and
      (($languages - ($current.languages // [])) | length == 0)
    ' <<<"${current}" >/dev/null; then
      record_finding "CodeQL setup or required language drift: ${organization}/${repository}"
    fi
  else
    record_finding "CodeQL setup could not be read: ${organization}/${repository}"
  fi
  if ! github_api "repos/${organization}/${repository}/vulnerability-alerts" >/dev/null; then
    record_finding "Dependabot alerts disabled or unreadable: ${organization}/${repository}"
  fi
  if ! current=$(github_api "repos/${organization}/${repository}/private-vulnerability-reporting") ||
    ! jq -e '.enabled == true' <<<"${current}" >/dev/null; then
    record_finding "private vulnerability reporting disabled or unreadable: ${organization}/${repository}"
  fi
}

for repository in "${!expected_active[@]}"; do
  [[ -v live_archived["${repository}"] ]] || continue
  [[ ${live_archived["${repository}"]} == false ]] || continue

  metadata_file=${temporary}/${repository}.json
  if ! github_api "repos/${organization}/${repository}" >"${metadata_file}"; then
    record_finding "repository metadata could not be read: ${organization}/${repository}"
    continue
  fi

  if current=$(github_api "repos/${organization}/${repository}/actions/permissions/workflow"); then
    if ! jq -e --slurpfile desired "${root}/config/actions-workflow.json" '
      . as $current | $desired[0] | to_entries | all(.[]; $current[.key] == .value)
    ' <<<"${current}" >/dev/null; then
      record_finding "repository Actions workflow permissions drift: ${organization}/${repository}"
    fi
  else
    record_finding "repository Actions workflow permissions could not be read: ${organization}/${repository}"
  fi

  if ! jq -e --slurpfile desired "${repository_defaults}" '
    .archived == false and
    .default_branch == $desired[0].default_branch and
    .allow_merge_commit == $desired[0].allow_merge_commit and
    .allow_rebase_merge == $desired[0].allow_rebase_merge and
    .allow_squash_merge == $desired[0].allow_squash_merge and
    .delete_branch_on_merge == $desired[0].delete_branch_on_merge and
    .squash_merge_commit_title == $desired[0].squash_merge_commit_title and
    .squash_merge_commit_message == $desired[0].squash_merge_commit_message
  ' "${metadata_file}" >/dev/null; then
    record_finding "repository merge policy drift: ${organization}/${repository}"
  fi

  desired_properties=$(jq -c --arg repository "${repository}" '
    .repositories[$repository] |
    to_entries |
    map({property_name: .key, value: .value}) |
    sort_by(.property_name)
  ' "${repository_properties}")
  if current_properties=$(github_api \
    "repos/${organization}/${repository}/properties/values" | \
    jq -c 'map({property_name, value}) | sort_by(.property_name)'); then
    if [[ ${current_properties} != "${desired_properties}" ]]; then
      record_finding "repository custom-property drift: ${organization}/${repository}"
    fi
  else
    record_finding "repository custom properties could not be read: ${organization}/${repository}"
  fi

  rulesets='[]'
  if ! rulesets=$(github_api --paginate --slurp \
    "repos/${organization}/${repository}/rulesets?includes_parents=true&per_page=100" | jq -e 'add'); then
    record_finding "inherited rulesets could not be read: ${organization}/${repository}"
    rulesets='[]'
  fi
  branch=$(jq -r '.default_branch' "${repository_defaults}")
  audit_legacy_protection "${repository}" "${branch}"
  while IFS= read -r maintenance_branch; do
    audit_legacy_protection "${repository}" "${maintenance_branch}"
  done < <(jq -r --arg repository "${repository}" '
    .maintenance_branches[] | select(.repository == $repository) | .branch
  ' "${repositories_config}")
  effective='[]'
  if ! effective=$(github_api --paginate --slurp \
    "repos/${organization}/${repository}/rules/branches/${branch}?per_page=100" | jq -e 'add'); then
    record_finding "effective default-branch rules could not be read: ${organization}/${repository}"
    effective='[]'
  fi
  expected_checks=$(jq -c --arg repository "${repository}" \
    '(.required_ci[$repository] // []) | map({context: ., integration_id: 15368})' "${repositories_config}")
  dependency_required=false
  if jq -e --arg repository "${repository}" '.dependency_review | index($repository) != null' \
    "${root}/config/security-merge-protection.json" >/dev/null; then
    if jq -e --arg repository "${repository}" \
      '.activation.dependency_review[$repository] == "enforced"' \
        "${root}/config/security-merge-protection.json" >/dev/null ||
      jq -e 'any(.[]; .type == "required_status_checks" and
      any(.parameters.required_status_checks[]; .context == "Dependency review"))' \
        <<<"${effective}" >/dev/null ||
      jq -e 'any(.[]; .name == "07 - Dependency review")' <<<"${rulesets}" >/dev/null; then
      dependency_required=true
    elif "${root}/bin/security-readiness" dependency "${organization}/${repository}" \
      >"${temporary}/${repository}.readiness" 2>&1; then
      pending+=("Dependency review merge protection awaits reviewed activation intent: ${organization}/${repository}")
    else
      readiness_status=$?
      if ((readiness_status == 1)); then
        pending+=("Dependency review merge protection awaits landed successful producer: ${organization}/${repository}")
      else
        record_finding "Dependency review readiness could not be read: ${organization}/${repository}"
      fi
    fi
    if ${dependency_required}; then
      expected_checks=$(jq '. + [{context: "Dependency review", integration_id: 15368}]' <<<"${expected_checks}")
      check_ruleset "${repository}" '07 - Dependency review' \
        "${root}/config/rulesets/dependency-review.json" "${rulesets}" "${metadata_file}"
    fi
  fi
  if ! jq -e --argjson checks "${expected_checks}" '
    ([.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[]] |
      unique_by(.context, .integration_id) | sort_by(.context, .integration_id)) ==
      ($checks | sort_by(.context, .integration_id)) and
    all(.[] | select(.type == "required_status_checks"); .parameters.strict_required_status_checks_policy == true)
  ' <<<"${effective}" >/dev/null; then
    record_finding "effective required CI contexts or app drift: ${organization}/${repository}"
  fi
  for policy in default-branch-integrity default-branch-linear-history; do
    template="${root}/config/rulesets/${policy}.json"
    if jq -e --arg repository "${repository}" '.repositories | index($repository) != null' \
      "${advisory_windows}" >/dev/null; then
      template="${root}/config/rulesets/${policy}-classic.json"
    fi
    check_ruleset "${repository}" "$(jq -r .name "${template}")" "${template}" "${rulesets}" "${metadata_file}"
    if ! jq -e --slurpfile desired "${template}" \
      '. as $effective | all($desired[0].rules[]; . as $rule | any($effective[]; .type == $rule.type))' \
      <<<"${effective}" >/dev/null; then
      record_finding "effective default-branch integrity drift: ${organization}/${repository}"
    fi
  done
  if has_configured_repository '.pull_request_gate' "${repository}"; then
    template="${root}/config/rulesets/pull-request-gate.json"
    if jq -e --arg repository "${repository}" '.repositories | index($repository) != null' \
      "${advisory_windows}" >/dev/null; then template="${root}/config/rulesets/pull-request-gate-classic.json"; fi
    check_ruleset "${repository}" "$(jq -r .name "${template}")" "${template}" "${rulesets}" "${metadata_file}"
    if ! jq -e --slurpfile desired "${template}" \
      "${ruleset_normalization}"'([.[] | select(.type == "pull_request") | {type, parameters}] |
        normalize_rules) == ($desired[0].rules | normalize_rules)' \
      <<<"${effective}" >/dev/null; then
      record_finding "effective pull-request policy drift: ${organization}/${repository}"
    fi
  elif jq -e 'any(.[]; .type == "pull_request")' <<<"${effective}" >/dev/null; then
    record_finding "unexpected effective pull-request gate: ${organization}/${repository}"
  fi
  if has_required_ci "${repository}"; then
    check_ruleset "${repository}" "03 - Required CI - ${repository}" \
      "${root}/config/rulesets/required-ci.json" "${rulesets}" "${metadata_file}"
  fi
  # Parent listings can contain correctly scoped but nonapplicable rulesets.
  # Inspect the exact managed name on nonrelease repositories too, so widening
  # its complete scope fails while foreign, unmanaged tag rules remain unowned.
  if has_release_tags "${repository}" ||
    jq -e 'any(.[]; .name == "04 - Immutable release tags")' <<<"${rulesets}" >/dev/null; then
    check_ruleset "${repository}" '04 - Immutable release tags' \
      "${root}/config/rulesets/immutable-release-tags.json" "${rulesets}" "${metadata_file}"
  fi
  if jq -e --arg repository "${repository}" '.code_scanning | index($repository) != null' \
    "${root}/config/security-merge-protection.json" >/dev/null; then
    codeql_required=false
    if jq -e --arg repository "${repository}" \
      '.activation.code_scanning[$repository] == "enforced"' \
        "${root}/config/security-merge-protection.json" >/dev/null ||
      jq -e 'any(.[]; .type == "code_scanning")' <<<"${effective}" >/dev/null ||
      jq -e 'any(.[]; .name == "06 - CodeQL security")' <<<"${rulesets}" >/dev/null; then
      codeql_required=true
    elif "${root}/bin/security-readiness" codeql "${organization}/${repository}" \
      >"${temporary}/${repository}.codeql-readiness" 2>&1; then
      pending+=("CodeQL merge protection awaits reviewed activation intent: ${organization}/${repository}")
    else
      readiness_status=$?
      if ((readiness_status == 1)); then
        pending+=("CodeQL merge protection awaits successful analysis: ${organization}/${repository}")
      else
        record_finding "CodeQL readiness could not be read: ${organization}/${repository}"
      fi
    fi
    if ${codeql_required}; then
      check_ruleset "${repository}" '06 - CodeQL security' \
        "${root}/config/rulesets/code-scanning.json" "${rulesets}" "${metadata_file}"
      if ! jq -e --slurpfile desired "${root}/config/rulesets/code-scanning.json" \
        '[.[] | select(.type == "code_scanning") | {type, parameters}] == $desired[0].rules' \
        <<<"${effective}" >/dev/null; then
        record_finding "effective CodeQL merge protection drift: ${organization}/${repository}"
      fi
    fi
  elif jq -e 'any(.[]; .type == "code_scanning")' <<<"${effective}" >/dev/null; then
    record_finding "unexpected effective CodeQL merge protection: ${organization}/${repository}"
  fi
  audit_security "${repository}"

  if ! jq -e '
    .security_and_analysis.secret_scanning.status == "enabled" and
    .security_and_analysis.secret_scanning_push_protection.status == "enabled" and
    .security_and_analysis.secret_scanning_validity_checks.status == "enabled" and
    .security_and_analysis.dependabot_security_updates.status == "enabled"
  ' "${metadata_file}" >/dev/null; then
    record_finding "exposed security baseline drift: ${organization}/${repository}"
  fi
done

if ((${#pending[@]})); then
  printf 'PENDING %s\n' "${pending[@]}" | sort -u
fi

if ((${#findings[@]})); then
  printf 'DRIFT %s\n' "${findings[@]}" | sort -u
  echo "Governance audit failed: ${#findings[@]} finding(s)." >&2
  exit 1
fi

if ((${#pending[@]})); then
  echo "Governance audit baseline passed with ${#pending[@]} pending rollout(s): ${#expected_active[@]} active repositories checked."
else
  echo "Governance audit passed: ${#expected_active[@]} active repositories checked."
fi
