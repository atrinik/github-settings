#!/usr/bin/env bash

# GraphQL variable names are intentionally literal dollar-prefixed strings.
# shellcheck disable=SC2016

set -euo pipefail

organization=${ATRINIK_ORGANIZATION:-atrinik}
api_version=2026-03-10
pause_seconds=${ATRINIK_PROJECT_SYNC_PAUSE_SECONDS:-0.2}
apply=false

case ${1:-} in
"") ;;
--apply) apply=true ;;
*)
  echo "usage: $0 [--apply]" >&2
  exit 2
  ;;
esac

for command in gh jq sleep tr; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "error: ${command} is required" >&2
    exit 1
  fi
done
if [[ ! ${pause_seconds} =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "error: ATRINIK_PROJECT_SYNC_PAUSE_SECONDS must be numeric" >&2
  exit 2
fi
if [[ ${GITHUB_ACTIONS:-false} == true && -z ${GH_TOKEN:-} ]]; then
  echo "error: ATRINIK_SETTINGS_TOKEN is unavailable: GH_TOKEN is empty in GitHub Actions" >&2
  exit 1
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
planning_config=${root}/config/planning.json
temporary=$(mktemp -d)
trap 'rm -rf "${temporary}"' EXIT

"${root}/bin/validate" >/dev/null

github_api() {
  local operation=$1
  local response
  local status

  shift
  if response=$(gh api -H "X-GitHub-Api-Version: ${api_version}" "$@"); then
    :
  else
    status=$?
    echo "error: GitHub API operation failed: ${operation}" >&2
    return "${status}"
  fi
  printf '%s\n' "${response}"
}

verify_token_scopes() {
  local advertised_scopes header header_name response scope status
  local -A advertised=()

  if response=$(gh api --include \
    -H "X-GitHub-Api-Version: ${api_version}" user); then
    :
  else
    status=$?
    echo "error: GitHub API operation failed: verify settings credential scopes" >&2
    return "${status}"
  fi
  advertised_scopes=
  while IFS= read -r header; do
    header=${header%$'\r'}
    header_name=${header%%:*}
    if [[ ${header_name,,} == x-oauth-scopes ]]; then
      advertised_scopes=${header#*:}
    fi
  done <<<"${response}"
  if [[ -z ${advertised_scopes//[[:space:]]/} ]]; then
    echo "error: settings credential scope metadata is unavailable; ATRINIK_SETTINGS_TOKEN must be a classic PAT" >&2
    return 1
  fi
  while IFS= read -r scope; do
    scope=${scope#"${scope%%[![:space:]]*}"}
    scope=${scope%"${scope##*[![:space:]]}"}
    [[ -n ${scope} ]] && advertised["${scope}"]=1
  done < <(tr ',' '\n' <<<"${advertised_scopes}")
  for scope in admin:org project repo; do
    if [[ ! -v advertised["${scope}"] ]]; then
      echo "error: ATRINIK_SETTINGS_TOKEN is missing required classic PAT scope: ${scope}" >&2
      return 1
    fi
  done
}

if ${apply}; then
  if verify_token_scopes; then
    :
  else
    status=$?
    exit "${status}"
  fi
fi

graphql() {
  local operation=$1
  local query=$2
  local variables=$3
  local input response status

  input=${temporary}/graphql-$RANDOM.json
  jq -n --arg query "${query}" --argjson variables "${variables}" \
    '{query: $query, variables: $variables}' >"${input}"
  if response=$(github_api "${operation}" graphql --input "${input}"); then
    :
  else
    status=$?
    return "${status}"
  fi
  if ! jq -e 'type == "object"' <<<"${response}" >/dev/null; then
    echo "error: GitHub GraphQL operation returned invalid JSON: ${operation}" >&2
    return 1
  fi
  if jq -e '(.errors // []) | length > 0' <<<"${response}" >/dev/null; then
    jq -r '.errors[] | .message // tostring' <<<"${response}" >&2
    echo "error: GitHub GraphQL operation failed: ${operation}" >&2
    return 1
  fi
  if ! jq -e '.data | type == "object"' <<<"${response}" >/dev/null; then
    echo "error: GitHub GraphQL operation returned an invalid response: ${operation}" >&2
    return 1
  fi
  printf '%s\n' "${response}"
}

graphql_paginate() {
  local operation=$1
  local query=$2
  local variables=$3
  local connection_filter=$4
  local nodes_filter=$5
  local connection cursor has_next page response status
  local -A seen_cursors=()

  page=1
  while true; do
    if response=$(graphql "${operation} (page ${page})" \
      "${query}" "${variables}"); then
      :
    else
      status=$?
      return "${status}"
    fi
    if ! connection=$(jq -ce "${connection_filter}" <<<"${response}"); then
      echo "error: GitHub GraphQL response is missing the expected connection: ${operation}" >&2
      return 1
    fi
    if ! jq -e '
      (.nodes | type == "array") and
      (.pageInfo | type == "object") and
      (.pageInfo.hasNextPage | type == "boolean")
    ' <<<"${connection}" >/dev/null; then
      echo "error: GitHub GraphQL response has invalid pagination data: ${operation}" >&2
      return 1
    fi
    if [[ ${connection_filter} == .data.search ]]; then
      if ! jq -e '
        .issueCount | type == "number" and floor == . and . >= 0
      ' <<<"${connection}" >/dev/null; then
        echo "error: GitHub GraphQL search response omitted a valid result count: ${operation}" >&2
        return 1
      fi
      if (( $(jq -r '.issueCount' <<<"${connection}") > 1000 )); then
        echo "error: GitHub GraphQL search exceeds the 1000-result API window: ${operation}" >&2
        return 1
      fi
    fi
    if ! jq -c "${nodes_filter}" <<<"${connection}"; then
      echo "error: GitHub GraphQL response has invalid nodes: ${operation}" >&2
      return 1
    fi

    has_next=$(jq -r '.pageInfo.hasNextPage' <<<"${connection}")
    [[ ${has_next} == true ]] || break
    cursor=$(jq -r '.pageInfo.endCursor // empty' <<<"${connection}")
    if [[ -z ${cursor} ]]; then
      echo "error: GitHub GraphQL response omitted the next cursor: ${operation}" >&2
      return 1
    fi
    if [[ -v seen_cursors["${cursor}"] ]]; then
      echo "error: GitHub GraphQL response repeated the next cursor: ${operation}" >&2
      return 1
    fi
    seen_cursors["${cursor}"]=1
    variables=$(jq -c --arg cursor "${cursor}" \
      '. + {endCursor: $cursor}' <<<"${variables}")
    ((page += 1))
  done
}

project_title=$(jq -r '.project.title' "${planning_config}")
organization_query='query($login:String!){organization(login:$login){issueTypes(first:25){nodes{id name isEnabled}} projectsV2(first:50){nodes{id number title viewerCanUpdate fields(first:100){nodes{... on ProjectV2Field{id name} ... on ProjectV2IterationField{id name} ... on ProjectV2MultiSelectField{id name} ... on ProjectV2SingleSelectField{id name options{id name}}}}}}}}'
organization_variables=$(jq -cn --arg login "${organization}" '{login: $login}')
if organization_response=$(graphql "read organization planning metadata" \
  "${organization_query}" "${organization_variables}"); then
  :
else
  status=$?
  exit "${status}"
fi
if ! organization_data=$(jq -ce \
  '.data.organization | select(type == "object")' \
  <<<"${organization_response}"); then
  echo "error: GitHub GraphQL response omitted organization planning metadata" >&2
  exit 1
fi
project=$(jq -c --arg title "${project_title}" '
  .projectsV2.nodes | map(select(.title == $title))[0] // null
' <<<"${organization_data}")
if [[ ${project} == null ]]; then
  echo "error: organization project is missing: ${project_title}" >&2
  echo "run bin/publish-planning --apply first" >&2
  exit 1
fi
project_id=$(jq -r '.id' <<<"${project}")
project_number=$(jq -r '.number' <<<"${project}")
if ${apply} && ! jq -e '.viewerCanUpdate == true' <<<"${project}" >/dev/null; then
  echo "error: ATRINIK_SETTINGS_TOKEN cannot update organization project: ${project_title}" >&2
  exit 1
fi
status_field=$(jq -c '
  .fields.nodes | map(select(.name == "Status"))[0] // null
' <<<"${project}")
if [[ ${status_field} == null ]]; then
  echo "error: project Status field is missing" >&2
  exit 1
fi
status_field_id=$(jq -r '.id' <<<"${status_field}")

declare -A status_option_ids=()
while IFS=$'\t' read -r name id; do
  status_option_ids["${name}"]=${id}
done < <(jq -r '.options[] | [.name, .id] | @tsv' <<<"${status_field}")
for status in Inbox Backlog Review Done; do
  if [[ ! -v status_option_ids["${status}"] ]]; then
    echo "error: project Status option is missing: ${status}" >&2
    exit 1
  fi
done

declare -A issue_type_ids=()
while IFS=$'\t' read -r name id; do
  issue_type_ids["${name}"]=${id}
done < <(jq -r '.issueTypes.nodes[] | select(.isEnabled) | [.name, .id] | @tsv' \
  <<<"${organization_data}")
for issue_type in Task Bug Feature Initiative; do
  if [[ ! -v issue_type_ids["${issue_type}"] ]]; then
    echo "error: enabled organization issue type is missing: ${issue_type}" >&2
    exit 1
  fi
done

search_query='query($queryString:String!,$endCursor:String){search(query:$queryString,type:ISSUE,first:100,after:$endCursor){issueCount nodes{... on Issue{__typename id url createdAt state issueType{name} repository{name isArchived viewerPermission} labels(first:50){nodes{name}} subIssues(first:1){totalCount}} ... on PullRequest{__typename id url createdAt state isDraft repository{name isArchived viewerPermission}}} pageInfo{hasNextPage endCursor}}}'
open_items=${temporary}/open-items.jsonl
: >"${open_items}"
for qualifier in is:issue is:pr; do
  search_variables=$(jq -cn \
    --arg queryString "org:${organization} is:open ${qualifier} archived:false" \
    '{queryString: $queryString, endCursor: null}')
  if graphql_paginate "search open ${qualifier} work" \
    "${search_query}" "${search_variables}" '.data.search' \
    '.nodes[] | select(.repository.isArchived == false)' >>"${open_items}"; then
    :
  else
    status=$?
    exit "${status}"
  fi
done

if ${apply}; then
  unauthorized_repositories=$(jq -sr '
    [
      .[] |
      select(
        .__typename == "Issue" and
        (.issueType.name // "") == "" and
        (.repository.viewerPermission | IN("ADMIN", "MAINTAIN", "WRITE") | not)
      ) |
      .repository.name
    ] | unique | join(", ")
  ' "${open_items}")
  if [[ -n ${unauthorized_repositories} ]]; then
    echo "error: ATRINIK_SETTINGS_TOKEN cannot set issue types in repositories: ${unauthorized_repositories}" >&2
    exit 1
  fi
fi

project_items_query='query($id:ID!,$endCursor:String){node(id:$id){... on ProjectV2{items(first:100,after:$endCursor){nodes{id fieldValueByName(name:"Status"){... on ProjectV2ItemFieldSingleSelectValue{name optionId}} content{... on Issue{__typename id url createdAt state issueType{name} repository{name isArchived} labels(first:50){nodes{name}} subIssues(first:1){totalCount}} ... on PullRequest{__typename id url createdAt state isDraft repository{name isArchived}}}} pageInfo{hasNextPage endCursor}}}}}'
project_items=${temporary}/project-items.jsonl
project_items_variables=$(jq -cn --arg id "${project_id}" \
  '{id: $id, endCursor: null}')
if graphql_paginate "read project items" "${project_items_query}" \
  "${project_items_variables}" '.data.node.items' '.nodes[]' \
  >"${project_items}"; then
  :
else
  status=$?
  exit "${status}"
fi

declare -A project_item_ids=()
declare -A project_item_statuses=()
while IFS= read -r item; do
  content_id=$(jq -r '.content.id // empty' <<<"${item}")
  [[ -n ${content_id} ]] || continue
  project_item_ids["${content_id}"]=$(jq -r '.id' <<<"${item}")
  project_item_statuses["${content_id}"]=$(jq -r \
    '.fieldValueByName.name // empty' <<<"${item}")
done <"${project_items}"

mutation_count=0
added_count=0
status_count=0
done_count=0
type_count=0
task_count=0
bug_count=0
feature_count=0
initiative_count=0

pause_after_mutation() {
  if ${apply} && [[ ${pause_seconds} != 0 ]] && [[ ${pause_seconds} != 0.0 ]]; then
    sleep "${pause_seconds}"
  fi
}

add_project_item() {
  local content_id=$1
  local item_id response status
  local variables

  variables=$(jq -cn --arg projectId "${project_id}" \
    --arg contentId "${content_id}" \
    '{input: {projectId: $projectId, contentId: $contentId}}')
  if response=$(graphql "add ${content_id} to project" \
    'mutation($input:AddProjectV2ItemByIdInput!){addProjectV2ItemById(input:$input){item{id}}}' \
    "${variables}"); then
    :
  else
    status=$?
    return "${status}"
  fi
  if ! item_id=$(jq -er '
    .data.addProjectV2ItemById.item.id |
    select(type == "string" and length > 0)
  ' <<<"${response}"); then
    echo "error: GitHub GraphQL operation returned an invalid item: add ${content_id} to project" >&2
    return 1
  fi
  printf '%s\n' "${item_id}"
  pause_after_mutation
}

set_project_status() {
  local item_id=$1
  local status=$2
  local graphql_status response variables

  variables=$(jq -cn \
    --arg projectId "${project_id}" \
    --arg itemId "${item_id}" \
    --arg fieldId "${status_field_id}" \
    --arg optionId "${status_option_ids["${status}"]}" '
      {input: {
        projectId: $projectId,
        itemId: $itemId,
        fieldId: $fieldId,
        value: {singleSelectOptionId: $optionId}
      }}
    ')
  if response=$(graphql "set project item ${item_id} status to ${status}" \
    'mutation($input:UpdateProjectV2ItemFieldValueInput!){updateProjectV2ItemFieldValue(input:$input){projectV2Item{id}}}' \
    "${variables}"); then
    :
  else
    graphql_status=$?
    return "${graphql_status}"
  fi
  if ! jq -e '
    .data.updateProjectV2ItemFieldValue.projectV2Item.id |
    type == "string" and length > 0
  ' <<<"${response}" >/dev/null; then
    echo "error: GitHub GraphQL operation returned an invalid project item: set project item ${item_id} status to ${status}" >&2
    return 1
  fi
  pause_after_mutation
}

set_issue_type() {
  local issue_id=$1
  local issue_type=$2
  local graphql_status response variables

  variables=$(jq -cn --arg id "${issue_id}" \
    --arg issueTypeId "${issue_type_ids["${issue_type}"]}" \
    '{input: {id: $id, issueTypeId: $issueTypeId}}')
  if response=$(graphql "set issue ${issue_id} type to ${issue_type}" \
    'mutation($input:UpdateIssueInput!){updateIssue(input:$input){issue{id}}}' \
    "${variables}"); then
    :
  else
    graphql_status=$?
    return "${graphql_status}"
  fi
  if ! jq -e '
    .data.updateIssue.issue.id | type == "string" and length > 0
  ' <<<"${response}" >/dev/null; then
    echo "error: GitHub GraphQL operation returned an invalid issue: set issue ${issue_id} type to ${issue_type}" >&2
    return 1
  fi
  pause_after_mutation
}

infer_issue_type() {
  local issue=$1
  jq -r --slurpfile config "${planning_config}" '
    $config[0].type_inference as $inference |
    ([.labels.nodes[].name | ascii_downcase]) as $labels |
    ($inference.bug_labels | map(ascii_downcase)) as $bugs |
    ($inference.feature_labels | map(ascii_downcase)) as $features |
    if $inference.initiative_when_parent and .subIssues.totalCount > 0 then
      "Initiative"
    elif any($labels[]; . as $label | ($bugs | index($label)) != null) then
      "Bug"
    elif any($labels[]; . as $label | ($features | index($label)) != null) then
      "Feature"
    else
      $inference.default
    end
  ' <<<"${issue}"
}

triage_cutover=$(jq -r '.project.triage_cutover' "${planning_config}")
while IFS= read -r content; do
  content_id=$(jq -r '.id' <<<"${content}")
  content_type=$(jq -r '.__typename' <<<"${content}")
  url=$(jq -r '.url' <<<"${content}")
  desired_status=Review
  if [[ ${content_type} == Issue ]]; then
    if [[ $(jq -r '.createdAt' <<<"${content}") < ${triage_cutover} ]]; then
      desired_status=Backlog
    else
      desired_status=Inbox
    fi
  fi

  item_id=${project_item_ids["${content_id}"]:-}
  current_status=${project_item_statuses["${content_id}"]:-}
  if [[ -z ${item_id} ]]; then
    ((added_count += 1))
    ((status_count += 1))
    ((mutation_count += 2))
    if ${apply}; then
      item_id=$(add_project_item "${content_id}")
      set_project_status "${item_id}" "${desired_status}"
    fi
  elif [[ -z ${current_status} ]] || [[ ${current_status} == Done ]]; then
    ((status_count += 1))
    ((mutation_count += 1))
    if ${apply}; then
      set_project_status "${item_id}" "${desired_status}"
    fi
  fi

  if [[ ${content_type} == Issue ]] && \
    [[ $(jq -r '.issueType.name // empty' <<<"${content}") == "" ]]; then
    issue_type=$(infer_issue_type "${content}")
    ((type_count += 1))
    ((mutation_count += 1))
    case ${issue_type} in
    Task) ((task_count += 1)) ;;
    Bug) ((bug_count += 1)) ;;
    Feature) ((feature_count += 1)) ;;
    Initiative) ((initiative_count += 1)) ;;
    *)
      echo "error: unsupported inferred issue type: ${issue_type}" >&2
      exit 1
      ;;
    esac
    if ${apply}; then
      set_issue_type "${content_id}" "${issue_type}"
    fi
  fi

  if ${apply} && ((mutation_count > 0)) && ((mutation_count % 50 == 0)); then
    echo "PROGRESS ${mutation_count} mutations; latest ${url}"
  fi
done <"${open_items}"

while IFS= read -r item; do
  content_id=$(jq -r '.content.id // empty' <<<"${item}")
  [[ -n ${content_id} ]] || continue
  state=$(jq -r '.content.state // empty' <<<"${item}")
  current_status=$(jq -r '.fieldValueByName.name // empty' <<<"${item}")
  case ${state} in
  CLOSED | MERGED)
    if [[ ${current_status} != Done ]]; then
      ((done_count += 1))
      ((mutation_count += 1))
      if ${apply}; then
        set_project_status "$(jq -r '.id' <<<"${item}")" Done
      fi
    fi
    ;;
  esac
done <"${project_items}"

mode=PLAN
${apply} && mode=APPLY
open_count=$(wc -l <"${open_items}")
tracked_count=$(jq -s '[.[] | select(.content.id != null)] | length' \
  "${project_items}")
echo "${mode} project ${project_number} (${project_title})"
echo "Open issues and pull requests: ${open_count}"
echo "Currently tracked items: ${tracked_count}"
echo "Items to add: ${added_count}"
echo "Open-item status changes: ${status_count}"
echo "Closed-item moves to Done: ${done_count}"
echo "Issue types to set: ${type_count} (Initiative ${initiative_count}, Feature ${feature_count}, Bug ${bug_count}, Task ${task_count})"
echo "Total mutations: ${mutation_count}"
