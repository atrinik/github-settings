{
  "organization": "atrinik",
  "notes": [
    "Atrinik's settings baseline, read by check_settings.py. Written from the live organization on 2026-11-14, after the changes the owner approved that day.",
    "Live state wins: change the setting first, run the check, then update this file in a pull request that quotes the clean output.",
    "\"recorded\" holds names only. A difference there means something changed since it was last recorded, not that it is wrong.",
    "\"reminders\" are plain notes for the owner. The check never reads them and never fails on a date."
  ],
  "organization_settings": {
    "default_repository_permission": "none",
    "members_can_create_repositories": false,
    "members_can_create_public_repositories": false,
    "members_can_create_private_repositories": false,
    "members_can_create_internal_repositories": false,
    "members_can_fork_private_repositories": false,
    "members_can_delete_repositories": false,
    "members_can_change_repo_visibility": false,
    "members_can_invite_outside_collaborators": true,
    "members_can_delete_issues": false,
    "members_can_create_teams": false,
    "members_can_create_pages": true,
    "web_commit_signoff_required": false,
    "deploy_keys_enabled_for_repositories": false,
    "two_factor_requirement_enabled": true,
    "default_repository_branch": "main"
  },
  "actions": {
    "permissions": {
      "enabled_repositories": "all",
      "allowed_actions": "selected",
      "sha_pinning_required": true
    },
    "selected_actions": {
      "github_owned_allowed": true,
      "patterns_allowed": [
        "atrinik/*",
        "docker/login-action@*",
        "docker/setup-buildx-action@*",
        "docker/build-push-action@*",
        "codecov/codecov-action@*",
        "rust-lang/crates-io-auth-action@*"
      ],
      "verified_allowed": false
    },
    "workflow": {
      "default_workflow_permissions": "read",
      "can_approve_pull_request_reviews": false
    }
  },
  "rulesets": {
    "01 - Default branch integrity": {
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "~DEFAULT_BRANCH"
          ]
        },
        "repository_name": {
          "exclude": [],
          "include": [
            "~ALL"
          ],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        }
      ],
      "bypass_actors": []
    },
    "01 - Default branch linear history": {
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "~DEFAULT_BRANCH"
          ]
        },
        "repository_name": {
          "exclude": [],
          "include": [
            "~ALL"
          ],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "required_linear_history"
        }
      ],
      "bypass_actors": [
        {
          "actor_id": null,
          "actor_type": "OrganizationAdmin",
          "bypass_mode": "pull_request"
        }
      ]
    },
    "02 - Changes through pull requests": {
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "~DEFAULT_BRANCH"
          ]
        },
        "repository_name": {
          "exclude": [],
          "include": [
            "~ALL"
          ],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "required_reviewers": [],
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "require_extra_approval_for_unattributed_changes": true,
            "allowed_merge_methods": [
              "squash"
            ]
          }
        }
      ],
      "bypass_actors": [
        {
          "actor_id": null,
          "actor_type": "OrganizationAdmin",
          "bypass_mode": "pull_request"
        }
      ]
    },
    "04 - Immutable release tags": {
      "target": "tag",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "refs/tags/v[0-9]*"
          ]
        },
        "repository_name": {
          "exclude": [],
          "include": [
            "~ALL"
          ],
          "protected": false
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "update"
        }
      ],
      "bypass_actors": []
    }
  },
  "required_check_ruleset": {
    "name": "03 - Required CI - {repository}",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "exclude": [],
        "include": [
          "~DEFAULT_BRANCH"
        ]
      },
      "repository_name": {
        "exclude": [],
        "include": [
          "{repository}"
        ],
        "protected": false
      }
    },
    "rules": [
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": true,
          "do_not_enforce_on_create": false
        }
      }
    ],
    "bypass_actors": [
      {
        "actor_id": null,
        "actor_type": "OrganizationAdmin",
        "bypass_mode": "pull_request"
      }
    ]
  },
  "check_integration_id": 15368,
