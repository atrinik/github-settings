          "allowed_merge_methods": [
            "squash"
          ],
          "required_approving_review_count": 0,
          "required_review_thread_resolution": true
        }
      },
      "tag_rules": {
        "ref": "refs/tags/v[0-9]*",
        "rules": [
          "deletion",
          "non_fast_forward",
          "update"
        ]
      },
      "security_configuration": "Atrinik security baseline"
    },
    "archived": {
      "repository": {
        "archived": true
      },
      "security_configuration": "Atrinik security baseline"
    }
